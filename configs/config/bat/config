# bat configuration (dotfiles). The theme comes from BAT_THEME, which the theme
# feature sets per shell.

--number
--paging="auto"
--pager="less -RF"

# Shell configurations
--map-syntax='.zshrc:Bourne Again Shell (bash)'
--map-syntax='.bashrc:Bourne Again Shell (bash)'
--map-syntax='.profile:Bourne Again Shell (bash)'
--map-syntax='**/tools/*:Bourne Again Shell (bash)'
--map-syntax='**/platform/*:Bourne Again Shell (bash)'

# Docker files
--map-syntax='Dockerfile*:Dockerfile'
--map-syntax='docker-compose*.yml:YAML'

# Configuration files
--map-syntax='.env*:DotENV'
--map-syntax='*.conf:INI'
--map-syntax='*.cfg:INI'

# Ignore files
--map-syntax='.gitignore:Git Ignore'
--map-syntax='.dockerignore:Git Ignore'
--map-syntax='.npmignore:Git Ignore'

--style="auto"
--color="auto"
--italic-text="always"
--tabs=4
--wrap="auto"
