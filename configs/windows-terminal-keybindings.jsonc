{
    // Windows Terminal keybinding fragment for the TAFK/tmux workflow.
    //
    // Merge these two arrays into the top level of Windows Terminal's
    // settings.json. Do not replace the generated profiles or other settings.
    // Open that file with Ctrl+Shift+, in Windows Terminal.

    "actions":
    [
        // Alt + physical Copy (Ctrl+Alt+Insert) -> tmux copy key.
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[2;7~"
            },
            "id": "User.TmuxAltCopy"
        },

        // Alt + physical Paste (Alt+Shift+Insert) -> tmux paste key.
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[2;4~"
            },
            "id": "User.TmuxAltPaste"
        },

        // Shift + physical Copy (Ctrl+Shift+Insert) -> tmux copies the agent's
        // last reply.
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[2;6~"
            },
            "id": "User.TmuxLastReply"
        },

        // Ctrl+Shift+S as an extended key, apart from Ctrl+S (compose: stage).
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[27;6;83~"
            },
            "id": "User.CtrlShiftS"
        },

        // Ctrl+Shift+E/D/F likewise (tmux review: select by prompt or word), and
        // Ctrl+Shift+Tab (for the program in the pane).
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[27;6;69~"
            },
            "id": "User.CtrlShiftE"
        },
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[27;6;68~"
            },
            "id": "User.CtrlShiftD"
        },
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[27;6;70~"
            },
            "id": "User.CtrlShiftF"
        },
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[27;6;9~"
            },
            "id": "User.CtrlShiftTab"
        },

        // Shift-cut chords use F13-F16 escape sequences as a reliable,
        // otherwise-unused transport through Windows Terminal, SSH, and tmux.
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[1;2P"
            },
            "id": "User.TmuxCutBackwardWord"
        },
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[1;2Q"
            },
            "id": "User.TmuxCutForwardWord"
        },
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[1;2R"
            },
            "id": "User.TmuxCutBackwardLine"
        },
        {
            "command":
            {
                "action": "sendInput",
                "input": "\u001b[1;2S"
            },
            "id": "User.TmuxCutForwardLine"
        },

        // ScrollLock and Pause: WezTerm binds them by key code; here, set the
        // Defy to send Shift+F5 and Shift+F9 from those positions instead
        // (issues/intent-keys.md), which need no binding.
        {
            "command": "toggleFullscreen",
            "id": "User.Fullscreen"
        }
    ],

    "keybindings":
    [
        // Ctrl+Shift+A cycles tabs, one per SSH machine (with two, it toggles).
        // Alt is tmux's.
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+shift+a"
        },

        // Reorder Windows Terminal tabs. These replace client scrollback paging;
        // tmux owns the useful remote scrollback history.
        {
            "id": "Terminal.MoveTabBackward",
            "keys": "ctrl+shift+pgup"
        },
        {
            "id": "Terminal.MoveTabForward",
            "keys": "ctrl+shift+pgdn"
        },

        // Forward the keyboard's modified Copy/Paste macros through SSH.
        {
            "id": "User.TmuxAltCopy",
            "keys": "ctrl+alt+insert"
        },
        {
            "id": "User.TmuxAltPaste",
            "keys": "alt+shift+insert"
        },
        {
            "id": "User.TmuxLastReply",
            "keys": "ctrl+shift+insert"
        },
        {
            "id": "User.CtrlShiftS",
            "keys": "ctrl+shift+s"
        },
        {
            "id": "User.CtrlShiftE",
            "keys": "ctrl+shift+e"
        },
        {
            "id": "User.CtrlShiftD",
            "keys": "ctrl+shift+d"
        },
        {
            "id": "User.CtrlShiftF",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "User.CtrlShiftTab",
            "keys": "ctrl+shift+tab"
        },

        // Fullscreen on Ctrl+Shift+Enter, so Alt+Enter reaches the programs.
        {
            "id": "User.Fullscreen",
            "keys": "ctrl+shift+enter"
        },
        {
            "id": "unbound",
            "keys": "alt+enter"
        },

        // Shift publishes the removed word/line range to tmux's shared buffer.
        {
            "id": "User.TmuxCutBackwardWord",
            "keys": "ctrl+shift+backspace"
        },
        {
            "id": "User.TmuxCutForwardWord",
            "keys": "ctrl+shift+delete"
        },
        {
            "id": "User.TmuxCutBackwardLine",
            "keys": "alt+shift+backspace"
        },
        {
            "id": "User.TmuxCutForwardLine",
            "keys": "alt+shift+delete"
        },

        // Ctrl+C must remain interrupt/cancel and Ctrl+V must reach Vim/TUIs.
        // Native Windows clipboard shortcuts remain Ctrl+Insert/Shift+Insert
        // and Ctrl+Shift+C/Ctrl+Shift+V.
        {
            "id": "unbound",
            "keys": "ctrl+c"
        },
        {
            "id": "unbound",
            "keys": "ctrl+v"
        },

        // Remove awkward default tab switching.
        {
            "id": "unbound",
            "keys": "ctrl+tab"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+1"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+2"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+3"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+4"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+5"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+6"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+7"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+8"
        },
        {
            "id": "unbound",
            "keys": "ctrl+alt+9"
        },

        // Remove profile-number shortcuts; profile creation remains available
        // from Ctrl+Shift+T and the new-tab dropdown.
        {
            "id": "unbound",
            "keys": "ctrl+shift+1"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+2"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+3"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+4"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+5"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+6"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+7"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+8"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+9"
        },

        // Windows Terminal pane management is disabled; tmux owns panes.
        {
            "id": "unbound",
            "keys": "alt+up"
        },
        {
            "id": "unbound",
            "keys": "alt+down"
        },
        {
            "id": "unbound",
            "keys": "alt+left"
        },
        {
            "id": "unbound",
            "keys": "alt+right"
        },
        {
            "id": "unbound",
            "keys": "alt+shift+up"
        },
        {
            "id": "unbound",
            "keys": "alt+shift+down"
        },
        {
            "id": "unbound",
            "keys": "alt+shift+left"
        },
        {
            "id": "unbound",
            "keys": "alt+shift+right"
        },
        {
            "id": "unbound",
            "keys": "alt+shift+-"
        },
        {
            "id": "unbound",
            "keys": "alt+shift+="
        },
        {
            "id": "unbound",
            "keys": "alt+shift+plus"
        },

        // Cover both older duplicate-pane and current duplicate-tab defaults.
        {
            "id": "unbound",
            "keys": "alt+shift+d"
        },
        {
            "id": "unbound",
            "keys": "ctrl+shift+d"
        },

        // Avoid accidentally closing a client pane/tab and its SSH connection.
        {
            "id": "unbound",
            "keys": "ctrl+shift+w"
        }
    ]
}
