{
  "$comment": "One row per thing you do in several programs (issues/intent-keys.md). canon is the TAFK key for it; except gives a program its own TAFK key. apps lists the action ids that count, per program: an app's own action id, tmux:<effect> for a tmux helper, wezterm:<action>, or copy-<command> in copy mode. A program left out of a row has no such feature. bin/keymap checks that each program answers on the TAFK key.",
  "intents": [
    {"group": "Prompt", "label": "Submit", "canon": "enter",
     "apps": {"claude": ["chat:submit"], "codex": ["submit"], "opencode": ["input.submit"], "pi": ["tui.input.submit"], "shell": ["accept-line"]}},
    {"group": "Prompt", "label": "New line", "canon": "shift+enter",
     "note": "Codex reads Shift+Enter as Enter, so tmux sends it Ctrl+J; the New line thumb key sends Ctrl+J, which every agent takes",
     "apps": {"claude": ["chat:newline", "hard:newline"], "codex": ["insert_newline"], "opencode": ["input.newline"], "pi": ["tui.input.newLine"]}},
    {"group": "Prompt", "label": "Queue a message for after the turn", "canon": "alt+enter",
     "note": "the Queue thumb key; tmux sends each agent's own key. Enter steers a running turn in every agent",
     "apps": {"claude": ["chat:queueSubmit"], "codex": ["queue"], "opencode": ["prompt.queue"], "pi": ["app.message.followUp"]}},
    {"group": "Prompt", "label": "Take queued messages back", "canon": "alt+shift+enter",
     "note": "into the prompt: Claude and pi all of them, Codex the last; OpenCode opens its queue, where Ctrl+U takes one back",
     "apps": {"claude": ["history:previous"], "codex": ["edit_queued_message"], "opencode": ["session.queued_prompts"], "pi": ["app.message.dequeue"]}},
    {"group": "Prompt", "label": "Compose box", "canon": "alt+v",
     "apps": {"claude": ["tmux:compose"], "codex": ["tmux:compose"], "opencode": ["tmux:compose"], "pi": ["tmux:compose"], "shell": ["tmux:compose"]}},
    {"group": "Prompt", "label": "Compose, full pane", "canon": "alt+shift+v",
     "note": "nvim in the program's place; with no compose-editor, tmux presses its own editor key",
     "apps": {"claude": ["tmux:compose-full"], "codex": ["tmux:compose-full"], "opencode": ["tmux:compose-full"], "pi": ["tmux:compose-full"], "shell": ["tmux:compose-full"]}},
    {"group": "Prompt", "label": "History search", "canon": "ctrl+r",
     "apps": {"claude": ["history:search"], "codex": ["history_search_previous"], "opencode": [], "pi": [], "shell": ["reverse-search-history"]}},
    {"group": "Agent", "label": "Mode cycle", "canon": "shift+tab",
     "note": "each agent's own: Claude's permission modes, Codex's plan mode, OpenCode's agents",
     "apps": {"claude": ["chat:cycleMode"], "codex": ["fixed:plan-mode"], "opencode": ["agent.cycle"]}},
    {"group": "Agent", "label": "Yolo mode", "canon": "alt+shift+j",
     "note": "the dial's most access: Claude bypass permissions, Codex Full Access from an empty prompt, OpenCode auto accept in every session",
     "apps": {"claude": ["tmux:mode-yolo"], "codex": ["tmux:mode-yolo"], "opencode": ["tmux:mode-yolo"]}},
    {"group": "Agent", "label": "Auto mode", "canon": "alt+shift+k",
     "note": "Claude auto mode, Codex Approve for me; OpenCode has none",
     "apps": {"claude": ["tmux:mode-auto"], "codex": ["tmux:mode-auto"]}},
    {"group": "Agent", "label": "Edits only", "canon": "alt+shift+l",
     "note": "the dial's least access: Claude accept edits, Codex Ask for approval, OpenCode prompt",
     "apps": {"claude": ["tmux:mode-edits"], "codex": ["tmux:mode-edits"], "opencode": ["tmux:mode-edits"]}},
    {"group": "Agent", "label": "More reasoning effort", "canon": "ctrl+pageup",
     "note": "OpenCode cycles variants; pi cycles thinking levels",
     "apps": {"claude": ["chat:increaseEffort"], "codex": ["increase_reasoning_effort"], "opencode": ["variant.cycle"], "pi": ["app.thinking.cycle"]}},
    {"group": "Agent", "label": "Pick a model", "canon": "alt+m",
     "note": "Codex has no key, so tmux runs /model there from an empty prompt",
     "apps": {"claude": ["chat:modelPicker"], "codex": ["tmux:codex-slash-model"], "opencode": ["model.list"], "pi": ["app.model.select"]}},
    {"group": "Agent", "label": "Stop", "canon": "pause", "except": {"claude": "esc", "codex": "esc", "opencode": "esc", "pi": "esc"},
     "note": "Break stops whatever runs; Esc too in the agents",
     "apps": {"claude": ["chat:cancel", "app:interrupt"], "codex": ["interrupt_turn", "fixed:interrupt"], "opencode": ["session.interrupt"], "pi": ["app.interrupt"], "shell": ["interrupt (SIGINT)"]}},
    {"group": "Agent", "label": "Undo the last turn", "canon": "alt+z",
     "note": "Claude's rewind picker and Codex stepping back (Esc Esc there too), OpenCode's undo, pi's session tree",
     "apps": {"claude": ["hard:rewind"], "codex": ["fixed:edit-previous"], "opencode": ["session.undo"], "pi": ["app.session.tree"]}},
    {"group": "Agent", "label": "Paste a screenshot", "canon": "ctrl+alt+v",
     "note": "the Image thumb key; WezTerm uploads the Windows image and pastes its path",
     "apps": {"claude": ["wezterm:upload clipboard image"], "codex": ["wezterm:upload clipboard image"], "opencode": ["wezterm:upload clipboard image"], "pi": ["wezterm:upload clipboard image"]}},
    {"group": "Agent", "label": "Copy last reply", "canon": "ctrl+shift+insert",
     "apps": {"claude": ["tmux:last-reply"], "codex": ["tmux:last-reply"], "opencode": ["tmux:last-reply"], "pi": ["tmux:last-reply"]}},
    {"group": "Agent", "label": "Undo typing", "canon": "ctrl+z",
     "note": "never suspends: the shells turn the terminal's suspend key off; prefix+Ctrl+Z suspends. Codex has no undo",
     "apps": {"claude": ["chat:undo"], "opencode": ["input.undo"], "pi": ["tui.editor.undo"], "shell": ["undo"], "nvim": ["u"]}},
    {"group": "Agent", "label": "Exit", "canon": "ctrl+d",
     "apps": {"claude": ["app:exit"], "codex": ["fixed:exit"], "opencode": ["app.exit"], "pi": ["app.exit"]}},
    {"group": "Read back", "label": "Read the conversation", "canon": "scrolllock",
     "note": "review: each agent's own export, frozen in copy-mode with the same keys everywhere",
     "apps": {"claude": ["tmux:review"], "codex": ["tmux:review"], "opencode": ["tmux:review"], "pi": ["tmux:review"], "shell": ["tmux:review"]}},
    {"group": "Read back", "label": "Review and search", "canon": "shift+scrolllock",
     "apps": {"claude": ["tmux:review-search"], "codex": ["tmux:review-search"], "opencode": ["tmux:review-search"], "pi": ["tmux:review-search"], "shell": ["tmux:review-search"]}},
    {"group": "Read back", "label": "Page up", "canon": "pageup",
     "apps": {"claude": ["scroll:pageUp"], "codex": ["fixed:page-up"], "opencode": ["session.page.up"], "pi": ["tui.altScreen.pageUp", "tui.editor.pageUp"], "shell": ["tmux:page-up"], "copy": ["page-up", "copy-page-up"]}},
    {"group": "Read back", "label": "A few lines up", "canon": "shift+pageup",
     "apps": {"claude": ["tmux:scroll-lines-up"], "codex": ["tmux:scroll-lines-up"], "opencode": ["tmux:scroll-lines-up"], "pi": ["tui.altScreen.lineUp"], "shell": ["tmux:scroll-lines-up"], "copy": ["tmux:scroll-lines-up"]}},
    {"group": "Read back", "label": "Jump to top", "canon": "ctrl+home",
     "apps": {"claude": ["scroll:top"], "codex": ["fixed:top"], "opencode": ["session.first"], "pi": ["tui.altScreen.top"], "shell": ["tmux:history-top", "tmux:copy-history-top"], "copy": ["history-top", "tmux:copy-history-top"]}},
    {"group": "Edit", "label": "Delete word back", "canon": "ctrl+backspace",
     "apps": {"claude": ["hard:delete-word-back"], "codex": ["delete_backward_word"], "opencode": ["input.delete.word.backward"], "pi": ["tui.editor.deleteWordBackward"], "shell": ["backward-kill-word"], "fzf": ["backward-kill-word"]}},
    {"group": "Edit", "label": "Delete word forward", "canon": "ctrl+delete",
     "apps": {"claude": ["hard:delete-word-fwd"], "codex": ["delete_forward_word"], "opencode": ["input.delete.word.forward"], "pi": ["tui.editor.deleteWordForward"], "shell": ["kill-word"], "fzf": ["kill-word"]}},
    {"group": "Edit", "label": "Delete to line start", "canon": "alt+backspace",
     "apps": {"claude": ["hard:kill-line-start"], "codex": ["kill_line_start"], "opencode": ["input.delete.to.line.start"], "pi": ["tui.editor.deleteToLineStart"], "shell": ["backward-kill-line"]}},
    {"group": "Edit", "label": "Delete to line end", "canon": "alt+delete",
     "apps": {"claude": ["hard:kill-line-end"], "codex": ["kill_line_end"], "opencode": ["input.delete.to.line.end"], "pi": ["tui.editor.deleteToLineEnd"], "shell": ["kill-line"]}},
    {"group": "Move", "label": "Focus left", "canon": "alt+s",
     "note": "at the left edge, the previous window's facing pane, wrapping around",
     "apps": {"claude": ["tmux:focus-left"], "codex": ["tmux:focus-left"], "opencode": ["tmux:focus-left"], "pi": ["tmux:focus-left"], "shell": ["tmux:focus-left"], "nvim": ["tmux:focus-left", "<C-W>h"]}}
  ]
}
