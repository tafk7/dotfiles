{
  "$comment": "One row per thing you do in several programs. canon is the TAFK key for it; except gives a program its own TAFK key. apps lists the action ids that count, per program: an app's own action id, tmux:<effect> for a tmux helper, or copy-<command> in copy mode. A program left out of a row has no such feature. bin/keymap checks that each program answers on the TAFK key.",
  "intents": [
    {"group": "Prompt", "label": "Submit", "canon": "enter",
     "apps": {"claude": ["chat:submit"], "codex": ["submit"], "opencode": ["input.submit"], "pi": ["tui.input.submit"], "shell": ["accept-line"]}},
    {"group": "Prompt", "label": "New line", "canon": "shift+enter",
     "apps": {"claude": ["chat:newline", "hard:newline"], "codex": ["insert_newline"], "opencode": ["input.newline"], "pi": ["tui.input.newLine"]}},
    {"group": "Prompt", "label": "Open prompt in editor", "canon": "ctrl+g", "except": {"codex": "ctrl+e"},
     "apps": {"claude": ["chat:externalEditor"], "codex": ["open_external_editor"], "opencode": ["prompt.editor"], "pi": ["app.editor.external"], "shell": ["edit-and-execute-command"]}},
    {"group": "Prompt", "label": "Prompt in nvim, full pane", "canon": "ctrl+shift+g",
     "note": "tmux opens nvim in the agent's place; pi gets its own editor key",
     "apps": {"claude": ["tmux:compose-full"], "codex": ["tmux:compose-full"], "opencode": ["tmux:compose-full"], "pi": ["app.editor.external"]}},
    {"group": "Prompt", "label": "Compose box", "canon": "alt+v",
     "apps": {"claude": ["tmux:compose"], "codex": ["tmux:compose"], "opencode": ["tmux:compose"], "pi": ["tmux:compose"], "shell": ["tmux:compose"]}},
    {"group": "Prompt", "label": "History search", "canon": "ctrl+r",
     "apps": {"claude": ["history:search"], "codex": ["history_search_previous"], "opencode": [], "pi": [], "shell": ["reverse-search-history"]}},
    {"group": "Agent", "label": "Permission mode",
     "note": "Codex cycles Read Only, Ask, Approve for me and never offers Full Access; Claude adds bypass only when started with --dangerously-skip-permissions",
     "apps": {"claude": ["chat:cycleMode"], "codex": ["next_permission_mode", "previous_permission_mode"]}},
    {"group": "Agent", "label": "Plan mode", "canon": "shift+tab",
     "note": "Claude: part of its mode cycle; OpenCode: the plan agent",
     "apps": {"claude": ["chat:cycleMode"], "codex": ["fixed:plan-mode"], "opencode": ["agent.cycle"]}},
    {"group": "Agent", "label": "More reasoning effort", "canon": "shift+up",
     "note": "OpenCode cycles variants; pi cycles thinking levels",
     "apps": {"claude": ["chat:increaseEffort"], "codex": ["increase_reasoning_effort"], "opencode": ["variant.cycle"], "pi": ["app.thinking.cycle"]}},
    {"group": "Agent", "label": "Pick a model",
     "apps": {"claude": ["chat:modelPicker"], "codex": [], "opencode": ["model.list"], "pi": ["app.model.select"]}},
    {"group": "Agent", "label": "Queue a message while it works",
     "note": "the keys compose sends with",
     "apps": {"claude": ["chat:queueSubmit"], "codex": ["queue"], "opencode": ["prompt.queue"], "pi": ["app.message.followUp"]}},
    {"group": "Agent", "label": "Stop the turn", "canon": "esc", "except": {"shell": "ctrl+c"},
     "apps": {"claude": ["chat:cancel", "app:interrupt"], "codex": ["interrupt_turn", "fixed:interrupt"], "opencode": ["session.interrupt"], "pi": ["app.interrupt"], "shell": ["interrupt (SIGINT)"]}},
    {"group": "Agent", "label": "Undo the last turn", "canon": "esc esc",
     "apps": {"claude": ["hard:rewind"], "codex": ["fixed:edit-previous"], "opencode": ["session.undo"]}},
    {"group": "Agent", "label": "Paste an image", "canon": "ctrl+v",
     "apps": {"claude": ["chat:imagePaste"], "codex": ["fixed:paste-image"], "pi": ["app.clipboard.pasteImage"]}},
    {"group": "Agent", "label": "Transcript view",
     "apps": {"claude": ["app:toggleTranscript"], "codex": ["open_transcript"], "opencode": ["session.timeline"], "pi": ["app.tools.expand"]}},
    {"group": "Agent", "label": "Copy last reply", "canon": "ctrl+shift+insert",
     "apps": {"claude": ["tmux:last-reply"], "codex": ["tmux:last-reply"], "opencode": ["tmux:last-reply"], "pi": ["tmux:last-reply"]}},
    {"group": "Agent", "label": "Exit", "canon": "ctrl+d",
     "apps": {"claude": ["app:exit"], "codex": ["fixed:exit"], "opencode": ["app.exit"], "pi": ["app.exit"]}},
    {"group": "Scroll", "label": "Page up", "canon": "pageup",
     "apps": {"claude": ["scroll:pageUp"], "codex": ["fixed:page-up"], "opencode": ["session.page.up"], "pi": ["tui.altScreen.pageUp", "tui.editor.pageUp"], "shell": ["tmux:page-up"], "copy": ["page-up", "copy-page-up"]}},
    {"group": "Scroll", "label": "A few lines up", "canon": "shift+pageup",
     "apps": {"claude": ["tmux:scroll-lines-up"], "codex": ["tmux:scroll-lines-up"], "opencode": ["tmux:scroll-lines-up"], "pi": ["tmux:scroll-lines-up"], "shell": ["tmux:scroll-lines-up"], "copy": ["tmux:scroll-lines-up"]}},
    {"group": "Scroll", "label": "Jump to top", "canon": "ctrl+home",
     "apps": {"claude": ["scroll:top"], "codex": ["fixed:top"], "opencode": ["session.first"], "pi": ["tui.altScreen.top"], "shell": ["tmux:history-top", "tmux:copy-history-top"], "copy": ["history-top", "tmux:copy-history-top"]}},
    {"group": "Edit", "label": "Delete word back", "canon": "ctrl+backspace",
     "apps": {"claude": ["hard:delete-word-back"], "codex": ["delete_backward_word"], "opencode": ["input.delete.word.backward"], "pi": ["tui.editor.deleteWordBackward"], "shell": ["backward-kill-word"], "fzf": ["backward-kill-word"]}},
    {"group": "Edit", "label": "Delete word forward", "canon": "ctrl+delete",
     "apps": {"claude": ["hard:delete-word-fwd"], "codex": ["delete_forward_word"], "opencode": ["input.delete.word.forward"], "pi": ["tui.editor.deleteWordForward"], "shell": ["kill-word"], "fzf": ["kill-word"]}},
    {"group": "Edit", "label": "Delete to line start", "canon": "alt+backspace",
     "apps": {"claude": ["hard:kill-line-start"], "codex": ["kill_line_start"], "opencode": ["input.delete.to.line.start"], "pi": ["tui.editor.deleteToLineStart"], "shell": ["backward-kill-line"]}},
    {"group": "Edit", "label": "Delete to line end", "canon": "alt+delete",
     "apps": {"claude": ["hard:kill-line-end"], "codex": ["kill_line_end"], "opencode": ["input.delete.to.line.end"], "pi": ["tui.editor.deleteToLineEnd"], "shell": ["kill-line"]}},
    {"group": "Move", "label": "Focus left", "canon": "alt+s",
     "apps": {"claude": ["tmux:focus-left"], "codex": ["tmux:focus-left"], "opencode": ["tmux:focus-left"], "pi": ["tmux:focus-left"], "shell": ["tmux:focus-left"], "nvim": ["tmux:focus-left", "<C-W>h"]}}
  ]
}
