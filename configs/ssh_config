# Per-machine SSH config (untracked): work Host blocks, IdentityFile, agent
# overrides, etc. Listed first so its values win (ssh takes the first value seen
# for each keyword). A missing file is silently ignored, so this is a no-op on
# machines that don't have one. See docs/customization.md.
Include ~/.ssh/config.local
# Optional named configuration files follow machine-local overrides and precede
# the generic defaults. Missing directories and unmatched globs are harmless.
Include ~/.ssh/config.d/*.conf

# Git hosts never share a connection. %C hashes host, port, and user, not the
# key, so a connection opened as one account would carry another account's
# fetches and pushes (git profiles pin a key per repository). ControlPath none
# also keeps a client from joining a master that something else opened.
Host github.com ssh.dev.azure.com gitlab.com
    ControlMaster no
    ControlPath none

Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 600
    ServerAliveInterval 60
    ServerAliveCountMax 3
    AddKeysToAgent yes
    ForwardAgent no
    HashKnownHosts yes
    Compression yes
