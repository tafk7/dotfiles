#!/usr/bin/env bash
# Package a Clara user-scope render as an sbx v3 mixin kit.
#
#   clara/make-kit OUT PROFILE [TOOLS]      e.g. clara/make-kit ~/.cache/kits/clara core claude,codex
#
# Clara (CLARA, default: `clara` on PATH) renders its native user layout
# (.claude/, .codex/, .agents/skills/ ...) into OUT/home; this wraps it as a
# kit whose install hook copies it into the sandbox user's home. The render
# record OUT/home/.clara-render.json identifies what went in. Instructions and
# skills only: no settings, no credentials.
set -euo pipefail
[ "$#" -ge 2 ] || { sed -n '2,10p' "$0" >&2; exit 2; }
OUT=$1 PROFILE=$2 TOOLS=${3:-claude,codex}
CLARA=${CLARA:-clara}
rm -rf "$OUT" && mkdir -p "$OUT"
"$CLARA" render "$PROFILE" --tool "$TOOLS" --scope user --target "$OUT/home" >/dev/null
name=$(basename "$OUT")
cat > "$OUT/$name.dockerfile" <<'DOCKERFILE'
# syntax=docker/dockerfile:1
FROM scratch
COPY --chmod=u=rwX,go=rX home/ /usr/share/clara/home/
DOCKERFILE
cat > "$OUT/$name.yaml" <<YAML
# syntax=docker/sandbox-kit:3
# Generated by sbx-kits clara/make-kit from Clara profile "$PROFILE" ($TOOLS).
schemaVersion: "3"
kind: mixin
displayName: Clara ($PROFILE)
description: Clara's user instructions and skills for $TOOLS.
capabilities:
  - type: com.docker.sandbox/lifecycle@1
    config:
      install:
        - command: cp -R /usr/share/clara/home/. /home/agent/
          user: agent
          description: Install Clara's rendered user files into the agent's home
YAML
echo "$OUT"
