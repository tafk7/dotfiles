# shellcheck shell=bash
# ~/.zshenv: read first by every zsh, including non-interactive `zsh -c` and
# zsh scripts, so they get the same Layer 0 environment as interactive shells.
# Re-sourcing later is a no-op except env-runtime.sh, which re-runs on purpose.

# Ubuntu's /etc/zsh/zshrc otherwise runs a full, uncached compinit before
# ~/.zshrc. Opting out (its documented escape hatch) leaves entry/zsh.sh as the
# single owner of completion init.
[[ $- == *i* ]] && skip_global_compinit=1

# Locate the checkout through the symlink; it wins over an inherited value. A
# flattened copy or bind mount defeats that, and ~/.profile falls back.
#
# :A:h:h (resolve symlinks, then dirname twice) avoids forking readlink and
# dirname in every zsh process.
_zshenv_self=~/.zshenv
_dotfiles_linked="${_zshenv_self:A:h:h}"
[[ -f "$_dotfiles_linked/shell/env.sh" ]] && export DOTFILES_DIR="$_dotfiles_linked"
unset _zshenv_self _dotfiles_linked

# POSIX baseline + env (mirrors the bash entry chain via ~/.bashrc → ~/.profile)
[[ -f "$HOME/.profile" ]] && source "$HOME/.profile"

# Layer 0 leaves no private implementation helpers in non-interactive shells.
if [[ $- != *i* ]]; then
    unfunction _dotfiles_dedupe_path 2>/dev/null || true
fi
