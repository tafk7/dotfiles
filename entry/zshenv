# shellcheck shell=bash
# ~/.zshenv: every zsh context — login, interactive, AND non-interactive.
# Sourced FIRST by zsh, before .zprofile or .zshrc.
#
# Establishes DOTFILES_DIR + the managed env (env-runtime + env via
# ~/.profile). This gives zsh non-interactive subprocesses (e.g.,
# `zsh -c "command"`, `#!/usr/bin/env zsh` scripts, tools that exec zsh
# directly) the same PATH and environment that interactive zsh and bash
# get — closing the long-standing gap where zsh -c saw an empty env.
#
# Idempotency-safe: ~/.profile guards via _PROFILE_LOADED, env.sh guards
# via _DOTFILES_ENV_LOADED. Re-sourcing from .zprofile or .zshrc later is
# a no-op (env-runtime.sh re-runs intentionally — it must, for `reload`).

# Ubuntu's /etc/zsh/zshrc runs an unconditional `compinit` (full compaudit scan
# of every fpath entry, ~60ms) before ~/.zshrc is even read, which made our own
# cached `compinit -C` a redundant second pass. Opting out here — ~/.zshenv is
# read before /etc/zsh/zshrc — leaves entry/zsh.sh as the single owner of
# completion init. Documented escape hatch in /etc/zsh/zshrc itself.
[[ $- == *i* ]] && skip_global_compinit=1

# Symlink derivation locates the repo for a fresh clone, but a bind-mount/copy
# (containers, WSL, rsync) flattens the symlink so readlink resolves to the file
# itself → a wrong dir. generated/bridge.sh holds the install-time truth, so let
# it OVERRIDE the guess. New installs use the data-only XDG install-path file;
# generated/bridge.sh remains a read-only compatibility fallback.
#
# zsh parameter modifiers, not `readlink -f` + two `dirname` calls: :A resolves
# symlinks to an absolute path (what readlink -f does) and :h takes the dirname.
# The command-substitution form cost 4 forks in .zshenv, i.e. on EVERY zsh
# context including `zsh -c` and script shebangs. Only zsh sources this file, so
# the zsh-only syntax is safe (bash can still parse it, which keeps `bash -n`
# usable if this file is ever added to the lint set).
_zshenv_self=~/.zshenv
DOTFILES_DIR="${_zshenv_self:A:h:h}"
unset _zshenv_self
if [[ ! -f "$DOTFILES_DIR/shell/env.sh" ]]; then
    _dotfiles_path_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install-path"
    if [[ -r "$_dotfiles_path_file" ]]; then
        IFS= read -r DOTFILES_DIR < "$_dotfiles_path_file"
    else
        DOTFILES_DIR="$HOME/dev/dotfiles"
    fi
    unset _dotfiles_path_file
fi
export DOTFILES_DIR

_bridge="$DOTFILES_DIR/generated/bridge.sh"
[[ -f "$_bridge" ]] && source "$_bridge"
unset _bridge

# POSIX baseline + env (mirrors the bash entry chain via ~/.bashrc → ~/.profile)
[[ -f "$HOME/.profile" ]] && source "$HOME/.profile"

# Layer 0 leaves no private implementation helpers in non-interactive shells.
if [[ $- != *i* ]]; then
    unfunction _dotfiles_dedupe_path 2>/dev/null || true
fi
