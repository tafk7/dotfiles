# Kanagawa Dragon — delta feature
# Delta cannot load the vendored Dragon bat theme. zenburn is the closest
# embedded subdued syntax palette and keeps Dragon distinct from Wave.
[delta "kanagawa-dragon"]
syntax-theme = zenburn
plus-style = "syntax #1e2326"
plus-emph-style = "syntax #2b3328 bold"
plus-non-emph-style = "syntax #1e2326"
minus-style = "syntax #2d1e20"
minus-emph-style = "syntax #43242b bold"
minus-non-emph-style = "syntax #2d1e20"
file-style = "#8ba4b0 bold"
file-decoration-style = "#393836 ul"
hunk-header-style = "syntax bold #c5c9c5"
hunk-header-decoration-style = "#393836 box"
line-numbers-zero-style = "#a6a69c"
line-numbers-left-style = "#8ba4b0"
line-numbers-right-style = "#8ba4b0"
line-numbers-minus-style = "#c4746e"
line-numbers-plus-style = "#8a9a7b"
