# Everforest (dark medium) — btop theme
# Based on https://github.com/sainnhe/everforest

# Main bg
theme[main_bg]="#2d353b"

# Main text color
theme[main_fg]="#d3c6aa"

# Title color for boxes
theme[title]="#d3c6aa"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a7c080"

# Background color of selected item in processes box
theme[selected_bg]="#3d484d"

# Foreground color of selected item in processes box
theme[selected_fg]="#dbbc7f"

# Color of inactive/disabled text
theme[inactive_fg]="#aeb8a4"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#83c092"

# Cpu box outline color
theme[cpu_box]="#7a8478"

# Memory/disks box outline color
theme[mem_box]="#7a8478"

# Net up/down box outline color
theme[net_box]="#7a8478"

# Processes box outline color
theme[proc_box]="#7a8478"

# Box divider line and small boxes line color
theme[div_line]="#7a8478"

# Temperature graph colors
theme[temp_start]="#a7c080"
theme[temp_mid]="#dbbc7f"
theme[temp_end]="#e67e80"

# CPU graph colors
theme[cpu_start]="#a7c080"
theme[cpu_mid]="#dbbc7f"
theme[cpu_end]="#e67e80"

# Mem/Disk free meter
theme[free_start]="#e67e80"
theme[free_mid]="#e69875"
theme[free_end]="#a7c080"

# Mem/Disk cached meter
theme[cached_start]="#83c092"
theme[cached_mid]="#7fbbb3"
theme[cached_end]="#a7c080"

# Mem/Disk available meter
theme[available_start]="#d699b6"
theme[available_mid]="#e69875"
theme[available_end]="#dbbc7f"

# Mem/Disk used meter
theme[used_start]="#7fbbb3"
theme[used_mid]="#83c092"
theme[used_end]="#a7c080"

# Download graph colors
theme[download_start]="#7fbbb3"
theme[download_mid]="#83c092"
theme[download_end]="#a7c080"

# Upload graph colors
theme[upload_start]="#dbbc7f"
theme[upload_mid]="#e69875"
theme[upload_end]="#e67e80"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#a7c080"
theme[process_mid]="#dbbc7f"
theme[process_end]="#e67e80"
