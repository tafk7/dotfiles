#!/bin/bash
# opencode-contract — inspect the currently installed CLI and upstream contract.
#
# This command deliberately has no committed "latest" baseline: opencode is a
# moving/self-updating installer and an unmaintained snapshot was worse than an
# explicit live inspection. Network operations are opt-in subcommands.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$SCRIPT_DIR")}"
source "$DOTFILES_DIR/lib/runtime.sh"

REPO="anomalyco/opencode"
DOCS_SRC_DIR="packages/web/src/content/docs"
SRC_TREE_DIR="packages/opencode/src"
_OC_TMP=""

cleanup() {
    local status=$?
    [[ -z "${_OC_TMP:-}" ]] || rm -rf "$_OC_TMP"
    return "$status"
}
trap cleanup EXIT

usage() {
    cat <<'EOF'
Usage: opencode-contract <runtime|schema|docs [dir]|egress>

  runtime   Print the installed CLI version and help surface (offline).
  schema    Fetch and validate the current config and TUI JSON schemas.
  docs      Mirror current upstream Markdown docs into an explicit directory.
  egress    List HTTP(S) hosts referenced by the current upstream source.
EOF
}

curl_get() {
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
        --connect-timeout 10 --max-time 30 "$@"
}

resolve_ref() {
    local -a headers=()
    [[ -n "${GITHUB_TOKEN:-}" ]] && headers=(-H "Authorization: Bearer $GITHUB_TOKEN")
    local tag
    tag="$(curl_get "${headers[@]}" "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1 || true)"
    printf '%s\n' "${tag:-dev}"
}

list_tree_paths() {
    local ref="$1" prefix="$2" suffix_re="$3"
    local -a headers=()
    [[ -n "${GITHUB_TOKEN:-}" ]] && headers=(-H "Authorization: Bearer $GITHUB_TOKEN")
    curl_get "${headers[@]}" "https://api.github.com/repos/$REPO/git/trees/$ref?recursive=1" 2>/dev/null \
        | sed -n "s|.*\"path\"[[:space:]]*:[[:space:]]*\"\($prefix/[^\"]*\\($suffix_re\\)\)\".*|\1|p"
}

cmd_runtime() {
    command -v opencode >/dev/null 2>&1 || { error "opencode is not installed"; return 1; }
    opencode --version
    opencode --help
    opencode run --help
}

cmd_schema() {
    _OC_TMP="$(mktemp -d)"
    local name
    for name in config tui; do
        curl_get "https://opencode.ai/$name.json" -o "$_OC_TMP/$name.json"
        python3 -m json.tool "$_OC_TMP/$name.json" >/dev/null
        printf '%s  %s\n' "$(sha256sum "$_OC_TMP/$name.json" | awk '{print $1}')" "$name.json"
    done
}

cmd_docs() {
    local outdir="${1:-}"
    [[ -n "$outdir" ]] || { error "docs requires an explicit output directory"; return 64; }
    local ref path rel count=0
    ref="$(resolve_ref)"
    mkdir -p "$outdir"
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        rel="${path#"$DOCS_SRC_DIR"/}"
        mkdir -p "$outdir/$(dirname "$rel")"
        curl_get "https://raw.githubusercontent.com/$REPO/$ref/$path" -o "$outdir/$rel"
        count=$((count + 1))
    done < <(list_tree_paths "$ref" "$DOCS_SRC_DIR" 'mdx\?')
    (( count > 0 )) || { error "No documentation paths were returned"; return 1; }
    success "Mirrored $count documentation files from $ref into $outdir"
}

cmd_egress() {
    local ref path count=0
    ref="$(resolve_ref)"
    _OC_TMP="$(mktemp -d)"
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        if curl_get "https://raw.githubusercontent.com/$REPO/$ref/$path" \
            -o "$_OC_TMP/${path//\//.}" 2>/dev/null; then
            count=$((count + 1))
        fi
    done < <(list_tree_paths "$ref" "$SRC_TREE_DIR" 'ts')
    (( count > 0 )) || { error "Could not enumerate opencode source (GitHub rate limit?)"; return 1; }
    printf 'Outbound hosts referenced in %s source files at %s:\n' "$count" "$ref"
    grep -rhoE 'https?://[A-Za-z0-9._-]+' "$_OC_TMP" --include='*.ts' 2>/dev/null \
        | sed -E 's#^https?://##' \
        | grep -viE '^(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|example\\.(com|org|net))$' \
        | sort -u | sed 's/^/  /' || true
}

case "${1:-}" in
    runtime) cmd_runtime ;;
    schema) cmd_schema ;;
    docs) cmd_docs "${2:-}" ;;
    egress) cmd_egress ;;
    --help|-h|'') usage ;;
    *) error "Unknown command: $1"; usage >&2; exit 64 ;;
esac
