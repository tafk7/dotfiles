#!/bin/bash
# The dotfiles front door: update, apply, verify, and the machine profile.
#
# Usage: dotfiles update [--dry-run] [--upgrade]
#        dotfiles apply [--dry-run] [--only X,Y] [--reinstall[=X,Y]]
#                       [--overwrite-configs] [--force] [--upgrade] [--no-refresh]
#        dotfiles upgrade CLI[,CLI] [--dry-run]
#        dotfiles refresh [-v]
#        dotfiles bump TOOL [VERSION] [--security] | --refresh
#        dotfiles verify [-v] [--latest] [--smoke] [--diagnose]
#                        [--tier T] [--all] [--CAPABILITY]...
#        dotfiles profile [--add X | --remove X | --tier T | --propose]
#                         [--yes] [--no-apply]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Always this checkout: the front door runs the code it ships with.
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
export DOTFILES_DIR

source "$DOTFILES_DIR/lib/runtime.sh"
source "$DOTFILES_DIR/lib/config.sh"
source "$DOTFILES_DIR/lib/state.sh"
source "$DOTFILES_DIR/lib/work-host.sh"
source "$DOTFILES_DIR/lib/observe.sh"
source "$DOTFILES_DIR/lib/outcomes.sh"
source "$DOTFILES_DIR/lib/operation.sh"
source "$DOTFILES_DIR/lib/profile.sh"
source "$DOTFILES_DIR/lib/verify.sh"
source "$DOTFILES_DIR/lib/wezterm.sh"
source "$DOTFILES_DIR/lib/python.sh"
source "$DOTFILES_DIR/lib/staleness.sh"
source "$DOTFILES_DIR/lib/environment.sh"
source "$DOTFILES_DIR/lib/refresh.sh"

usage() {
    cat <<'EOF'
Usage: dotfiles <command> [options]

Commands:
  update                Take upstream changes: fetch and show them, fast-forward
                        this checkout, apply the machine profile (components,
                        --upgrade work, configs, one refresh), then verify and
                        report what still needs attention.
                        Needs the install path's checkout, on a branch with an
                        upstream, without uncommitted changes; a branch that has
                        diverged from its upstream stops it.
    --dry-run           Fetch and show; preview the apply without pulling.
    --upgrade           Also upgrade what is not pinned (see apply --upgrade).
  apply                 Bring this machine to the checkout and its profile:
                        install, move, or repair what the profile selects, run
                        their configure steps, then deploy configs. No pull.
    --dry-run           Show what would change, from what is installed now.
    --only X[,Y]        Only these components; configs are left alone. A need
                        that is not installed blocks one instead of installing.
    --reinstall[=X,Y]   Reinstall everything selected, or the named components.
    --overwrite-configs Replace configs that differ, keeping backups.
    --force             Both of the above.
    --upgrade           Also upgrade what is not pinned: the selection's APT
                        packages (apt's simulated transaction first; held ones
                        skipped), the AI CLIs and Pi, and rustup itself.
    --no-refresh        Skip the refresh that ends every apply.
  upgrade CLI[,CLI]     Update installed AI CLIs (claude, codex, opencode, pi)
                        now, through their official updaters, then run their
                        configure steps. A one-off: the profile is left as it
                        is, so this never makes dotfiles manage a CLI (profile
                        --add does). A CLI that is not installed is refused.
                        apply --upgrade updates the ones the profile selects.
    --dry-run           Show what would run.
  refresh               Bring running processes up to date with the disk: the
                        tmux server's environment, config, badge, and theme.
                        Lists shells and programs that predate a change and
                        need a restart (reload a shell). Exit 3 when a step
                        could not be made.
    -v                  List every step, passing ones included.
  bump TOOL [VERSION]   Move a pin in versions.lock (and eget.toml or
                        configs/init.vim) to a release, checked through its
                        source's own data for both architectures. Without
                        VERSION, the newest release outside the 14-day
                        cool-down. Edits files; never commits.
    --security          Allow a newer release that fixes an advisory.
    --refresh           Rewrite the eget rows for eget.toml's tags.
  verify                Check this machine against the checkout and its profile.
                        Changes nothing. Exit 1: setup has work to do; 3: a check
                        could not be made; 2: something needs you; 0: healthy.
    -v                  List every check, passing ones included.
    --latest            Also look up newer releases of pinned tools (network).
    --smoke             Also create, run, and remove one local sbx sandbox.
    --diagnose          With the local sandbox checks, also run sbx's bounded
                        local diagnostics (never uploads).
    --tier T            Check tier T's components (config, bash, dev, work)
                        in place of the profile's selection.
    --all               Also check every other component that applies here;
                        one that is not installed is a note.
    --tail, --rdp, --azure, --gcloud, --aws, --ai
                        Also expect a capability's components (--ai: every AI
                        CLI). One that cannot apply here needs you.
  profile               Show this machine's profile: what dotfiles manages here.
  profile --add X       Manage X: a capability (rdp, tail, azure, gcloud, aws),
                        ai (every AI CLI) or one AI CLI, or an opt-out
                        (no-git, no-hooks). Saved, then applied.
  profile --remove X    Stop managing X. Nothing is uninstalled; the commands
                        that would remove it are printed.
  profile --tier T      Set the tier (config, bash, dev, work). Raising it
                        applies the new tier; lowering it uninstalls nothing.
  profile --propose     Derive a profile from what dotfiles or the package
                        manager installed here and offer to save it.

Options:
  --yes                 Apply (or save a proposal) without asking.
  --no-apply            Save the change only.

Values may be comma-separated, as in --add tail,gcloud.
EOF
}

is_capability() { [[ ",$(profile_known_capabilities | paste -sd, -)," == *",$1,"* ]]; }
is_ai_tool() { [[ ",$(profile_ai_tool_names | paste -sd, -)," == *",$1,"* ]]; }
is_opt_out() { [[ " ${PROFILE_OPT_OUTS[*]} " == *" $1 "* ]]; }

# Unsupported explicit requests are rejected before anything is saved.
validate_addition() {
    local item="$1" component
    if is_capability "$item"; then
        while IFS= read -r component; do
            tool_applicable "$component" \
                || { error "$item is not supported on this platform ($component is not applicable)"; return 1; }
        done < <(tools_for_capability "$item")
    elif is_ai_tool "$item"; then
        tool_applicable "$item" || { error "$item is not supported on this platform"; return 1; }
    elif [[ "$item" != ai ]] && ! is_opt_out "$item"; then
        error "Unknown selection: $item"
        return 64
    fi
}

add_item() {
    local item="$1"
    if is_capability "$item"; then
        PROFILE[capabilities]="$(_profile_list_add "${PROFILE[capabilities]}" "$item")"
    elif [[ "$item" == ai ]]; then
        PROFILE[ai]=all PROFILE[ai.exclude]=""
    elif is_ai_tool "$item"; then
        if [[ "${PROFILE[ai]}" == all ]]; then
            PROFILE[ai.exclude]="$(_profile_list_remove "${PROFILE[ai.exclude]}" "$item")"
        else
            PROFILE[ai]="$(_profile_list_add "${PROFILE[ai]}" "$item")"
        fi
    elif is_opt_out "$item"; then
        PROFILE[opt-outs]="$(_profile_list_add "${PROFILE[opt-outs]}" "$item")"
    fi
}

# Components that stop being managed are appended to UNMANAGED, for the
# uninstall hint.
UNMANAGED=()
remove_item() {
    local item="$1"
    if is_capability "$item"; then
        PROFILE[capabilities]="$(_profile_list_remove "${PROFILE[capabilities]}" "$item")"
        readarray -t -O "${#UNMANAGED[@]}" UNMANAGED < <(tools_for_capability "$item")
    elif [[ "$item" == ai ]]; then
        readarray -t -O "${#UNMANAGED[@]}" UNMANAGED < <(profile_ai_tools)
        PROFILE[ai]="" PROFILE[ai.exclude]=""
    elif is_ai_tool "$item"; then
        if [[ "${PROFILE[ai]}" == all ]]; then
            PROFILE[ai.exclude]="$(_profile_list_add "${PROFILE[ai.exclude]}" "$item")"
        else
            PROFILE[ai]="$(_profile_list_remove "${PROFILE[ai]}" "$item")"
        fi
        UNMANAGED+=("$item")
    elif is_opt_out "$item"; then
        PROFILE[opt-outs]="$(_profile_list_remove "${PROFILE[opt-outs]}" "$item")"
    else
        error "Unknown selection: $item"
        return 64
    fi
}

print_unmanaged() {
    local component
    (( $# )) || return 0
    printf 'No longer managed (still installed). To remove one:\n'
    for component in "$@"; do printf '  %s/bin/uninstall-tool %s\n' "$DOTFILES_DIR" "$component"; done
}

confirm() {
    local answer
    [[ -t 0 && -t 1 ]] || return 1
    read -rp "$1 [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^[Yy] ]]
}

# Plan, then apply the whole profile. A failed apply keeps the saved intent;
# verify reports what is missing until an apply succeeds.
apply_profile() {
    local assume_yes="$1" no_apply="$2" plan
    plan="$(cmd_apply --dry-run 2>&1 | grep -Ei 'would|unknown|blocked' | sed 's/^\[[A-Z]*\] //; s/^ *//; s/^\[DRY RUN\] //' || true)"
    if [[ -z "$plan" ]]; then
        printf 'plan:    nothing to change\n'
        return 0
    fi
    printf 'plan:\n%s\n' "$(sed 's/^/  /' <<< "$plan")"
    if [[ "$no_apply" == true ]]; then
        printf 'Saved; not applied (--no-apply). Apply it with: dotfiles apply\n'
        return 0
    fi
    if [[ "$assume_yes" != true ]] && ! confirm "apply now?"; then
        printf 'Saved; not applied. Apply it with: dotfiles apply\n'
        return 0
    fi
    cmd_apply || { error "Apply failed; the profile keeps the new intent"; return 1; }
}

# refresh: running processes only (lib/refresh.sh), then which shells and
# programs still predate a change. Exit 3 when a step could not be made.
cmd_refresh() {
    local verbose=false records rc
    while (( $# )); do
        case "$1" in
            -v|--verbose) verbose=true ;;
            --help|-h) usage; return 0 ;;
            *) error "Unknown option: $1"; usage >&2; return 64 ;;
        esac
        shift
    done
    operation_begin "$SCRIPT_DIR/dotfiles" refresh "${ORIGINAL_ARGS[@]}"
    log "Refreshing running processes..."
    records="$(refresh_tmux; staleness_report --sweep)"
    if [[ "$verbose" == true ]]; then outcome_render -v <<< "$records"; else outcome_render <<< "$records"; fi
    rc="$(outcome_exit refresh <<< "$records")"
    return "$rc"
}

# apply: the whole profile through setup, from what is installed now, then
# one refresh (unless --no-refresh). Exit 1 when setup failed or blocked
# something, 3 without a readable profile.
cmd_apply() {
    local dry_run=false refresh=true rc=0 refresh_rc=0
    local -a extra=() args=()
    while (( $# )); do
        case "$1" in
            --dry-run) dry_run=true; extra+=("$1") ;;
            --no-refresh) refresh=false ;;
            --only) [[ -n "${2:-}" ]] || { error "--only requires component names"; return 64; }; extra+=("$1" "$2"); shift ;;
            --only=*|--reinstall|--reinstall=*|--overwrite-configs|--force|--upgrade) extra+=("$1") ;;
            --help|-h) usage; return 0 ;;
            *) error "Unknown option: $1"; usage >&2; return 64 ;;
        esac
        shift
    done
    if ! profile_exists; then
        error "No machine profile yet; create one with: dotfiles profile --propose"
        return 3
    fi
    profile_load || return 3
    [[ "$dry_run" == true ]] || operation_begin "$SCRIPT_DIR/dotfiles" apply "${ORIGINAL_ARGS[@]}"
    readarray -t args < <(profile_setup_args)
    # Setup leaves running processes to the refresh below.
    DOTFILES_REFRESH_FOLLOWS="$([[ "$refresh" == true && "$dry_run" != true ]] && echo 1)" \
        "$DOTFILES_DIR/setup.sh" "${args[@]}" "${extra[@]}" || rc=$?
    (( rc != 64 )) || return 64
    if [[ "$refresh" == true && "$dry_run" != true ]]; then
        echo
        cmd_refresh || refresh_rc=$?
    fi
    (( rc == 0 )) || return 1
    return "$refresh_rc"
}

# upgrade: a one-off update of installed AI CLIs, through setup with --only
# and --upgrade: each CLI's updater, then its configure steps. Unlike a setup
# run, it leaves the profile alone, so updating a CLI does not make dotfiles
# manage it. Exit 1 when a CLI is not installed or setup failed.
cmd_upgrade() {
    local dry_run=false name path rc=0
    local -a names=() flags=() requested
    while (( $# )); do
        case "$1" in
            --dry-run) dry_run=true ;;
            --help|-h) usage; return 0 ;;
            -*) error "Unknown option: $1"; usage >&2; return 64 ;;
            *) IFS=, read -ra requested <<< "$1"; names+=("${requested[@]}") ;;
        esac
        shift
    done
    if (( ${#names[@]} == 0 )); then
        error "Name the AI CLIs to upgrade: $(profile_ai_tool_names | paste -sd' ' -)"
        return 64
    fi
    for name in "${names[@]}"; do
        is_ai_tool "$name" || { error "Not an AI CLI: $name (upgrade takes $(profile_ai_tool_names | paste -sd' ' -))"; return 64; }
    done
    [[ "$dry_run" == true ]] || operation_begin "$SCRIPT_DIR/dotfiles" upgrade "${ORIGINAL_ARGS[@]}"
    for name in "${names[@]}"; do
        tool_applicable "$name" || { error "$name is not supported on this platform"; return 1; }
        # A CLI that is not here is installed by managing it, not by an upgrade.
        path="$(observe_component "$name" 2>/dev/null | observation_field path || true)"
        if [[ -z "$path" ]]; then
            error "$name is not installed; to install it and have dotfiles manage it: dotfiles profile --add $name"
            return 1
        fi
        flags+=("--$name")
    done
    [[ "$dry_run" != true ]] || flags+=(--dry-run)
    DOTFILES_KEEP_PROFILE=1 "$DOTFILES_DIR/setup.sh" "${flags[@]}" \
        --only "$(IFS=,; printf '%s' "${names[*]}")" --upgrade || rc=$?
    (( rc != 64 )) || return 64
    (( rc == 0 )) || return 1
}

cmd_profile() {
    local action="" value="" assume_yes=false no_apply=false item
    while (( $# )); do
        case "$1" in
            --add|--remove|--tier)
                [[ -z "$action" ]] || { error "Give one of --add, --remove, --tier, --propose"; return 64; }
                [[ -n "${2:-}" && "$2" != --* ]] || { error "$1 requires a value"; return 64; }
                action="${1#--}" value="$2"; shift
                ;;
            --propose)
                [[ -z "$action" ]] || { error "Give one of --add, --remove, --tier, --propose"; return 64; }
                action=propose
                ;;
            --yes|-y) assume_yes=true ;;
            --no-apply) no_apply=true ;;
            --help|-h) usage; return 0 ;;
            *) error "Unknown option: $1"; usage >&2; return 64 ;;
        esac
        shift
    done

    if [[ -z "$action" ]]; then
        if ! profile_exists; then
            printf 'No machine profile yet. Derive one from what is installed with: dotfiles profile --propose\n'
            return 0
        fi
        profile_load || return 3
        profile_describe
        return 0
    fi

    operation_begin "$SCRIPT_DIR/dotfiles" profile "${ORIGINAL_ARGS[@]}"
    profile_load || return 3
    local before_tier="${PROFILE[tier]}"
    case "$action" in
        add)
            for item in ${value//,/ }; do validate_addition "$item" || return; done
            for item in ${value//,/ }; do add_item "$item"; done
            profile_save || return 1
            printf 'profile: + %s\n' "${value//,/, }"
            apply_profile "$assume_yes" "$no_apply"
            ;;
        remove)
            for item in ${value//,/ }; do remove_item "$item" || return; done
            profile_save || return 1
            printf 'profile: - %s\n' "${value//,/, }"
            print_unmanaged "${UNMANAGED[@]+"${UNMANAGED[@]}"}"
            ;;
        tier)
            _profile_tier_rank "$value" >/dev/null || { error "Unknown tier: $value"; return 64; }
            PROFILE[tier]="$value"
            profile_save || return 1
            printf 'profile: tier %s -> %s\n' "$before_tier" "$value"
            if (( $(_profile_tier_rank "$value") > $(_profile_tier_rank "$before_tier") )); then
                apply_profile "$assume_yes" "$no_apply"
            else
                local name
                while IFS= read -r name; do
                    tool_in_cumulative_tier "$name" "$before_tier" && ! tool_in_cumulative_tier "$name" "$value" \
                        && ledger_line "$name" >/dev/null 2>&1 && UNMANAGED+=("$name")
                done < <(printf '%s\n' "${!TOOL_TIER[@]}" | LC_ALL=C sort)
                print_unmanaged "${UNMANAGED[@]+"${UNMANAGED[@]}"}"
            fi
            ;;
        propose)
            profile_exists && warn "A profile already exists; saving the proposal replaces it."
            profile_propose
            printf 'Proposed from what is installed (only what dotfiles or the package manager installed):\n'
            profile_describe | sed 's/^/  /'
            if [[ "$assume_yes" == true ]] || confirm "save this profile?"; then
                profile_save || return 1
                printf 'Saved.\n'
            else
                printf 'Not saved. Rerun with --yes to save it.\n'
            fi
            ;;
    esac
}

# verify: every check against the profile (or the options' selection; see
# lib/verify.sh). Exit 1: setup has work to do; 3: a check could not be made;
# 2: something needs you; 0: healthy.
cmd_verify() {
    local verbose=false latest=false smoke=false records rc i
    while (( $# )); do
        case "$1" in
            -v|--verbose) verbose=true ;;
            --latest) latest=true ;;
            --smoke) smoke=true VERIFY_SMOKE=true ;;
            --diagnose) export WORK_DIAGNOSE=true ;;
            --tier) [[ -n "${2:-}" ]] || { error "--tier requires a value"; return 64; }; VERIFY_TIER="$2"; shift ;;
            --tier=*) VERIFY_TIER="${1#--tier=}"; [[ -n "$VERIFY_TIER" ]] || { error "--tier requires a value"; return 64; } ;;
            --all) VERIFY_ALL=true ;;
            --help|-h) usage; return 0 ;;
            *)
                if [[ "$1" == --ai ]] || { [[ "$1" == --?* ]] && is_capability "${1#--}"; }; then
                    VERIFY_CAPABILITIES="$(_profile_list_add "$VERIFY_CAPABILITIES" "${1#--}")"
                else
                    error "Unknown option: $1"; usage >&2; return 64
                fi
                ;;
        esac
        shift
    done
    if [[ -n "$VERIFY_TIER" ]] && ! _profile_tier_rank "$VERIFY_TIER" >/dev/null; then
        error "Unknown tier: $VERIFY_TIER (config, bash, dev, work)"
        return 64
    fi
    # The smoke test creates a sandbox, so it runs as an operation.
    [[ "$smoke" != true ]] || operation_begin "$SCRIPT_DIR/dotfiles" verify "${ORIGINAL_ARGS[@]}"
    records="$(
        if ! operation_joined && ! operation_held_here; then
            for ((i = 0; i < ${DOTFILES_OPERATION_WAIT:-5} * 4; i++)); do operation_busy || break; sleep 0.25; done
            if operation_busy; then
                outcome incomplete State operation "in progress: $(operation_describe_holder); results may change"
            fi
        fi
        verify_checkout
        verify_state
        verify_components
        verify_configs
        verify_editor_plugins
        verify_ai
        verify_host
        verify_git
        verify_wsl
        verify_environment
        verify_agent_shell
        verify_wezterm
        staleness_report
        [[ "$latest" != true ]] || verify_upstream
        if [[ "$smoke" == true ]]; then
            if work_smoke_test >&2; then
                outcome ok "Local sandboxes" "smoke test" "created, ran, and removed a local shell sandbox"
            else
                outcome health "Local sandboxes" "smoke test" "failed (see the output above)"
            fi
        fi
    )"
    if [[ "$verbose" == true ]]; then
        outcome_render -v <<< "$records"
    else
        outcome_render <<< "$records"
    fi
    rc="$(outcome_exit verify <<< "$records")"
    [[ -z "$(outcome_render <<< "$records")" ]] || echo
    printf '%s\n' "$(outcome_summary <<< "$records")"
    return "$rc"
}

# update's checks before it pulls; prints the problem and returns 3.
update_preconditions() {
    local install_path="" branch
    git -C "$DOTFILES_DIR" rev-parse --git-dir >/dev/null 2>&1 \
        || { error "$DOTFILES_DIR is not a Git checkout"; return 3; }
    [[ ! -f "$DOTFILES_STATE_DIR/install-path" ]] || install_path="$(<"$DOTFILES_STATE_DIR/install-path")"
    if [[ "$install_path" != "$DOTFILES_DIR" ]]; then
        error "This checkout is not the install path (${install_path:-none recorded}); update that checkout instead"
        return 3
    fi
    branch="$(git -C "$DOTFILES_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
        || { error "The checkout is on a detached HEAD; check out a branch first"; return 3; }
    git -C "$DOTFILES_DIR" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
        || { error "Branch $branch has no upstream to update from"; return 3; }
    if [[ -n "$(git -C "$DOTFILES_DIR" status --porcelain --untracked-files=no)" ]]; then
        error "The checkout has uncommitted changes; commit or stash them first"
        git -C "$DOTFILES_DIR" status --short --untracked-files=no >&2
        return 3
    fi
}

# Everything after the pull, run by the new code: setup with the profile, then
# verify, then the report.
update_continue() {
    local before="$1" dry_run="$2" upgrade="${3:-}" setup_rc=0 verify_rc=0 after
    local -a args apply_args=()
    [[ -z "$upgrade" ]] || apply_args+=(--upgrade)
    if ! profile_exists; then
        error "No machine profile yet; create one with: dotfiles profile --propose"
        return 3
    fi
    profile_load || return 3
    readarray -t args < <(profile_setup_args)
    log "Applying the profile: setup.sh ${args[*]}"
    if [[ "$dry_run" == true ]]; then
        cmd_apply --dry-run "${apply_args[@]}" || setup_rc=$?
        return "$(( setup_rc == 0 ? 0 : 1 ))"
    fi
    # Shells read the pulled startup files only when they next load them.
    after="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD)"
    if [[ "$before" != "$after" ]] \
       && ! git -C "$DOTFILES_DIR" diff --quiet "$before" "$after" -- shell entry; then
        change_record shell "pulled $before..$after"
    fi
    cmd_apply "${apply_args[@]}" || setup_rc=$?
    echo
    "$SCRIPT_DIR/dotfiles" verify || verify_rc=$?
    after="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD)"
    echo
    if [[ "$before" == "$after" ]]; then
        printf 'update: at %s; ' "$after"
    else
        printf 'update: %s -> %s; ' "$before" "$after"
    fi
    if journal_pending; then
        printf 'an interrupted replacement is pending for %s (the next apply reconciles it); ' \
            "$(journal_pending_components | paste -sd ' ')"
    fi
    if (( setup_rc != 0 )); then
        printf 'setup failed (see its log in %s/logs)\n' "$DOTFILES_STATE_DIR"
        return 1
    fi
    case "$verify_rc" in
        0|2) printf 'setup completed\n'; return 0 ;;
        3) printf 'setup completed; some checks could not be made\n'; return 3 ;;
        *) printf 'setup completed; verify found remaining work\n'; return 1 ;;
    esac
}

cmd_update() {
    local dry_run=false upgrade="" before="" ahead behind
    while (( $# )); do
        case "$1" in
            --dry-run) dry_run=true ;;
            --upgrade) upgrade=--upgrade ;;
            --continue) [[ -n "${2:-}" ]] || { error "--continue requires a revision"; return 64; }; before="$2"; shift ;;
            --help|-h) usage; return 0 ;;
            *) error "Unknown option: $1"; usage >&2; return 64 ;;
        esac
        shift
    done
    # After the pull this process re-execs the new code with --continue; the
    # lock spans the re-exec, which keeps the pid.
    if [[ -n "$before" ]]; then
        update_continue "$before" "$dry_run" "$upgrade"
        return
    fi
    [[ "$dry_run" == true ]] || operation_begin "$SCRIPT_DIR/dotfiles" update "${ORIGINAL_ARGS[@]}"
    update_preconditions || return
    before="$(git -C "$DOTFILES_DIR" rev-parse --short HEAD)"
    git -C "$DOTFILES_DIR" fetch --quiet || { error "git fetch failed"; return 3; }
    ahead="$(git -C "$DOTFILES_DIR" rev-list --count '@{upstream}..HEAD')"
    behind="$(git -C "$DOTFILES_DIR" rev-list --count 'HEAD..@{upstream}')"
    if (( ahead > 0 && behind > 0 )); then
        error "The branch has diverged from its upstream ($ahead local, $behind upstream commits); reconcile it by hand"
        return 3
    fi
    if (( behind == 0 )); then
        if (( ahead > 0 )); then
            log "The checkout is $ahead commit(s) ahead of its upstream; nothing to pull"
        else
            log "The checkout is up to date with its upstream"
        fi
        update_continue "$before" "$dry_run" "$upgrade"
        return
    fi
    log "Upstream changes ($behind):"
    git -C "$DOTFILES_DIR" log --oneline --no-decorate 'HEAD..@{upstream}'
    if [[ "$dry_run" == true ]]; then
        log "[DRY RUN] Would pull; previewing setup with the current checkout"
        update_continue "$before" true "$upgrade"
        return
    fi
    git -C "$DOTFILES_DIR" pull --ff-only --quiet || { error "git pull --ff-only failed"; return 3; }
    exec "$BASH" "$SCRIPT_DIR/dotfiles" update --continue "$before" ${upgrade:+"$upgrade"}
}

ORIGINAL_ARGS=("$@")
case "${1:-}" in
    update) shift; ORIGINAL_ARGS=("$@"); cmd_update "$@" ;;
    apply) shift; ORIGINAL_ARGS=("$@"); cmd_apply "$@" ;;
    upgrade) shift; ORIGINAL_ARGS=("$@"); cmd_upgrade "$@" ;;
    refresh) shift; ORIGINAL_ARGS=("$@"); cmd_refresh "$@" ;;
    bump) shift; exec python3 "$DOTFILES_DIR/lib/bump.py" "$@" ;;
    verify) shift; ORIGINAL_ARGS=("$@"); cmd_verify "$@" ;;
    profile) shift; ORIGINAL_ARGS=("$@"); cmd_profile "$@" ;;
    --help|-h|help|"") usage ;;
    *) error "Unknown command: $1"; usage >&2; exit 64 ;;
esac
