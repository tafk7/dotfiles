#!/bin/bash
# Dotfiles Cheat Sheet - Quick reference for all keybindings and shortcuts

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
source "$DOTFILES_DIR/lib/runtime.sh"

TERM_WIDTH=$(tput cols 2>/dev/null || echo 80)

if command -v tput >/dev/null 2>&1 && [[ -t 1 ]]; then
    BOLD=$(tput bold)
    CYAN=$(tput setaf 6)
    YELLOW=$(tput setaf 3)
    DIM=$(tput dim)
    RESET=$(tput sgr0)
else
    BOLD=""
    CYAN=""
    YELLOW=""
    DIM=""
    RESET=""
fi

print_header() {
    local title="$1"
    echo
    echo "${BOLD}${CYAN}${title}${RESET}"
}

print_separator() {
    printf "${DIM}"
    printf '─%.0s' $(seq 1 "$TERM_WIDTH")
    printf "${RESET}\n"
}

format_shortcut() {
    local shortcut="$1"
    local description="$2"
    printf "    ${YELLOW}%-15s${RESET} %s\n" "$shortcut" "$description"
}

show_category() {
    local category="$1"
    local title="$2"

    print_header "$title"

    build_shortcut_index | grep "^${category}│" | while IFS='│' read -r cat shortcut description command; do
        format_shortcut "$shortcut" "$description"
    done
}

show_vim() {
    show_category "vim" "VIM KEYBINDINGS"
}

show_tmux() {
    show_category "tmux" "TMUX KEYBINDINGS (Prefix: Ctrl+a)"
}

show_git() {
    show_category "git" "GIT ALIASES"
}

show_shell() {
    show_category "shell" "SHELL ALIASES & SHORTCUTS"
}

# Docker, Python, and Node shortcuts together.
show_dev() {
    print_header "DEVELOPMENT SHORTCUTS"

    echo
    echo "${BOLD}Docker${RESET}"
    build_shortcut_index | grep "^docker│" | while IFS='│' read -r cat shortcut description command; do
        format_shortcut "$shortcut" "$description"
    done

    echo
    echo "${BOLD}Python${RESET}"
    build_shortcut_index | grep "^python│" | while IFS='│' read -r cat shortcut description command; do
        format_shortcut "$shortcut" "$description"
    done

    echo
    echo "${BOLD}Node.js${RESET}"
    build_shortcut_index | grep "^node│" | while IFS='│' read -r cat shortcut description command; do
        format_shortcut "$shortcut" "$description"
    done
}

# Generated from lib/registry.sh, with each tool's live presence.
show_tools() {
    print_header "INSTALLED TOOLS (from lib/registry.sh)"

    # Loaded on demand to keep other views fast.
    # shellcheck source=../lib/registry.sh
    source "$DOTFILES_DIR/lib/registry.sh"

    local name status membership
    while IFS= read -r name; do
        membership="tier=${TOOL_TIER[$name]:--}"
        [[ -z "${TOOL_CAPABILITIES[$name]:-}" ]] || membership+="; cap=${TOOL_CAPABILITIES[$name]}"
        if tool_is_present "$name"; then status=installed; else status="not installed"; fi
        printf "    %-18s ${YELLOW}%-12s${RESET} ${DIM}(%s, %s, %s)${RESET}\n" \
            "$name" "${TOOL_BINARY[$name]}" "${TOOL_METHOD[$name]}" "$membership" "$status"
    done < <(printf '%s\n' "${!TOOL_BINARY[@]}" | sort)
}

# Lists bin/ scripts with the one-line description on each script's line 2.
show_commands() {
    print_header "UTILITY COMMANDS (bin/)"

    local f name desc
    while IFS= read -r f; do
        name="$(basename "$f")"
        desc="$(sed -n '2p' "$f" | sed -n 's/^# \{0,1\}//p')"
        [[ -n "$desc" ]] && printf "    ${YELLOW}%-18s${RESET} %s\n" "$name" "$desc"
    done < <(find "$DOTFILES_DIR/bin" -maxdepth 1 -type f | sort)
}

show_all() {
    show_vim
    show_tmux
    show_git
    show_shell
    show_dev
    show_tools
    show_commands
}

# Rows of shell/shortcuts-index.tsv: category│shortcut│description│full_command
build_shortcut_index() {
    local index_file="$DOTFILES_DIR/shell/shortcuts-index.tsv"

    if [[ ! -f "$index_file" ]]; then
        echo "Error: Shortcuts index not found at $index_file" >&2
        return 1
    fi

    grep -v '^#' "$index_file" | grep -v '^$'
}

show_shortcut_detail() {
    local category="$1"
    local shortcut="$2"

    local detail
    detail=$(build_shortcut_index | grep "^${category}│${shortcut}│")

    if [[ -n "$detail" ]]; then
        local desc cmd
        desc=$(echo "$detail" | cut -d'│' -f3)
        cmd=$(echo "$detail" | cut -d'│' -f4)

        echo ""
        echo "${BOLD}${YELLOW}${shortcut}${RESET}"
        echo "${DIM}────────────────────────────────────────${RESET}"
        echo "${CYAN}Category:${RESET}    ${category}"
        echo "${CYAN}Usage:${RESET}       ${desc}"
        echo "${CYAN}Command:${RESET}     ${cmd}"
        echo ""

        # Add context-specific tips
        case "$category" in
            git)
                echo "${DIM}💡 Tip: Type 'cheat git' for all git shortcuts${RESET}"
                ;;
            tmux)
                echo "${DIM}💡 Tip: Prefix is Ctrl+a (edit configs/tmux.conf to change it)${RESET}"
                ;;
            vim)
                echo "${DIM}💡 Tip: Leader key is comma (,)${RESET}"
                ;;
        esac
    else
        echo ""
        echo "${DIM}No details available${RESET}"
        echo ""
    fi
}

export -f show_shortcut_detail
export -f build_shortcut_index

show_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        show_all | less -R
        return
    fi

    local PREVIEW_BOLD PREVIEW_CYAN PREVIEW_YELLOW PREVIEW_DIM PREVIEW_RESET
    if command -v tput >/dev/null 2>&1; then
        PREVIEW_BOLD=$(tput bold)
        PREVIEW_CYAN=$(tput setaf 6)
        PREVIEW_YELLOW=$(tput setaf 3)
        PREVIEW_DIM=$(tput dim)
        PREVIEW_RESET=$(tput sgr0)
    else
        PREVIEW_BOLD=""
        PREVIEW_CYAN=""
        PREVIEW_YELLOW=""
        PREVIEW_DIM=""
        PREVIEW_RESET=""
    fi

    local index_file preview_script
    index_file=$(mktemp)
    build_shortcut_index > "$index_file"

    preview_script=$(mktemp)
    cat > "$preview_script" <<PREVIEW_EOF
#!/bin/bash
# Self-contained preview script - receives original TSV line via stdin
BOLD="$PREVIEW_BOLD"
CYAN="$PREVIEW_CYAN"
YELLOW="$PREVIEW_YELLOW"
DIM="$PREVIEW_DIM"
RESET="$PREVIEW_RESET"

# Read the TSV line from stdin
line=\$(cat)
category=\$(echo "\$line" | awk -F'│' '{print \$1}')
shortcut=\$(echo "\$line" | awk -F'│' '{print \$2}')
full_desc=\$(echo "\$line" | awk -F'│' '{print \$3}')
full_cmd=\$(echo "\$line" | awk -F'│' '{print \$4}')

if [[ -n "\$shortcut" ]]; then
    echo ""
    echo "\${BOLD}\${YELLOW}\${shortcut}\${RESET}"
    echo "\${DIM}────────────────────────────────────────\${RESET}"
    echo "\${CYAN}Category:\${RESET}     \${category}"
    echo "\${CYAN}Command:\${RESET}      \${full_cmd}"
    echo "\${CYAN}Description:\${RESET}  \${full_desc}"
    echo ""

    case "\$category" in
        git)
            echo "\${DIM}💡 Tip: Type 'cheat git' for all git shortcuts\${RESET}"
            ;;
        tmux)
            echo "\${DIM}💡 Tip: Prefix is Ctrl+a\${RESET}"
            ;;
        vim)
            echo "\${DIM}💡 Tip: Leader key is comma (,)\${RESET}"
            ;;
        docker)
            echo "\${DIM}💡 Tip: 'd' prefix for all docker commands\${RESET}"
            ;;
        python)
            echo "\${DIM}💡 Tip: Use 'venv' to create virtual environments\${RESET}"
            ;;
        node)
            echo "\${DIM}💡 Tip: 'nr' = npm run, 'ni' = npm install\${RESET}"
            ;;
    esac
else
    echo ""
    echo "\${DIM}No details available\${RESET}"
    echo ""
fi
PREVIEW_EOF
    chmod +x "$preview_script"

    # Show category, shortcut, and command; keep the original row after a tab.
    local selected
    selected=$({
        printf "${BOLD}%-10s │ %-15s │ %s${RESET}\n" "CATEGORY" "SHORTCUT" "COMMAND"
        printf "${DIM}%-10s─┼─%-15s─┼─%s${RESET}\n" "$(printf '─%.0s' {1..10})" "$(printf '─%.0s' {1..15})" "$(printf '─%.0s' {1..50})"
        cat "$index_file" | awk -F'│' '{
            display = sprintf("%-10s │ %-15s │ %s", $1, $2, $4)
            print display "\t" $0
        }'
    } | \
        fzf --ansi \
            --prompt='🔍 Search shortcuts > ' \
            --header='Type: shortcut name, description, or category | Enter: Copy command | Esc: Cancel' \
            --header-lines=2 \
            --delimiter='\t' \
            --with-nth=1 \
            --preview="echo {2} | $preview_script" \
            --preview-window='top:10:wrap:rounded:border-rounded' \
            --height=100% \
            --border=rounded \
            --color='header:italic:cyan,prompt:bold:yellow')

    rm -f "$preview_script" "$index_file"

    if [[ -n "$selected" ]]; then
        local original command
        original=$(echo "$selected" | cut -f2)
        command=$(echo "$original" | awk -F'│' '{print $4}')
        echo ""
        echo "${BOLD}${CYAN}Command:${RESET} ${YELLOW}${command}${RESET}"
        echo ""
        echo "${DIM}💡 Tip: Use Ctrl+Shift+C to copy from terminal${RESET}"
        echo ""
    fi
}

main() {
    case "${1}" in
        vim)
            show_vim
            ;;
        tmux)
            show_tmux
            ;;
        git)
            show_git
            ;;
        shell)
            show_shell
            ;;
        dev)
            show_dev
            ;;
        tools)
            show_tools
            ;;
        commands)
            show_commands
            ;;
        all)
            show_all
            ;;
        "")
            show_interactive
            ;;
        *)
            echo "Usage: cheat [vim|tmux|git|shell|dev|tools|commands|all]"
            echo "Show keybindings and shortcuts for dotfiles tools"
            echo ""
            echo "Run 'cheat' with no arguments for interactive mode"
            exit 1
            ;;
    esac
}

main "$@"
