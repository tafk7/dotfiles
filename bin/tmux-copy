#!/usr/bin/env bash
# Export tmux copies to the client clipboard via OSC 52, size-gated.
#
# Why not `set -g set-clipboard on`: over Windows -> ssh -> Linux, OSC 52 is the
# only clipboard path (no clip.exe, wl-copy, or reachable X display), but tmux's
# own OSC 52 has no size limit. A large selection becomes one huge escape
# sequence that stalls the terminal for seconds. So tmux stays out of it
# (`set-clipboard off`) and every copy comes here, where the payload is
# bounded. Over the limit the clipboard is skipped with a message; the tmux
# buffer is always set, so prefix+p pastes at any size.
#
# Usage:
#     tmux-copy                     copy-mode copies (tmux copy-command; stdin)
#     tmux-copy --hook NAME         buffers loaded from outside (after-load-buffer)
#     tmux-copy --buffer [--notify] export the newest buffer now (prefix+e)
#
# The hook passes the load's -b name and exports only automatic buffers (no
# name), so named ones, such as compose pastes, stay in tmux. --always is
# accepted and ignored: shells started while export had an off switch pass it.
#
# Limit is @clipboard-limit (bytes of raw text, before base64). Retune live:
#     tmux set -g @clipboard-limit 32768
# Terminals drop sequences above roughly 100 KB (about 75 KB of text), so larger
# limits only add latency.

set -uo pipefail

DEFAULT_LIMIT=65536

mode=stdin
notify=false
hook_buffer=
while (($#)); do
    case "$1" in
        --always) ;;
        --buffer) mode=buffer ;;
        --notify) notify=true ;;
        --hook)
            mode=hook
            hook_buffer=${2:-}
            shift
            ;;
        *)
            tmux display-message "clipboard export: unknown option $1" 2>/dev/null
            exit 2
            ;;
    esac
    shift
done

case "$mode" in
    stdin)
        payload=$(cat)
        ;;
    hook)
        [[ -z "$hook_buffer" ]] || exit 0
        payload=$(tmux show-buffer 2>/dev/null) || exit 0
        ;;
    buffer)
        if ! payload=$(tmux show-buffer 2>/dev/null); then
            tmux display-message "clipboard export: tmux buffer is empty" 2>/dev/null
            exit 1
        fi
        ;;
esac
size=${#payload}

limit=$(tmux show -gv @clipboard-limit 2>/dev/null)
[[ "$limit" =~ ^[0-9]+$ ]] || limit=$DEFAULT_LIMIT

if (( size > limit )); then
    tmux display-message \
        "clipboard skipped: $((size / 1024)) KB exceeds $((limit / 1024)) KB (prefix+p still pastes)" \
        2>/dev/null
    exit 0
fi

# base64 -w0: one line, no wrapping. A newline inside the escape sequence would
# terminate it early and leave the tail printing as garbage into the pane.
b64=$(printf '%s' "$payload" | base64 -w0 2>/dev/null) || exit 0

# Write straight to each attached client's tty rather than to stdout. copy-pipe
# gives us the selection on stdin but no path back to the terminal, and tmux
# would swallow a bare escape sequence written to stdout. Every attached client
# gets it, so the clipboard lands wherever you are actually looking.
sent=0
while IFS= read -r tty; do
    [[ -w "$tty" ]] || continue
    if printf '\033]52;c;%s\007' "$b64" > "$tty" 2>/dev/null; then
        ((sent++))
    fi
done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)

if [[ "$notify" == true ]]; then
    if (( sent > 0 )); then
        tmux display-message "tmux buffer exported to $sent client clipboard(s)"
    else
        tmux display-message "clipboard export failed: no writable tmux clients"
        exit 1
    fi
fi

exit 0
