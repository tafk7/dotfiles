#!/usr/bin/env bash
# Review a pane: a frozen, searchable, selectable view of its conversation or
# history, with the same keys in every pane. See
# issues/scrollback-copy-compose.md §3.3.
#
#     tmux-review toggle PANE [CLIENT]   review (ScrollLock, prefix+f), or leave it
#     tmux-review search PANE [CLIENT]   review and search upward (prefix+/)
#     tmux-review edit PANE [CLIENT]     the conversation or history read-only in
#                                        an nvim popup (prefix+o)
#     tmux-review open PANE [CLIENT]     the pane's history in that popup, at the
#                                        line being viewed (o in review)
#     tmux-review close PANE             remove a review pane that left copy-mode
#                                        (the pane-mode-changed hook)
#     tmux-review show DIR PROMPT CHANNEL    the review pane's program
#
# A shell, or any program whose output is in tmux history, is reviewed in place
# in tmux copy-mode. An agent draws its conversation on the alternate screen,
# which tmux history never sees, so review asks the agent for the conversation
# as text and shows it in copy-mode in a review pane, zoomed over the agent's
# window. The agent keeps running underneath; leaving copy-mode removes the
# pane and gives the window back. The text comes from each agent's own export:
#   claude    Ctrl+O v: Claude writes its transcript as drawn and runs $VISUAL,
#             bin/compose-editor, on it. Asked through the pane option
#             @review-file, compose-editor moves the file there and returns at
#             once, since Claude stops while its editor runs; Ctrl+O then leaves
#             Claude's transcript view. Without compose-editor as its VISUAL,
#             Claude's own transcript view opens instead.
#   codex     its session file, as Markdown (bin/codex-transcript); the pane
#             title names the thread when tui.terminal_title has thread-id.
#   opencode  its export dialog (Ctrl+X x, Shift+Tab to Export, Enter): Markdown
#             in a temporary directory. Esc closes the "Session exported"
#             notice once it shows; on its own, Esc interrupts a running turn.
# The review pane marks each prompt line with OSC 133, so Ctrl+E/D move between
# prompts as they do in a shell.
#
# @review-timeout (seconds, default 10) bounds the wait for an agent's text.

set -uo pipefail
umask 077

self=$(readlink -f "${BASH_SOURCE[0]}")
action=${1:-}
pane=${2:-}
client=${3:-}
usage() { echo "usage: tmux-review toggle|search|edit|open|close PANE [CLIENT]" >&2; exit 2; }

pane_format() { tmux display-message -p -t "$pane" "$1"; }

message() { tmux display-message -t "$pane" "review: $1"; }

pane_in_mode() { [[ "$(pane_format '#{pane_in_mode}')" == 1 ]]; }

timeout_tenths() {
    local seconds
    seconds=$(tmux show -gv @review-timeout 2>/dev/null)
    [[ "$seconds" =~ ^[0-9]+$ ]] || seconds=10
    printf '%s' $((seconds * 10))
}

# The process on the pane's terminal whose argv[0] is NAME, and a variable from
# its environment.
agent_pid() {
    local tty
    tty=$(pane_format '#{pane_tty}')
    ps -t "${tty#/dev/}" -o pid=,args= 2>/dev/null \
        | awk -v name="$1" '{ command = $2; sub(/.*\//, "", command) } command == name { print $1; exit }'
}
agent_env() {
    [[ -n "$1" ]] || return 0
    tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -n 1
}

claude_transcript_view() { tmux capture-pane -p -t "$pane" | tail -n 3 | grep -q 'Showing detailed transcript'; }

claude_transcript() {
    local file="$work/transcript" pid visual was_open=false polls=0 limit
    pid=$(agent_pid claude)
    visual=$(agent_env "$pid" VISUAL)
    claude_transcript_view && was_open=true
    if [[ "${visual##*/}" != compose-editor ]]; then
        # Ctrl+O v would run the editor in Claude's place and stop Claude.
        [[ "$was_open" == true ]] || tmux send-keys -t "$pane" C-o
        message "Claude's VISUAL is not compose-editor, so its own transcript view is open (/ searches)"
        return 1
    fi
    tmux set -p -t "$pane" @review-file "$file"
    [[ "$was_open" == true ]] || tmux send-keys -t "$pane" C-o
    tmux send-keys -t "$pane" v
    limit=$(timeout_tenths)
    while [[ ! -e "$file" ]] && ((polls++ < limit)); do sleep 0.1; done
    tmux set -pu -t "$pane" @review-file
    if [[ ! -e "$file" ]]; then
        message "Claude did not hand over its transcript"
        return 1
    fi
    [[ "$was_open" == true ]] || tmux send-keys -t "$pane" C-o
}

codex_transcript() {
    local home
    home=$(agent_env "$(agent_pid codex)" CODEX_HOME)
    if ! "$(dirname "$self")/codex-transcript" --home "${home:-$HOME/.codex}" \
        --title "$(pane_format '#{pane_title}')" --cwd "$(pane_format '#{pane_current_path}')" \
        > "$work/transcript" 2> "$work/error"; then
        message "$(head -n 1 "$work/error")"
        return 1
    fi
}

opencode_transcript() {
    local dir file _
    dir=$(pane_format '#{pane_current_path}')
    : > "$work/marker"
    tmux send-keys -t "$pane" C-x x BTab Enter
    file=
    for _ in {1..50}; do
        file=$(find "${TMPDIR:-/tmp}" /tmp "$dir" -maxdepth 1 -name 'session-*.md' -newer "$work/marker" \
            -print -quit 2>/dev/null)
        [[ -n "$file" ]] && break
        sleep 0.1
    done
    if [[ -z "$file" ]]; then
        message "OpenCode did not export the session"
        return 1
    fi
    # The notice takes Esc only once it has settled, a moment after it shows;
    # Esc is sent again only while the notice is still there a second later.
    for _ in 1 2 3; do
        notice_shows 20 || break
        sleep 0.3
        tmux send-keys -t "$pane" Escape
        notice_gone 10 && break
    done
    mv -f -- "$file" "$work/transcript"
}

notice_shows() {
    local i
    for ((i = 0; i < $1; i++)); do
        tmux capture-pane -p -t "$pane" | grep -q 'Session exported' && return 0
        sleep 0.1
    done
    return 1
}

notice_gone() {
    local i
    for ((i = 0; i < $1; i++)); do
        tmux capture-pane -p -t "$pane" | grep -q 'Session exported' || return 0
        sleep 0.1
    done
    return 1
}

# Get the agent's conversation into $work/transcript and set its prompt pattern
# and name. Fails with status 2 for a pane that is reviewed in place.
agent_transcript() {
    [[ "$(pane_format '#{alternate_on}')" == 1 ]] || return 2
    case "$(pane_format '#{pane_current_command}')" in
        claude) prompt='^❯ ' label=Claude ;;
        codex) prompt='^## User' label=Codex ;;
        opencode) prompt='^## User' label=OpenCode ;;
        *) return 2 ;;
    esac
    work=$(mktemp -d "${TMPDIR:-/tmp}/tmux-review.XXXXXX") || return 1
    "${label,,}_transcript" && return 0
    rm -rf -- "$work"
    return 1
}

# Show $work/transcript in copy-mode in a review pane zoomed over the agent.
review_pane() {
    local review channel="tmux-review-$$"
    if ! review=$(tmux split-window -Z -t "$pane" -P -F '#{pane_id}' \
        "$(printf '%q ' "$self" show "$work" "$prompt" "$channel")" 2>&1); then
        message "no review pane: $review"
        rm -rf -- "$work"
        return 1
    fi
    tmux set -p -t "$review" @review-pane "$pane"
    tmux set -p -t "$review" @review-zoomed "$zoomed"
    tmux set -p -t "$review" @review-prompt "$prompt"
    tmux select-pane -t "$review" -T "review: $label"
    timeout 10 tmux wait-for "$channel"
    tmux copy-mode -t "$review"
}

review() {
    local zoomed status
    zoomed=$(pane_format '#{window_zoomed_flag}')
    agent_transcript
    status=$?
    if ((status == 2)); then
        tmux copy-mode -t "$pane"
    elif ((status == 0)); then
        review_pane
    else
        return 1
    fi
}

toggle() {
    if pane_in_mode; then
        tmux send-keys -X -t "$pane" cancel
        return
    fi
    review
}

search() {
    pane_in_mode || review || return
    tmux command-prompt ${client:+-t "$client"} -i -T search -p '(search up)' \
        'send -X search-backward-incremental "%%"'
}

# Show FILE read-only in nvim at LINE (empty: the end), then delete it.
popup() {
    local file="$1" line="$2" prompt="${3:-}"
    tmux display-popup -E -w 90% -h 90% ${client:+-c "$client"} -d "$(pane_format '#{pane_current_path}')" \
        "NVIM_REVIEW=1 NVIM_REVIEW_PROMPT=$(printf '%q' "$prompt") nvim -R +$line -- $(printf '%q' "$file"); rm -f -- $(printf '%q' "$file")"
    rm -f -- "$file"
}

edit() {
    local status
    if [[ -n "$(tmux show -pqv -t "$pane" @review-pane)" ]] || pane_in_mode; then
        open_history
        return
    fi
    agent_transcript
    status=$?
    if ((status == 2)); then
        open_history
    elif ((status == 0)); then
        mv -f -- "$work/transcript" "$work.md"
        rmdir -- "$work"
        popup "$work.md" '' "$prompt"
    fi
}

# Open the pane's history in nvim at the line being viewed. -J joins lines that
# only the screen width wrapped, which shifts numbering, so the estimate from
# the copy-mode position is refined to the nearest line holding the cursor's.
open_history() {
    local file line cursor
    file=$(mktemp "${TMPDIR:-/tmp}/tmux-review.XXXXXX") || exit 1
    chmod 600 "$file"
    tmux capture-pane -p -J -S - -E - -t "$pane" > "$file"
    if pane_in_mode; then
        line=$(pane_format '#{e|+:#{e|-:#{history_size},#{scroll_position}},#{e|+:#{copy_cursor_y},1}}')
        cursor=$(pane_format '#{copy_cursor_line}')
    else
        line=$(pane_format '#{e|+:#{history_size},#{e|+:#{cursor_y},1}}')
        cursor=
    fi
    popup "$file" "$(nearest_line "$file" "$line" "$cursor")" "$(tmux show -pqv -t "$pane" @review-prompt)"
}

nearest_line() {
    local file="$1" estimate="$2" text="$3"
    [[ -n "${text//[[:space:]]/}" ]] || { printf '%s\n' "$estimate"; return; }
    TEXT="$text" awk -v estimate="$estimate" '
        index($0, ENVIRON["TEXT"]) {
            distance = NR - estimate
            if (distance < 0) distance = -distance
            if (best == "" || distance < best) { best = distance; found = NR }
        }
        END { print (found ? found : estimate) }
    ' "$file"
}

# PANE is a review pane that left copy-mode: remove it, and give focus (and
# zoom, if the window had it) back to the pane it reviewed.
close() {
    local target zoomed
    target=$(tmux show -pqv -t "$pane" @review-pane)
    zoomed=$(tmux show -pqv -t "$pane" @review-zoomed)
    tmux kill-pane -t "$pane"
    [[ -n "$target" ]] && tmux display-message -p -t "$target" '' >/dev/null 2>&1 || return 0
    tmux select-pane -t "$target"
    [[ "$zoomed" != 1 ]] || tmux resize-pane -Z -t "$target"
}

# The review pane: print the transcript, with control characters (escape
# sequences from tool output) removed and an OSC 133 prompt mark before each
# line matching PROMPT, remove it, and stay until the pane is closed.
show_transcript() {
    local dir="$1" prompt="$2" channel="$3"
    tr -d '\000-\010\013-\037\177' < "$dir/transcript" | LC_ALL=C PROMPT="$prompt" awk '
        ENVIRON["PROMPT"] != "" && $0 ~ ENVIRON["PROMPT"] { printf "\033]133;A\033\\" }
        { print }
    '
    [[ "$dir" == */tmux-review.* ]] && rm -rf -- "$dir"
    tmux wait-for -S "$channel"
    exec sleep infinity
}

case "$action" in
    show) show_transcript "$2" "$3" "$4" ;;
    toggle | search | edit | open | close)
        [[ -n "$pane" ]] || usage
        # Failures have shown their own message; a non-zero status would make
        # run-shell cover the pane with another.
        case "$action" in
            open) open_history ;;
            *) "$action" ;;
        esac
        exit 0
        ;;
    *) usage ;;
esac
