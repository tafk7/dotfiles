#!/bin/bash
# Scoped theme manager for shells, tmux, Neovim, bat, Starship, Delta, btop,
# lazygit, and fzf. Durable state lives under XDG state; rendered artifacts live
# under XDG cache; tmux session/window overrides remain tmux user options.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$SCRIPT_DIR")}"; export DOTFILES_DIR
THEMES_DIR="$DOTFILES_DIR/themes"
GENERATED_DIR="${DOTFILES_THEME_CACHE_DIR:-${DOTFILES_GENERATED_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/theme}}"

source "$DOTFILES_DIR/lib/runtime.sh"
source "$DOTFILES_DIR/lib/theme-resolve.sh"

theme_exists() { [[ -f "$THEMES_DIR/$1/palette.sh" ]]; }

theme_description() {
    local NAME="$1" DESCRIPTION="" meta="$THEMES_DIR/$1/meta.sh"
    [[ -f "$meta" ]] && source "$meta"
    printf '%s - %s\n' "$NAME" "$DESCRIPTION"
}

theme_generation() { date +%s%N; }

write_global_state() {
    local key var value
    local -a fields=(
        default "${DOTFILES_THEME:-$THEME_DEFAULT}"
        previous "${DOTFILES_THEME_PREVIOUS:-}"
        generation "${DOTFILES_THEME_GENERATION:-$(theme_generation)}"
    )
    for key in code chrome apps vim bat delta tmux starship fzf btop lazygit; do
        var="DOTFILES_THEME_${key^^}"
        value="${!var:-}"
        fields+=("$key" "$value")
    done
    theme_state_write_unlocked "${fields[@]}"
}

persist_global_change() {
    DOTFILES_THEME_GENERATION="$(theme_generation)"
    write_global_state
}

theme_feature_enabled() { feature_enabled theme; }

load_palette() {
    local theme="$1"
    theme_exists "$theme" || { error "Theme not found: $theme"; return 1; }
    unset THEME_BG_HEX THEME_FG_HEX THEME_SECONDARY_HEX THEME_SURFACE_HEX \
        THEME_SURFACE_2_HEX THEME_BORDER_HEX THEME_ACCENT_HEX THEME_ACCENT_2_HEX \
        THEME_RED_HEX THEME_YELLOW_HEX THEME_GREEN_HEX THEME_ANSI
    # shellcheck source=/dev/null
    source "$THEMES_DIR/$theme/palette.sh"
}

validate_theme() {
    local theme="$1" file missing=0
    for file in meta.sh palette.sh vim.vim tmux.conf shell.sh colors.sh starship.palette.toml delta.gitconfig btop.theme lazygit.yml; do
        if [[ ! -f "$THEMES_DIR/$theme/$file" ]]; then
            error "$theme is missing $file"
            missing=1
        fi
    done
    [[ $missing -eq 0 ]]
}

# Read `export NAME='value'` (or "value") from a theme's shell.sh.
# Pure bash: the old `grep -oP ... | head -1` was two forks (~8ms here) to pull
# one line out of a small file, and cmd_env calls this on every cold resolve.
extract_export() {
    local theme="$1" name="$2" line value
    local file="$THEMES_DIR/$theme/shell.sh"
    [[ -f "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == "export $name="* ]] || continue
        value="${line#export $name=}"
        # Strip one matching pair of surrounding quotes, then any trailing
        # comment/whitespace the original regex's [^'"]+ would have excluded.
        case "$value" in
            \'*) value="${value#\'}"; value="${value%%\'*}" ;;
            \"*) value="${value#\"}"; value="${value%%\"*}" ;;
            *)   value="${value%%[[:space:]]*}" ;;
        esac
        printf '%s\n' "$value"
        return 0
    done < "$file"
    return 1
}

ensure_theme_artifacts() {
    local theme="$1" dir base source_config config tmp
    dir="$GENERATED_DIR/themes/$theme"
    validate_theme "$theme" >/dev/null
    mkdir -p "$dir"

    base="$DOTFILES_DIR/configs/starship.toml"
    if [[ ! -f "$dir/starship.toml" || "$base" -nt "$dir/starship.toml" ]]; then
        tmp="$(mktemp "$dir/starship.toml.tmp.XXXXXX")"
        sed "s|__DOTFILES_PALETTE__|$theme|g" "$base" > "$tmp"
        mv "$tmp" "$dir/starship.toml"
    fi

    if [[ ! -f "$dir/dotfiles-$theme.theme" ]] || ! cmp -s "$THEMES_DIR/$theme/btop.theme" "$dir/dotfiles-$theme.theme"; then
        cp "$THEMES_DIR/$theme/btop.theme" "$dir/dotfiles-$theme.theme"
    fi
    source_config="${BTOP_BASE_CONFIG:-$HOME/.config/btop/btop.conf}"
    config="$dir/btop.conf"
    # Skip when the output is already newer than its only input — the awk +
    # cmp + rm round trip ran on EVERY resolve (~30ms) just to rewrite a file
    # that hadn't changed. Mirrors the starship.toml mtime check above.
    # The no-source-config branch depends only on $theme, which is baked into
    # the path, so an existing file there is always current.
    if [[ -f "$config" ]] \
       && { [[ ! -f "$source_config" ]] || [[ "$config" -nt "$source_config" ]]; }; then
        return 0
    fi
    if [[ -f "$source_config" ]]; then
        awk -v t="dotfiles-$theme" '
            /^[[:space:]]*color_theme[[:space:]]*=/ { print "color_theme = \"" t "\""; found=1; next }
            { print }
            END { if (!found) print "color_theme = \"" t "\"" }
        ' "$source_config" > "${config}.tmp.$$"
    else
        printf 'color_theme = "dotfiles-%s"\ntheme_background = True\ntruecolor = True\n' "$theme" > "${config}.tmp.$$"
    fi
    if [[ ! -f "$config" ]] || ! cmp -s "${config}.tmp.$$" "$config"; then
        mv "${config}.tmp.$$" "$config"
    else
        # Touch so the mtime gate above sees this run's work next time; without
        # it an unchanged-content run leaves $config older than $source_config
        # forever and the gate never engages.
        touch "$config"
        rm -f "${config}.tmp.$$"
    fi
}

ensure_shared_artifacts() {
    local theme file tmp changed=0
    local -A expected_bat=()
    mkdir -p "$GENERATED_DIR"
    tmp="$(mktemp "${TMPDIR:-/tmp}/dotfiles-delta.XXXXXX")"
    : > "$tmp"
    printf '# Auto-generated; all Delta theme features are included.\n' >> "$tmp"
    for file in "$THEMES_DIR"/*/delta.gitconfig; do
        printf '[include]\n    path = %s\n' "$file" >> "$tmp"
    done
    if [[ ! -f "$GENERATED_DIR/delta.gitconfig" ]] || ! cmp -s "$tmp" "$GENERATED_DIR/delta.gitconfig"; then
        mv "$tmp" "$GENERATED_DIR/delta.gitconfig"
    else
        rm -f "$tmp"
    fi

    # Bat's custom theme cache is shared because it contains every vendored
    # theme and has no active-theme state. Rebuild only when content changes.
    if command -v bat >/dev/null 2>&1; then
        local src="$GENERATED_DIR/bat/source" cache="$GENERATED_DIR/bat/cache"
        mkdir -p "$src/themes" "$cache"
        for file in "$THEMES_DIR"/*/bat/*.tmTheme; do
            [[ -e "$file" ]] || continue
            expected_bat["$(basename "$file")"]=1
            if [[ ! -f "$src/themes/$(basename "$file")" ]] || ! cmp -s "$file" "$src/themes/$(basename "$file")"; then
                cp "$file" "$src/themes/"
                changed=1
            fi
        done
        for file in "$src/themes"/*.tmTheme; do
            [[ -e "$file" ]] || continue
            if [[ -z "${expected_bat[$(basename "$file")]:-}" ]]; then
                rm -f "$file"
                changed=1
            fi
        done
        if [[ $changed -eq 1 || ! -f "$cache/themes.bin" ]]; then
            bat cache --build --source="$src" --target="$cache" >/dev/null
        fi
    fi
}

ensure_all_artifacts() {
    local dir artifact
    ensure_shared_artifacts
    for artifact in "$GENERATED_DIR"/themes/*; do
        [[ -d "$artifact" ]] || continue
        if [[ ! -d "$THEMES_DIR/$(basename "$artifact")" ]]; then
            find "$artifact" -type f -delete
            rmdir "$artifact" 2>/dev/null || true
        fi
    done
    for dir in "$THEMES_DIR"/*; do
        [[ -d "$dir" ]] && ensure_theme_artifacts "$(basename "$dir")"
    done
}

tmux_version_supports_palette() {
    local version
    version="${DOTFILES_TMUX_VERSION:-$(tmux -V 2>/dev/null | awk '{print $2}' | sed 's/[^0-9.].*$//')}"
    [[ -n "$version" ]] && version_gte "$version" 3.3
}

tmux_set_window_palette() {
    local window_id="$1" i
    local -a commands=()
    if tmux_version_supports_palette; then
        for i in "${!THEME_ANSI[@]}"; do
            commands+=(set-option -q -w -t "$window_id" "pane-colours[$i]" "${THEME_ANSI[$i]}" ';')
        done
        commands+=(set-option -q -w -t "$window_id" @dotfiles_theme_palette scoped)
        theme_tmux "${commands[@]}"
    else
        theme_tmux set-option -q -w -t "$window_id" @dotfiles_theme_palette unavailable
    fi
}

tmux_apply_tints() {
    local window_id="$1" pane level tint
    while read -r pane; do
        [[ -n "$pane" ]] || continue
        level="$(theme_tmux show-options -qv -p -t "$pane" @dotfiles_pane_tint 2>/dev/null || true)"
        [[ "$level" =~ ^[123]$ ]] || continue
        tint="THEME_TINT_$level"
        theme_tmux set-option -q -p -t "$pane" window-style "bg=${!tint},fg=$THEME_FG_HEX"
    done < <(theme_tmux list-panes -t "$window_id" -F '#{pane_id}')
}

tmux_apply_window() {
    local window_id="$1" session_id="${2:-}" theme
    local -a commands
    session_id="$(theme_window_owner_session "$window_id" 2>/dev/null || printf '%s' "$session_id")"
    load_theme_context "$session_id" "$window_id"
    theme="$(resolve_surface_theme tmux)"
    load_palette "$theme"

    commands=(
        set-option -q -w -t "$window_id" window-style "bg=$THEME_BG_HEX,fg=$THEME_FG_HEX" ';'
        set-option -q -w -t "$window_id" window-active-style "bg=$THEME_BG_HEX,fg=$THEME_FG_HEX" ';'
        set-option -q -w -t "$window_id" pane-border-style "fg=$THEME_SURFACE_2_HEX" ';'
        set-option -q -w -t "$window_id" pane-active-border-style "fg=$THEME_ACCENT_HEX" ';'
        set-option -q -w -t "$window_id" mode-style "bg=$THEME_SURFACE_2_HEX,fg=$THEME_FG_HEX" ';'
        set-option -q -w -t "$window_id" clock-mode-colour "$THEME_ACCENT_HEX" ';'
        set-option -q -w -t "$window_id" window-status-style "bg=$THEME_BG_HEX,fg=$THEME_SECONDARY_HEX" ';'
        set-option -q -w -t "$window_id" window-status-current-style "bg=$THEME_SURFACE_HEX,fg=$THEME_FG_HEX,bold" ';'
        set-option -q -w -t "$window_id" window-status-activity-style "bg=$THEME_BG_HEX,fg=$THEME_ACCENT_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_effective "$theme" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_bg "$THEME_BG_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_fg "$THEME_FG_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_secondary "$THEME_SECONDARY_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_surface "$THEME_SURFACE_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_border "$THEME_BORDER_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_theme_accent "$THEME_ACCENT_HEX" ';'
        set-option -q -w -t "$window_id" @dotfiles_status_left "#[fg=$THEME_BG_HEX,bg=$THEME_ACCENT_HEX,bold]  #S #[fg=$THEME_ACCENT_HEX,bg=$THEME_BG_HEX]" ';'
        set-option -q -w -t "$window_id" @dotfiles_status_right "#[fg=$THEME_SECONDARY_HEX]#{user}@#h #[fg=$THEME_BORDER_HEX]│ #[fg=$THEME_ACCENT_HEX]%a %b %d #[fg=$THEME_FG_HEX]%H:%M "
    )
    theme_tmux "${commands[@]}"
    tmux_set_window_palette "$window_id"

    # colors.sh remains the pane-tint source of truth.
    source "$THEMES_DIR/$theme/colors.sh"
    tmux_apply_tints "$window_id"
}

tmux_apply_session() {
    local session_id="$1" theme window_id current_window
    local -a commands
    load_theme_context "$session_id" ""
    theme="$(resolve_surface_theme tmux)"
    load_palette "$theme"
    commands=(
        set-option -q -u -t "$session_id" status-style ';'
        set-option -q -t "$session_id" message-style "bg=$THEME_SURFACE_HEX,fg=$THEME_FG_HEX" ';'
        set-option -q -t "$session_id" message-command-style "bg=$THEME_SURFACE_HEX,fg=$THEME_FG_HEX" ';'
        set-option -q -t "$session_id" display-panes-active-colour "$THEME_ACCENT_HEX" ';'
        set-option -q -t "$session_id" display-panes-colour "$THEME_SECONDARY_HEX" ';'
        set-option -q -t "$session_id" @dotfiles_theme_effective "$theme"
    )
    theme_tmux "${commands[@]}"
    while read -r window_id; do
        [[ -n "$window_id" ]] && tmux_apply_window "$window_id" "$session_id"
    done < <(theme_tmux list-windows -t "$session_id" -F '#{window_id}')
    current_window="$(theme_tmux display-message -p -t "$session_id" '#{window_id}')"
    tmux_apply_status "$session_id" "$current_window"
}

tmux_apply_status() {
    local session_id="$1" window_id="$2" theme
    load_theme_context "$session_id" "$window_id"
    theme="$(resolve_surface_theme tmux)"; load_palette "$theme"
    theme_tmux set-option -q -t "$session_id" status-style "bg=$THEME_BG_HEX,fg=$THEME_FG_HEX"
}

tmux_sync_status_for_window() {
    local window_id="$1" session_id current
    while read -r session_id; do
        [[ -n "$session_id" ]] || continue
        current="$(theme_tmux display-message -p -t "$session_id" '#{window_id}')"
        [[ "$current" == "$window_id" ]] && tmux_apply_status "$session_id" "$window_id"
    done < <(theme_window_sessions "$window_id")
    return 0
}

tmux_bump_generation() {
    theme_tmux set-option -q -g @dotfiles_theme_generation "$(theme_generation)"
}

tmux_sync_all() {
    theme_tmux_available || return 0
    local session_id
    while read -r session_id; do
        [[ -n "$session_id" ]] && tmux_apply_session "$session_id"
    done < <(theme_tmux list-sessions -F '#{session_id}')
    tmux_bump_generation
}

tmux_wire() {
    theme_tmux_available || return 0
    local command_path="$DOTFILES_DIR/bin/theme-switcher"
    theme_tmux set-hook -g 'session-created[90]' "run-shell '\"$command_path\" tmux-sync >/dev/null 2>&1'"
    theme_tmux set-hook -g 'after-new-window[90]' "run-shell '\"$command_path\" tmux-sync-window \"#{window_id}\" \"#{session_id}\" >/dev/null 2>&1'"
    theme_tmux set-hook -g 'after-select-window[90]' "run-shell '\"$command_path\" tmux-sync-status \"#{session_id}\" \"#{window_id}\" >/dev/null 2>&1'"
    theme_tmux set-hook -g 'client-session-changed[90]' "run-shell '\"$command_path\" tmux-sync-status \"#{session_id}\" \"#{window_id}\" >/dev/null 2>&1'"
    theme_tmux set-hook -g 'window-linked[90]' "run-shell '\"$command_path\" tmux-sync-window \"#{window_id}\" \"#{session_id}\" >/dev/null 2>&1'"
    theme_tmux set-hook -g 'window-unlinked[90]' "run-shell '\"$command_path\" tmux-sync >/dev/null 2>&1'"
    tmux_sync_all
}

tmux_unwire() {
    theme_tmux_available || return 0
    local hook session_id window_id pane option i
    for hook in session-created after-new-window after-select-window \
        client-session-changed window-linked window-unlinked; do
        theme_tmux set-hook -gu "${hook}[90]" 2>/dev/null || true
    done
    while IFS= read -r session_id; do
        [[ -n "$session_id" ]] || continue
        theme_tmux set-option -q -u -t "$session_id" status-style || true
        theme_tmux set-option -q -u -t "$session_id" message-style || true
        theme_tmux set-option -q -u -t "$session_id" message-command-style || true
        theme_tmux set-option -q -u -t "$session_id" display-panes-active-colour || true
        theme_tmux set-option -q -u -t "$session_id" display-panes-colour || true
        theme_tmux set-option -q -u -t "$session_id" @dotfiles_theme_effective || true
    done < <(theme_tmux list-sessions -F '#{session_id}' 2>/dev/null)
    while IFS= read -r window_id; do
        [[ -n "$window_id" ]] || continue
        for option in window-style window-active-style pane-border-style pane-active-border-style \
            mode-style clock-mode-colour window-status-style window-status-current-style window-status-activity-style \
            @dotfiles_theme_effective @dotfiles_theme_bg @dotfiles_theme_fg @dotfiles_theme_secondary \
            @dotfiles_theme_surface @dotfiles_theme_border @dotfiles_theme_accent @dotfiles_status_left \
            @dotfiles_status_right @dotfiles_theme_palette; do
            theme_tmux set-option -q -u -w -t "$window_id" "$option" 2>/dev/null || true
        done
        for ((i = 0; i < 16; i++)); do
            theme_tmux set-option -q -u -w -t "$window_id" "pane-colours[$i]" 2>/dev/null || true
        done
        while IFS= read -r pane; do
            [[ -n "$pane" ]] || continue
            theme_tmux set-option -q -u -p -t "$pane" window-style 2>/dev/null || true
        done < <(theme_tmux list-panes -t "$window_id" -F '#{pane_id}' 2>/dev/null)
    done < <(theme_tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u)
    theme_tmux set-option -q -g @dotfiles_theme_generation "$(theme_generation)"
}

tmux_configure() {
    if theme_feature_enabled; then tmux_wire; else tmux_unwire; fi
}

tmux_resolve_target() {
    local scope="$1" requested="${2:-}" detected
    theme_tmux_available || { error "No tmux server is available for $scope scope"; return 1; }
    if [[ -n "$requested" ]]; then
        if [[ "$scope" == session && "$requested" =~ ^\$[0-9]+$ ]] \
            || [[ "$scope" == window && "$requested" =~ ^@[0-9]+$ ]]; then
            printf '%s\n' "$requested"
            return
        fi
        error "Use a stable tmux id for explicit targets (session \$N, window @N)"
        return 1
    fi
    [[ -n "${TMUX:-}" ]] || { error "Use --$scope=ID outside tmux"; return 1; }
    detected="$(theme_tmux display-message -p "#{${scope}_id}")"
    printf '%s\n' "$detected"
}

scope_option_set() {
    local scope="$1" id="$2" target="$3" theme="$4" option
    option="$(_theme_tmux_option_name "$target")"
    if [[ "$scope" == window ]]; then
        theme_tmux set-option -q -w -t "$id" "$option" "$theme"
        tmux_apply_window "$id"
        tmux_sync_status_for_window "$id"
    else
        theme_tmux set-option -q -t "$id" "$option" "$theme"
        tmux_apply_session "$id"
    fi
    tmux_bump_generation
}

scope_option_clear() {
    local scope="$1" id="$2" target="$3" option
    option="$(_theme_tmux_option_name "$target")"
    if [[ "$scope" == window ]]; then
        theme_tmux set-option -q -u -w -t "$id" "$option"
        tmux_apply_window "$id"
        tmux_sync_status_for_window "$id"
    else
        theme_tmux set-option -q -u -t "$id" "$option"
        tmux_apply_session "$id"
    fi
    tmux_bump_generation
}

scope_reset() {
    local scope="$1" id="$2" target option
    for target in default code chrome apps vim bat delta tmux starship fzf btop lazygit; do
        option="$(_theme_tmux_option_name "$target")"
        if [[ "$scope" == window ]]; then
            theme_tmux set-option -q -u -w -t "$id" "$option"
        else
            theme_tmux set-option -q -u -t "$id" "$option"
        fi
    done
    if [[ "$scope" == window ]]; then
        tmux_apply_window "$id"
        tmux_sync_status_for_window "$id"
    else
        tmux_apply_session "$id"
    fi
    tmux_bump_generation
}

parse_scope() {
    CMD_SCOPE=global CMD_SCOPE_ID="" CMD_SHIFT=0
    case "${1:-}" in
        --global) CMD_SHIFT=1 ;;
        --session|-s) CMD_SCOPE=session; CMD_SHIFT=1 ;;
        --session=*|-s=*) CMD_SCOPE=session; CMD_SCOPE_ID="${1#*=}"; CMD_SHIFT=1 ;;
        --window|-w) CMD_SCOPE=window; CMD_SHIFT=1 ;;
        --window=*|-w=*) CMD_SCOPE=window; CMD_SCOPE_ID="${1#*=}"; CMD_SHIFT=1 ;;
    esac
}

cmd_set() {
    parse_scope "${1:-}"; shift "$CMD_SHIFT"
    local target="${1:-}" theme="${2:-}" id var
    [[ -n "$target" && -n "$theme" ]] || { error "Usage: theme-switcher set [--global|--session[=\$ID]|--window[=@ID]] <default|group|tool> <theme>"; return 1; }
    is_theme_target "$target" || { error "Unknown target: $target"; return 1; }
    theme_exists "$theme" || { error "Theme not found: $theme"; return 1; }
    ensure_theme_artifacts "$theme"; ensure_shared_artifacts

    if [[ "$CMD_SCOPE" == global ]]; then
        (
            _state_lock_acquire || exit 1
            trap _state_lock_release EXIT INT TERM
            load_global_theme_state
            if [[ "$target" == default ]]; then
                DOTFILES_THEME_PREVIOUS="$DOTFILES_THEME"
                DOTFILES_THEME="$theme"
            else
                var="DOTFILES_THEME_${target^^}"
                printf -v "$var" '%s' "$theme"; export "${var?}"
            fi
            persist_global_change
        )
        tmux_sync_all
    else
        id="$(tmux_resolve_target "$CMD_SCOPE" "$CMD_SCOPE_ID")"
        scope_option_set "$CMD_SCOPE" "$id" "$target" "$theme"
    fi
    success "$CMD_SCOPE ${CMD_SCOPE_ID:+$CMD_SCOPE_ID }$target = $theme"
}

cmd_clear() {
    parse_scope "${1:-}"; shift "$CMD_SHIFT"
    local target="${1:-}" id var
    [[ -n "$target" ]] || { error "Usage: theme-switcher clear [scope] <default|group|tool>"; return 1; }
    is_theme_target "$target" || { error "Unknown target: $target"; return 1; }
    if [[ "$CMD_SCOPE" == global ]]; then
        [[ "$target" != default ]] || { error "The global default cannot be cleared; set it to another theme"; return 1; }
        (
            _state_lock_acquire || exit 1
            trap _state_lock_release EXIT INT TERM
            load_global_theme_state
            var="DOTFILES_THEME_${target^^}"; unset "$var"
            persist_global_change
        )
        tmux_sync_all
    else
        id="$(tmux_resolve_target "$CMD_SCOPE" "$CMD_SCOPE_ID")"
        scope_option_clear "$CMD_SCOPE" "$id" "$target"
    fi
    success "$CMD_SCOPE $target cleared; inheritance restored"
}

cmd_reset() {
    parse_scope "${1:-}"
    local id key var
    if [[ "$CMD_SCOPE" == global ]]; then
        (
            _state_lock_acquire || exit 1
            trap _state_lock_release EXIT INT TERM
            load_global_theme_state
            for key in code chrome apps vim bat delta tmux starship fzf btop lazygit; do
                var="DOTFILES_THEME_${key^^}"; unset "$var"
            done
            persist_global_change
        )
        tmux_sync_all
    else
        id="$(tmux_resolve_target "$CMD_SCOPE" "$CMD_SCOPE_ID")"
        scope_reset "$CMD_SCOPE" "$id"
    fi
    success "$CMD_SCOPE scope reset"
}

context_from_scope_arg() {
    parse_scope "${1:-}"
    local id
    case "$CMD_SCOPE" in
        global) load_theme_context "" "" ;;
        session) id="$(tmux_resolve_target session "$CMD_SCOPE_ID")"; load_theme_context "$id" "" ;;
        window) id="$(tmux_resolve_target window "$CMD_SCOPE_ID")"; load_theme_context "" "$id" ;;
    esac
}

cmd_explain() {
    parse_scope "${1:-}"; shift "$CMD_SHIFT"
    local only="${1:-}" surface theme source
    context_from_scope_arg "${CMD_SCOPE:+--$CMD_SCOPE${CMD_SCOPE_ID:+=$CMD_SCOPE_ID}}"
    printf 'context: global'
    [[ -n "$THEME_CONTEXT_SESSION" ]] && printf ' session=%s' "$THEME_CONTEXT_SESSION"
    [[ -n "$THEME_CONTEXT_WINDOW" ]] && printf ' window=%s' "$THEME_CONTEXT_WINDOW"
    printf '\n'
    if [[ "$THEME_CONTEXT_LINKED_SESSIONS" == *,* ]]; then
        printf 'linked:  %s (inheritance owner %s)\n' "$THEME_CONTEXT_LINKED_SESSIONS" "$THEME_CONTEXT_SESSION"
    fi
    while read -r surface; do
        [[ -z "$only" || "$only" == "$surface" ]] || continue
        theme="$(resolve_surface_theme "$surface")"
        source="$(resolve_surface_source "$surface")"
        printf '%-9s %-20s %s\n' "$surface" "$theme" "$source"
    done < <(list_all_surfaces)
}

cmd_show() {
    parse_scope "${1:-}"
    context_from_scope_arg "${CMD_SCOPE:+--$CMD_SCOPE${CMD_SCOPE_ID:+=$CMD_SCOPE_ID}}"
    printf 'global default: %s\n' "$DOTFILES_THEME"
    [[ -n "$THEME_CONTEXT_SESSION" ]] && printf 'session: %s  default: %s\n' "$THEME_CONTEXT_SESSION" "${DOTFILES_THEME_SESSION:-(inherit)}"
    [[ -n "$THEME_CONTEXT_WINDOW" ]] && printf 'window:  %s  default: %s\n' "$THEME_CONTEXT_WINDOW" "${DOTFILES_THEME_WINDOW:-(inherit)}"
    echo
    cmd_explain "${CMD_SCOPE:+--$CMD_SCOPE${CMD_SCOPE_ID:+=$CMD_SCOPE_ID}}"
}

shell_quote_export() { printf 'export %s=%q\n' "$1" "$2"; }

cmd_env() {
    theme_feature_enabled || return 0
    local explicit=0 old_signature surface theme native tmux_gen signature fzf_theme detected
    local det_session det_window det_rest
    local -A prepared=()
    case "${1:-}" in --global|--session|--session=*|-s|-s=*|--window|--window=*|-w|-w=*) explicit=1 ;; esac
    if [[ $explicit -eq 1 ]]; then
        parse_scope "$1"; shift
        case "$CMD_SCOPE" in
            global) load_theme_context "" "" ;;
            session) load_theme_context "$(tmux_resolve_target session "$CMD_SCOPE_ID")" "" ;;
            window) load_theme_context "" "$(tmux_resolve_target window "$CMD_SCOPE_ID")" ;;
        esac
    else
        old_signature="${1:-}"
        load_global_theme_state
        det_session=""; det_window=""
        if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
            detected="$(theme_tmux display-message -p '#{session_id} #{window_id} #{@dotfiles_theme_generation}' 2>/dev/null || true)"
            if [[ -n "$detected" ]]; then
                # Parse non-destructively so the ids can be reused below.
                # Field order is: session_id window_id generation.
                det_session="${detected%% *}"
                det_rest="${detected#* }"
                det_window="${det_rest%% *}"
                signature="${DOTFILES_THEME_GENERATION}:${detected##* }:${det_session}:${det_window}"
                [[ -n "$old_signature" && "$old_signature" == "$signature" ]] && return 0
                # A server answered, so skip the `list-sessions` probe that
                # theme_tmux_available would otherwise fork inside detection.
                _THEME_TMUX_AVAILABLE=yes
            fi
        elif [[ -n "$old_signature" && "$old_signature" == "${DOTFILES_THEME_GENERATION}:::" ]]; then
            return 0
        fi
        # Feed the ids we already have to the context loader instead of letting
        # theme_detect_context re-issue the identical `display-message`. Falls
        # back to self-detection when the query above found nothing.
        load_theme_context "$det_session" "$det_window"
    fi
    [[ $explicit -eq 1 ]] && old_signature="${1:-}"
    tmux_gen=""
    theme_tmux_available && tmux_gen="$(theme_tmux show-options -gqv @dotfiles_theme_generation 2>/dev/null || true)"
    signature="${DOTFILES_THEME_GENERATION}:${tmux_gen}:${THEME_CONTEXT_SESSION}:${THEME_CONTEXT_WINDOW}"
    [[ -n "$old_signature" && "$old_signature" == "$signature" ]] && return 0

    shell_quote_export DOTFILES_THEME "$DOTFILES_THEME"
    shell_quote_export DOTFILES_THEME_CONTEXT_SIGNATURE "$signature"
    shell_quote_export DOTFILES_THEME_SESSION_ID "$THEME_CONTEXT_SESSION"
    shell_quote_export DOTFILES_THEME_WINDOW_ID "$THEME_CONTEXT_WINDOW"
    # Hot path: use the fork-free `_into` resolver. `$(resolve_surface_theme)`
    # here cost ~15 subshells per call, and cmd_env runs on every shell start
    # and every prompt refresh.
    for surface in $(list_all_surfaces); do
        resolve_surface_theme_into "$surface"; theme="$_THEME_REPLY"
        shell_quote_export "DOTFILES_THEME_${surface^^}_RESOLVED" "$theme"
        if [[ -z "${prepared[$theme]:-}" ]]; then
            ensure_theme_artifacts "$theme"
            prepared[$theme]=1
        fi
    done

    resolve_surface_theme_into bat; theme="$_THEME_REPLY"
    native="$(extract_export "$theme" BAT_THEME || true)"
    shell_quote_export BAT_THEME "${native:-$theme}"
    shell_quote_export BAT_CACHE_PATH "$GENERATED_DIR/bat/cache"
    resolve_surface_theme_into starship; theme="$_THEME_REPLY"
    shell_quote_export STARSHIP_CONFIG "$GENERATED_DIR/themes/$theme/starship.toml"
    native="$(extract_export "$theme" STARSHIP_PALETTE || true)"; shell_quote_export STARSHIP_PALETTE "${native:-$theme}"
    resolve_surface_theme_into delta; theme="$_THEME_REPLY"; shell_quote_export DELTA_FEATURES "$theme"; shell_quote_export DELTA_FEATURE "$theme"
    resolve_surface_theme_into btop; theme="$_THEME_REPLY"; shell_quote_export BTOP_THEME_CONFIG "$GENERATED_DIR/themes/$theme/btop.conf"; shell_quote_export BTOP_THEME_DIR "$GENERATED_DIR/themes/$theme"
    resolve_surface_theme_into lazygit; theme="$_THEME_REPLY"; shell_quote_export LAZYGIT_THEME_CONFIG "$THEMES_DIR/$theme/lazygit.yml"

    resolve_surface_theme_into fzf; theme="$_THEME_REPLY"; load_palette "$theme"
    fzf_theme="--color=bg+:$THEME_SURFACE_HEX,bg:$THEME_BG_HEX,spinner:$THEME_ACCENT_2_HEX,hl:$THEME_ACCENT_HEX --color=fg:$THEME_FG_HEX,header:$THEME_SECONDARY_HEX,info:$THEME_SECONDARY_HEX,pointer:$THEME_ACCENT_2_HEX --color=marker:$THEME_GREEN_HEX,fg+:$THEME_FG_HEX,prompt:$THEME_ACCENT_HEX,hl+:$THEME_ACCENT_HEX"
    shell_quote_export FZF_THEME_COLORS "$fzf_theme"

    resolve_surface_theme_into tmux; theme="$_THEME_REPLY"; load_palette "$theme"; source "$THEMES_DIR/$theme/colors.sh"
    shell_quote_export THEME_TINT_1 "$THEME_TINT_1"
    shell_quote_export THEME_TINT_2 "$THEME_TINT_2"
    shell_quote_export THEME_TINT_3 "$THEME_TINT_3"
}

cmd_resolve() {
    local surface="${1:?tool required}"; shift
    case "${1:-}" in
        --global) load_theme_context "" "" ;;
        --session|--session=*|-s|-s=*) parse_scope "$1"; load_theme_context "$(tmux_resolve_target session "$CMD_SCOPE_ID")" "" ;;
        --window|--window=*|-w|-w=*) parse_scope "$1"; load_theme_context "" "$(tmux_resolve_target window "$CMD_SCOPE_ID")" ;;
        *) load_theme_context ;;
    esac
    resolve_surface_theme "$surface"
}

cmd_palette() {
    local theme="${1:-}" key="${2:-}"
    load_palette "$theme"
    if [[ -n "$key" ]]; then
        local var
        var="THEME_${key^^}_HEX"
        printf '%s\n' "${!var:-}"
    else
        printf 'bg=%s\nfg=%s\nsecondary=%s\nsurface=%s\nborder=%s\naccent=%s\naccent2=%s\nred=%s\nyellow=%s\ngreen=%s\n' \
            "$THEME_BG_HEX" "$THEME_FG_HEX" "$THEME_SECONDARY_HEX" "$THEME_SURFACE_HEX" "$THEME_BORDER_HEX" \
            "$THEME_ACCENT_HEX" "$THEME_ACCENT_2_HEX" "$THEME_RED_HEX" "$THEME_YELLOW_HEX" "$THEME_GREEN_HEX"
    fi
}

cmd_tint() {
    local level="${1:-}" pane="${2:-${TMUX_PANE:-}}" theme tint
    [[ -n "$pane" ]] || { error "pane-tint requires a tmux pane"; return 1; }
    if [[ "$level" == 0 || "$level" == reset ]]; then
        theme_tmux set-option -q -u -p -t "$pane" @dotfiles_pane_tint
        theme_tmux set-option -q -u -p -t "$pane" window-style
        return
    fi
    [[ "$level" =~ ^[123]$ ]] || { error "Tint must be 0, 1, 2, or 3"; return 1; }
    load_theme_context "" "$(theme_tmux display-message -p -t "$pane" '#{window_id}')"
    theme="$(resolve_surface_theme tmux)"; load_palette "$theme"; source "$THEMES_DIR/$theme/colors.sh"
    tint="THEME_TINT_$level"
    theme_tmux set-option -q -p -t "$pane" @dotfiles_pane_tint "$level"
    theme_tmux set-option -q -p -t "$pane" window-style "bg=${!tint},fg=$THEME_FG_HEX"
}

preview_rgb() {
    local hex="$1"
    printf '%d;%d;%d' "$((16#${hex:1:2}))" "$((16#${hex:3:2}))" "$((16#${hex:5:2}))"
}

preview_fg() {
    local hex="$1" text="$2"
    printf '\033[38;2;%sm%s\033[0m' "$(preview_rgb "$hex")" "$text"
}

preview_chip() {
    local hex="$1" label="$2"
    printf '\033[48;2;%sm\033[38;2;%sm %-10s \033[0m' \
        "$(preview_rgb "$hex")" "$(preview_rgb "$THEME_FG_HEX")" "$label"
}

preview_cpp() {
    local theme="$1" width="$2" bat_theme snippet
    snippet=$'#include <optional>\n#include <string_view>\n\nstruct ThemeContext {\n    std::string_view session;\n    std::string_view window;\n};\n\n[[nodiscard]] auto resolve_theme(const ThemeContext& ctx)\n    -> std::optional<std::string_view> {\n    if (!ctx.window.empty()) return "window override";\n    if (!ctx.session.empty()) return "session default";\n    return "global default";\n}\n\nint main() {\n    const ThemeContext context{"work", "editor"};\n    return resolve_theme(context).has_value() ? 0 : 1;\n}'
    bat_theme="$(extract_export "$theme" BAT_THEME || true)"
    if command -v bat >/dev/null 2>&1 && [[ -n "$bat_theme" ]]; then
        BAT_CACHE_PATH="$GENERATED_DIR/bat/cache" bat \
            --color=always --paging=never --style=numbers \
            --terminal-width="$width" --language=cpp --theme="$bat_theme" \
            <<< "$snippet" 2>/dev/null || printf '%s\n' "$snippet"
    else
        printf '%s\n' "$snippet"
    fi
}

paint_preview_pane() {
    local height="$1" bg_rgb fg_rgb
    bg_rgb="$(preview_rgb "$THEME_BG_HEX")"
    fg_rgb="$(preview_rgb "$THEME_FG_HEX")"
    awk -v bg="$bg_rgb" -v fg="$fg_rgb" -v height="$height" '
        BEGIN {
            paint = sprintf("\033[48;2;%sm\033[38;2;%sm", bg, fg)
            reset = "\033[0m"
        }
        NR <= height {
            gsub(/\033\[0m/, reset paint, $0)
            printf "%s%s\033[K\033[0m\n", paint, $0
        }
        END {
            for (line = NR + 1; line <= height; line++)
                printf "%s\033[K\033[0m\n", paint
        }
    '
}

preview_theme() {
    local theme="$1" width="${FZF_PREVIEW_COLUMNS:-72}" height="${FZF_PREVIEW_LINES:-36}" i
    [[ "$width" =~ ^[0-9]+$ ]] || width=72
    [[ "$height" =~ ^[0-9]+$ ]] || height=36
    (( width < 36 )) && width=36
    (( height < 12 )) && height=12
    load_palette "$theme"
    [[ -f "$GENERATED_DIR/bat/cache/themes.bin" ]] || ensure_shared_artifacts

    {
        printf '\033[1m%s\033[0m\n' "$(theme_description "$theme")"
        printf 'canvas  %s  text  %s  secondary  %s\n' \
            "$(preview_chip "$THEME_BG_HEX" bg)" \
            "$(preview_fg "$THEME_FG_HEX" foreground)" \
            "$(preview_fg "$THEME_SECONDARY_HEX" information)"
        printf 'accent  %s  alternate  %s\n' \
            "$(preview_fg "$THEME_ACCENT_HEX" primary)" \
            "$(preview_fg "$THEME_ACCENT_2_HEX" secondary)"
        printf 'states  \033[48;2;%sm\033[38;2;%sm selected \033[0m  ' \
            "$(preview_rgb "$THEME_SURFACE_HEX")" "$(preview_rgb "$THEME_FG_HEX")"
        printf '\033[48;2;%sm\033[38;2;%sm search \033[0m  ' \
            "$(preview_rgb "$THEME_YELLOW_HEX")" "$(preview_rgb "$THEME_BG_HEX")"
        printf '%s  %s\n' "$(preview_fg "$THEME_GREEN_HEX" '+ added')" "$(preview_fg "$THEME_RED_HEX" '- removed')"
        printf '\nANSI palette\n'
        for i in "${!THEME_ANSI[@]}"; do
            printf '\033[38;2;%sm%02d██\033[0m ' "$(preview_rgb "${THEME_ANSI[$i]}")" "$i"
            (( i == 7 )) && printf '\n'
        done
        printf '\n\nC++ · bat theme: %s\n' "$(extract_export "$theme" BAT_THEME || printf '%s' "$theme")"
        preview_cpp "$theme" "$width"
        printf '\nEnter applies this theme; Esc cancels.\n'
    } | paint_preview_pane "$height"
}

cmd_diagnose() {
    local i
    load_theme_context
    printf 'Context: session=%s window=%s tmux=%s\n' "${THEME_CONTEXT_SESSION:-standalone}" "${THEME_CONTEXT_WINDOW:-standalone}" "$(resolve_surface_theme tmux)"
    printf 'Default foreground/background sample\nANSI: '
    for i in {0..7}; do printf '\033[3%sm %s \033[0m' "$i" "$i"; done
    printf '\nBright: '
    for i in {0..7}; do printf '\033[9%sm %s \033[0m' "$i" "$((i+8))"; done
    printf '\nTruecolor: \033[38;2;120;170;255mblue\033[0m \033[38;2;220;90;100mred\033[0m\n'
    if [[ -n "$THEME_CONTEXT_WINDOW" ]]; then
        printf 'tmux palette: %s\n' "$(theme_tmux show-options -qv -w -t "$THEME_CONTEXT_WINDOW" @dotfiles_theme_palette 2>/dev/null || echo unknown)"
    else
        printf 'tmux palette: unavailable outside tmux; terminal palette controls ANSI colors\n'
    fi
}

list_themes() {
    local current dir theme
    load_global_theme_state; current="$DOTFILES_THEME"
    for dir in "$THEMES_DIR"/*; do
        [[ -d "$dir" ]] || continue; theme="$(basename "$dir")"
        printf '%s %-20s %s\n' "$([[ "$theme" == "$current" ]] && echo '*' || echo ' ')" "$theme" "$(theme_description "$theme")"
    done | sort
}

interactive_select() {
    local scope_arg="${1:---global}" target="${2:-default}" selected current dir name description marker
    command -v fzf >/dev/null 2>&1 || { error "fzf is required"; return 1; }
    is_theme_target "$target" || { error "Unknown target: $target"; return 1; }
    load_global_theme_state; current="$DOTFILES_THEME"
    selected="$({
        for dir in "$THEMES_DIR"/*; do
            [[ -d "$dir" ]] || continue
            name="$(basename "$dir")"
            description="$(theme_description "$name")"
            marker=' '
            [[ "$scope_arg" == --global && "$name" == "$current" ]] && marker='*'
            printf '%s\t%s\t%s\n' "$name" "$marker" "$description"
        done
    } | sort | fzf --delimiter=$'\t' --with-nth=2,1,3 \
        --preview "$0 --preview {1}" \
        --preview-window=right:55%:wrap \
        --header "enter: set ${scope_arg#--} $target • esc: cancel" \
        | cut -f1)"
    [[ -n "$selected" ]] && cmd_set "$scope_arg" "$target" "$selected"
}

show_help() {
    cat <<'EOF'
Theme Switcher — global, tmux session, and tmux window theme scopes

  theme-switcher THEME
  theme-switcher [--global|--session[=$ID]|-s[=$ID]|--window[=@ID]|-w[=@ID]] [TARGET]
  theme-switcher set [--global|--session[=$ID]|-s[=$ID]|--window[=@ID]|-w[=@ID]] TARGET THEME
  theme-switcher clear [scope] TARGET       # `unset` remains an alias
  theme-switcher reset [scope]
  theme-switcher show [scope]
  theme-switcher explain [scope] [TOOL]
  theme-switcher diagnose
  theme-switcher enable | disable
  theme-switcher --list | --current | --preview THEME | --revert | --init

TARGET is default, code, chrome, apps, vim, bat, delta, tmux, starship, fzf,
btop, or lazygit. Bare set/clear/reset retain the historical global behavior.
Explicit tmux targets use stable ids such as --session=$N and --window=@N.
EOF
}

main() {
    case "${1:-}" in
        set) shift; cmd_set "$@" ;;
        clear|unset) shift; cmd_clear "$@" ;;
        reset) shift; cmd_reset "$@" ;;
        show) shift; cmd_show "$@" ;;
        explain) shift; cmd_explain "$@" ;;
        env) shift; cmd_env "$@" ;;
        resolve) shift; cmd_resolve "$@" ;;
        palette) shift; cmd_palette "$@" ;;
        prepare) shift; ensure_theme_artifacts "${1:?theme required}" ;;
        artifacts) ensure_all_artifacts ;;
        tint) shift; cmd_tint "$@" ;;
        diagnose) cmd_diagnose ;;
        enabled) theme_feature_enabled ;;
        enable)
            preference_set feature.theme enabled
            "$0" --init
            ;;
        disable)
            preference_set feature.theme disabled
            tmux_unwire
            success "Theme feature disabled; existing overrides were preserved."
            ;;
        tmux-configure) tmux_configure ;;
        tmux-unwire) tmux_unwire ;;
        tmux-sync) tmux_sync_all ;;
        tmux-sync-window) shift; tmux_apply_window "${1:?window id required}" "${2:-}"; tmux_sync_status_for_window "$1"; tmux_bump_generation ;;
        tmux-sync-status) shift; tmux_apply_status "${1:?session id required}" "${2:?window id required}" ;;
        --init)
            theme_feature_enabled || return 0
            if [[ ! -f "$DOTFILES_THEME_STATE_FILE" ]] \
               || ! _state_validate_file "$DOTFILES_THEME_STATE_FILE" theme 2 2>/dev/null; then
                (
                    _state_lock_acquire || exit 1
                    trap _state_lock_release EXIT INT TERM
                    load_global_theme_state
                    DOTFILES_THEME_GENERATION="$(theme_generation)"
                    write_global_state
                )
            fi
            ensure_all_artifacts
            tmux_wire
            ;;
        --list|-l) list_themes ;;
        --current|-c) load_global_theme_state; printf 'Current theme: %s\n' "$DOTFILES_THEME" ;;
        --preview|-p) preview_theme "${2:?theme required}" ;;
        --revert|-r)
            load_global_theme_state
            [[ -n "$DOTFILES_THEME_PREVIOUS" ]] || { error "No previous global theme"; return 1; }
            cmd_set --global default "$DOTFILES_THEME_PREVIOUS"
            ;;
        --global|--session|--session=*|-s|-s=*|--window|--window=*|-w|-w=*) interactive_select "$@" ;;
        --help|-h) show_help ;;
        '') interactive_select ;;
        *) cmd_set --global default "$1" ;;
    esac
}

main "$@"
