#!/bin/bash
# Theme switcher. A theme is a set of tmux options: @theme_* colors that the
# styles in configs/tmux.conf reference, plus pane-colours[] entries that remap
# the colors programs inside a pane ask for. The global theme is set on global
# window options and persisted; `-w` sets the same options on one window, which
# overrides the global theme for that window only. tmux inheritance does the
# rest: new windows, splits, and running programs follow without hooks or
# per-shell state.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$SCRIPT_DIR")}"; export DOTFILES_DIR
THEMES_DIR="$DOTFILES_DIR/themes"
THEME_DEFAULT=gruvbox

source "$DOTFILES_DIR/lib/runtime.sh"
source "$DOTFILES_DIR/lib/state.sh"

# Palette slots beyond ANSI 0-15. Programs name a role by its 256-color index
# (configs/nvim/colors/dotfiles.vim, shell/fzf.sh, configs/gitconfig,
# configs/starship.toml) and tmux maps the index to the window's theme. Each
# index's xterm default is close to its role on a dark terminal, so output stays
# sensible where no theme applies.
SLOT_SURFACE=235
SLOT_SURFACE_2=238
SLOT_BORDER=240
SLOT_SECONDARY=245
SLOT_ADD=22
SLOT_DELETE=52
SLOT_ADD_EMPH=28
SLOT_DELETE_EMPH=88

# Every theme-owned option, for window clears and feature disable.
THEME_OPTIONS=(@theme @theme_bg @theme_fg @theme_secondary @theme_surface @theme_surface_2
    @theme_border @theme_accent @theme_accent_2 @theme_tint_1 @theme_tint_2 @theme_tint_3)

theme_tmux() {
    if [[ -n "${DOTFILES_TMUX_SERVER:-}" ]]; then
        command tmux -L "$DOTFILES_TMUX_SERVER" "$@"
    else
        command tmux "$@"
    fi
}

tmux_running() { command -v tmux >/dev/null 2>&1 && theme_tmux list-sessions >/dev/null 2>&1; }

tmux_has_palette() {
    local version
    version="${DOTFILES_TMUX_VERSION:-$(tmux -V 2>/dev/null | awk '{print $2}' | sed 's/[^0-9.].*$//')}"
    [[ -n "$version" ]] && version_gte "$version" 3.3
}

theme_exists() { [[ "$1" =~ ^[a-z0-9-]+$ && -f "$THEMES_DIR/$1.sh" ]]; }

load_palette() {
    theme_exists "$1" || { error "Theme not found: $1"; return 1; }
    unset NAME DESCRIPTION THEME_ANSI
    # shellcheck source=/dev/null
    source "$THEMES_DIR/$1.sh"
}

global_theme() {
    local theme
    theme="$(theme_state_value default 2>/dev/null || true)"
    theme_exists "$theme" && printf '%s\n' "$theme" || printf '%s\n' "$THEME_DEFAULT"
}

# Mix two #rrggbb colors; the third argument is the percentage of the first.
blend() {
    local a="$1" b="$2" pct="$3" i out="#"
    for i in 1 3 5; do
        out+="$(printf '%02x' $(( (16#${a:i:2} * pct + 16#${b:i:2} * (100 - pct)) / 100 )))"
    done
    printf '%s\n' "$out"
}

# Print the tmux option assignments for THEME as "option<TAB>value" lines.
theme_assignments() {
    local theme="$1" i
    load_palette "$theme"
    printf '%s\t%s\n' \
        @theme "$theme" \
        @theme_bg "$THEME_BG_HEX" @theme_fg "$THEME_FG_HEX" \
        @theme_secondary "$THEME_SECONDARY_HEX" @theme_surface "$THEME_SURFACE_HEX" \
        @theme_surface_2 "$THEME_SURFACE_2_HEX" @theme_border "$THEME_BORDER_HEX" \
        @theme_accent "$THEME_ACCENT_HEX" @theme_accent_2 "$THEME_ACCENT_2_HEX" \
        @theme_tint_1 "$THEME_TINT_1" @theme_tint_2 "$THEME_TINT_2" @theme_tint_3 "$THEME_TINT_3"
    tmux_has_palette || return 0
    for i in "${!THEME_ANSI[@]}"; do
        printf 'pane-colours[%s]\t%s\n' "$i" "${THEME_ANSI[$i]}"
    done
    printf 'pane-colours[%s]\t%s\n' \
        "$SLOT_SURFACE" "$THEME_SURFACE_HEX" \
        "$SLOT_SURFACE_2" "$THEME_SURFACE_2_HEX" \
        "$SLOT_BORDER" "$THEME_BORDER_HEX" \
        "$SLOT_SECONDARY" "$THEME_SECONDARY_HEX" \
        "$SLOT_ADD" "$(blend "$THEME_GREEN_HEX" "$THEME_BG_HEX" 14)" \
        "$SLOT_DELETE" "$(blend "$THEME_RED_HEX" "$THEME_BG_HEX" 14)" \
        "$SLOT_ADD_EMPH" "$(blend "$THEME_GREEN_HEX" "$THEME_BG_HEX" 24)" \
        "$SLOT_DELETE_EMPH" "$(blend "$THEME_RED_HEX" "$THEME_BG_HEX" 24)"
}

# Apply THEME to a scope: "global" or a window id such as @3. Clearing first
# keeps pane-colours exact when switching between themes.
tmux_apply() {
    local scope="$1" theme="$2" option value
    local -a flags commands=()
    [[ "$scope" == global ]] && flags=(-gw) || flags=(-w -t "$scope")
    commands=(set-option -q -u "${flags[@]}" pane-colours ';')
    while IFS=$'\t' read -r option value; do
        commands+=(set-option -q "${flags[@]}" "$option" "$value" ';')
    done < <(theme_assignments "$theme")
    theme_tmux "${commands[@]}"
}

tmux_clear_window() {
    local window="$1" option
    local -a commands=(set-option -q -u -w -t "$window" pane-colours)
    for option in "${THEME_OPTIONS[@]}"; do
        commands+=(';' set-option -q -u -w -t "$window" "$option")
    done
    theme_tmux "${commands[@]}"
}

# With the feature off, the styles in tmux.conf resolve to terminal defaults.
tmux_off() {
    tmux_running || return 0
    local option window
    local -a commands=(set-option -q -u -gw pane-colours ';' set-option -q -gw @theme off)
    for option in "${THEME_OPTIONS[@]:1}"; do
        commands+=(';' set-option -q -gw "$option" default)
    done
    theme_tmux "${commands[@]}"
    while IFS= read -r window; do
        [[ -n "$window" ]] && tmux_clear_window "$window"
    done < <(theme_tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u)
}

tmux_init() {
    tmux_running || return 0
    if feature_enabled theme; then tmux_apply global "$(global_theme)"; else tmux_off; fi
}

# The window this command runs in, or an explicit @N.
current_window() {
    local requested="${1:-}"
    if [[ -n "$requested" ]]; then
        [[ "$requested" =~ ^@[0-9]+$ ]] || { error "Window ids look like @3: $requested"; return 1; }
        theme_tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -Fxq -- "$requested" \
            || { error "No tmux window $requested"; return 1; }
        printf '%s\n' "$requested"
        return
    fi
    [[ -n "${TMUX:-}" || -n "${DOTFILES_TMUX_SERVER:-}" ]] || { error "Not in tmux; pass --window=@N"; return 1; }
    theme_tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}'
}

require_enabled() {
    feature_enabled theme && return 0
    error "The theme feature is disabled (enable with: dotfiles-feature enable theme)"
    return 1
}

set_global() {
    local theme="$1" previous
    require_enabled
    theme_exists "$theme" || { error "Theme not found: $theme"; return 1; }
    previous="$(global_theme)"
    [[ "$previous" == "$theme" ]] || theme_state_write default "$theme" previous "$previous"
    tmux_running && tmux_apply global "$theme"
    success "Global theme: $theme"
}

set_window() {
    local window="$1" theme="$2"
    require_enabled
    if [[ "$theme" == clear ]]; then
        tmux_clear_window "$window"
        success "Window $window follows the global theme ($(global_theme))"
        return
    fi
    theme_exists "$theme" || { error "Theme not found: $theme"; return 1; }
    tmux_apply "$window" "$theme"
    success "Window $window theme: $theme"
}

cmd_tint() {
    local level="${1:-}" pane="${2:-${TMUX_PANE:-}}" style
    [[ -n "$pane" ]] || { error "pane-tint requires a tmux pane"; return 1; }
    case "$level" in
        0|reset)
            theme_tmux set-option -q -u -p -t "$pane" window-style ';' \
                set-option -q -u -p -t "$pane" window-active-style
            ;;
        1|2|3)
            # A format, not a color: the tint follows later theme changes.
            style="bg=#{@theme_tint_$level},fg=#{@theme_fg}"
            theme_tmux set-option -q -p -t "$pane" window-style "$style" ';' \
                set-option -q -p -t "$pane" window-active-style "$style"
            ;;
        *) error "Tint must be 0, 1, 2, or 3"; return 1 ;;
    esac
}

show_current() {
    local window theme
    printf 'global: %s\n' "$(global_theme)"
    if [[ -n "${TMUX:-}" ]] && window="$(current_window 2>/dev/null)"; then
        theme="$(theme_tmux show-options -qv -w -t "$window" @theme 2>/dev/null || true)"
        printf 'window %s: %s\n' "$window" "${theme:-follows global}"
    fi
}

list_themes() {
    local file theme current
    current="$(global_theme)"
    for file in "$THEMES_DIR"/*.sh; do
        [[ -f "$file" ]] || continue
        theme="$(basename "$file" .sh)"
        load_palette "$theme"
        printf '%s\t%s\t%s - %s\n' "$theme" "$([[ "$theme" == "$current" ]] && echo '*' || echo ' ')" "$NAME" "$DESCRIPTION"
    done
}

rgb() { printf '%d;%d;%d' "$((16#${1:1:2}))" "$((16#${1:3:2}))" "$((16#${1:5:2}))"; }

# Paint a card on the theme's own canvas; default-color resets (39/49) return
# to the theme's foreground and background rather than the terminal's.
preview_theme() {
    local theme="$1" i
    load_palette "$theme"
    {
        printf '\033[1m%s\033[22m — %s\n\n' "$NAME" "$DESCRIPTION"
        printf 'text  \033[38;2;%smsecondary\033[39m  \033[38;2;%smaccent\033[39m  \033[38;2;%smaccent 2\033[39m\n' \
            "$(rgb "$THEME_SECONDARY_HEX")" "$(rgb "$THEME_ACCENT_HEX")" "$(rgb "$THEME_ACCENT_2_HEX")"
        printf '\033[48;2;%sm selected \033[49m  \033[48;2;%sm selection \033[49m  \033[38;2;%sm+ added\033[39m  \033[38;2;%sm- removed\033[39m\n\n' \
            "$(rgb "$THEME_SURFACE_HEX")" "$(rgb "$THEME_SURFACE_2_HEX")" \
            "$(rgb "$THEME_GREEN_HEX")" "$(rgb "$THEME_RED_HEX")"
        for i in "${!THEME_ANSI[@]}"; do
            printf '\033[38;2;%sm%02d ██\033[39m ' "$(rgb "${THEME_ANSI[$i]}")" "$i"
            (( i == 7 )) && printf '\n'
        done
        printf '\n\nEnter applies; Esc cancels.\n'
    } | awk -v bg="$(printf '\033[48;2;%sm' "$(rgb "$THEME_BG_HEX")")" \
            -v fg="$(printf '\033[38;2;%sm' "$(rgb "$THEME_FG_HEX")")" '{
        gsub(/\033\[39m/, fg); gsub(/\033\[49m/, bg)
        printf "%s%s%s\033[K\033[0m\n", bg, fg, $0
    }'
}

pick() {
    command -v fzf >/dev/null 2>&1 || { error "fzf is required for the picker"; return 1; }
    list_themes | fzf --delimiter=$'\t' --with-nth=2,1,3 --no-sort \
        --preview "'$0' --preview {1}" --preview-window=right:55%:wrap \
        --header "enter: set $1 theme • esc: cancel" | cut -f1 || true
}

cmd_diagnose() {
    local i
    show_current
    printf 'tmux palette: %s\n' "$(tmux_has_palette && echo 'pane-colours (tmux 3.3+)' || echo 'unavailable; the terminal palette applies')"
    printf 'ANSI:  '; for i in {0..7}; do printf '\033[3%sm %s \033[0m' "$i" "$i"; done
    printf '\nBright:'; for i in {0..7}; do printf '\033[9%sm %s \033[0m' "$i" "$((i + 8))"; done
    printf '\nRoles: \033[48;5;%smsurface\033[0m \033[48;5;%smselection\033[0m \033[38;5;%smsecondary\033[0m \033[48;5;%sm+add\033[0m \033[48;5;%sm-delete\033[0m\n' \
        "$SLOT_SURFACE" "$SLOT_SURFACE_2" "$SLOT_SECONDARY" "$SLOT_ADD" "$SLOT_DELETE"
}

show_help() {
    cat <<'EOF'
theme-switcher — one global theme, optionally overridden per tmux window

  theme-switcher                   pick the global theme
  theme-switcher NAME              set the global theme (persists)
  theme-switcher -w [NAME]         pick or set this window's theme
  theme-switcher -w clear          make this window follow the global theme again
  theme-switcher --window=@N NAME  target another window by id
  theme-switcher --list | --current | --revert | --preview NAME | diagnose
  theme-switcher enable | disable

Window themes live on the tmux window and end with it.
EOF
}

main() {
    local window name
    case "${1:-}" in
        -w|--window|--window=*)
            [[ "$1" == --window=* ]] && window="${1#--window=}" || window=""
            window="$(current_window "$window")"
            name="${2:-}"
            [[ -n "$name" ]] || name="$(pick window)"
            [[ -z "$name" ]] || set_window "$window" "$name"
            ;;
        '') name="$(pick global)"; [[ -z "$name" ]] || set_global "$name" ;;
        --list|-l) list_themes | awk -F '\t' '{ printf "%s %-20s %s\n", $2, $1, $3 }' ;;
        --current|-c) show_current ;;
        --preview|-p) preview_theme "${2:?theme required}" ;;
        --revert|-r)
            name="$(theme_state_value previous 2>/dev/null || true)"
            theme_exists "$name" || { error "No previous global theme"; return 1; }
            set_global "$name"
            ;;
        tint) shift; cmd_tint "$@" ;;
        diagnose) cmd_diagnose ;;
        enabled) feature_enabled theme ;;
        enable) preference_set feature.theme enabled; tmux_init ;;
        disable) preference_set feature.theme disabled; tmux_off; success "Theme feature disabled" ;;
        tmux-init) tmux_init ;;
        tmux-off) tmux_off ;;
        --help|-h) show_help ;;
        -*) error "Unknown option: $1"; show_help >&2; return 64 ;;
        *) set_global "$1" ;;
    esac
}

main "$@"
