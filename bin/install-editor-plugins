#!/bin/bash
# Bootstrap vim-plug and bring the Neovim plugins to their pinned commits.
set -euo pipefail
usage() {
    echo 'Usage: install-editor-plugins [--check]'
    echo 'Installs vim-plug at the commit versions.lock pins, the plugins configs/init.vim'
    echo 'declares, and moves each plugin checkout to its pinned commit. A vim-plug dotfiles'
    echo 'did not install, and a plugin checkout with local changes, are left alone.'
    echo '  --check  Report what would change and change nothing (exit 1 when something would).'
    echo 'Exit 0 when something changed, 2 when everything was already at its pin.'
}
CHECK=false
case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --check|--dry-run) CHECK=true ;;
    "") ;;
    *) echo 'Unknown option (use --help).' >&2; exit 64 ;;
esac
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
source "$DOTFILES_DIR/lib/install.sh"
command -v nvim >/dev/null 2>&1 || { error 'Neovim is required (setup.sh --dev).'; exit 1; }
command -v git >/dev/null 2>&1 || { error 'Git is required.'; exit 1; }
# The plugin declarations; a test seam may point at another init.vim.
INIT="${DOTFILES_EDITOR_INIT:-$DOTFILES_DIR/configs/init.vim}"

# Neovim creates its state directory, a log, and a server socket in
# $XDG_RUNTIME_DIR even for this query. The answer depends on its config and
# data directories, so those two stay; probe_quietly moves the rest.
{ read -r config_dir; read -r data_dir; } < <(probe_quietly env XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" \
    XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}" nvim --headless -u NONE -i NONE \
    -c 'lua io.write(vim.fn.stdpath("config") .. "\n" .. vim.fn.stdpath("data") .. "\n")' -c qall)
[[ "$config_dir" == /* && "$data_dir" == /* ]] || { error 'Neovim returned an invalid config or data directory'; exit 1; }
plug="$config_dir/autoload/plug.vim"
# init.vim keeps an existing config-directory plugin tree; new ones use data.
plug_dir="$data_dir/plugged"
[[ ! -d "$config_dir/plugged" ]] || plug_dir="$config_dir/plugged"
changed=false pending=false

report() { if [[ "$CHECK" == true ]]; then log "Would $*"; pending=true; fi; }

# vim-plug: the pinned plug.vim, replaced only when dotfiles installed the one
# there (its ledger record names that file).
plug_sha="$(versions_field vim-plug sha256 any)"
plug_owner=""
IFS=$'\t' read -r _ _ plug_owner _ < <(ledger_line editor.vim-plug 2>/dev/null || true) || true
current_sha=""
[[ ! -f "$plug" ]] || current_sha="$(sha256sum "$plug" | awk '{print $1}')"
if [[ "$current_sha" != "$plug_sha" ]]; then
    if [[ -n "$current_sha" && "$plug_owner" != dotfiles ]]; then
        warn "vim-plug at $plug: dotfiles did not install it, so it is left alone"
    elif [[ "$CHECK" == true ]]; then
        report "install vim-plug $(versions_field vim-plug want any | cut -c1-12) at $plug"
    else
        revision="$(versions_field vim-plug want any)"
        staged="$(mktemp)"
        trap 'rm -f "$staged"' EXIT
        download_https "https://raw.githubusercontent.com/junegunn/vim-plug/$revision/plug.vim" "$staged"
        verify_sha256 "$staged" "$plug_sha" || exit 1
        mkdir -p "$config_dir/autoload"
        install -m 0644 "$staged" "$plug"
        ledger_record editor.vim-plug yes dotfiles installed "$revision" "$plug" "sha256=$plug_sha" || exit 1
        changed=true
    fi
fi

# Plugins: Plug 'owner/repo', { 'commit': 'SHA' } lines; vim-plug names each
# checkout after the repository.
missing=() moved=()
while read -r repo commit; do
    dir="$plug_dir/${repo##*/}"
    if [[ ! -d "$dir/.git" ]]; then
        missing+=("$repo")
    elif [[ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$commit" ]]; then
        if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
            warn "${repo##*/}: its checkout has local changes, so it stays at $(git -C "$dir" rev-parse --short HEAD)"
        else
            moved+=("$dir $commit")
        fi
    fi
done < <(sed -nE "s/^[[:space:]]*Plug '([^']+)',[[:space:]]*\{[[:space:]]*'commit':[[:space:]]*'([0-9a-f]{40})'.*/\1 \2/p" "$INIT")

for entry in "${moved[@]}"; do
    read -r dir commit <<< "$entry"
    if [[ "$CHECK" == true ]]; then
        report "move ${dir##*/} from $(git -C "$dir" rev-parse --short HEAD) to ${commit:0:12}"
        continue
    fi
    # The pinned commit is fetched by name where the remote allows it, else
    # with the remote's branches.
    git -C "$dir" cat-file -e "$commit^{commit}" 2>/dev/null \
        || git -C "$dir" fetch --quiet origin "$commit" 2>/dev/null \
        || git -C "$dir" fetch --quiet origin \
        || { error "Could not fetch ${dir##*/}"; exit 1; }
    git -C "$dir" checkout --quiet --detach "$commit" || { error "Could not check out ${dir##*/} at $commit"; exit 1; }
    log "Moved ${dir##*/} to ${commit:0:12}"
    changed=true
done

if (( ${#missing[@]} )); then
    if [[ "$CHECK" == true ]]; then
        report "install plugins: ${missing[*]##*/}"
    else
        [[ -f "$plug" ]] || { error "vim-plug is not installed at $plug"; exit 1; }
        nvim --headless -u "$INIT" -i NONE \
            -c 'PlugInstall --sync' \
            -c 'if !empty(filter(values(g:plugs), "!isdirectory(v:val.dir . \"/.git\")")) | cquit 1 | endif' \
            -c qall || { error 'PlugInstall did not install every plugin'; exit 1; }
        changed=true
    fi
fi

if [[ "$CHECK" == true ]]; then
    [[ "$pending" == false ]]
    exit
fi
if [[ "$changed" == true ]]; then
    success 'Neovim plugins are at their pins. Restart Neovim to load them.'
    exit 0
fi
success 'Neovim plugins already at their pins'
exit 2
