#!/bin/sh
# Git credential helper for Azure DevOps.
# Uses `az` CLI to obtain an OAuth token — requires `az login`.
#
# Parked: setup does not install it. To use it on a machine, add to the
# untracked ~/.gitconfig.local, naming this file by its full path:
#   [credential "https://dev.azure.com"]
#       helper = "/path/to/dotfiles/bin/git-credential-azdo"
# Repeat the section for each https://ORG.visualstudio.com host.

if [ "$1" != "get" ]; then
    exit 0
fi

token=$(az account get-access-token \
    --resource 499b84ac-1321-427f-aa17-267ca6975798 \
    --query accessToken -o tsv 2>/dev/null)

if [ -z "$token" ]; then
    exit 1
fi

printf 'username=azdo\npassword=%s\n' "$token"
