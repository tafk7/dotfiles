#!/bin/bash
# Dotfiles verification — checks configs, tools, and environment health.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$SCRIPT_DIR")}"

source "$DOTFILES_DIR/lib/runtime.sh"
source "$DOTFILES_DIR/lib/config.sh"
source "$DOTFILES_DIR/lib/state.sh"
source "$DOTFILES_DIR/lib/work-host.sh"

VERIFY_MODE=installed
VERIFY_TIER=""
declare -A VERIFY_CAPABILITIES=()
WORK_DIAGNOSE=false
RUN_SMOKE=false

usage() {
    cat <<'EOF'
Usage: verify [--installed | --tier config|bash|dev|work|ai|rdp | --all]
              [--tail] [--azure] [--gcloud] [--aws] [--diagnose] [--smoke]

  --installed   Verify recorded machine state (default).
  --tier TIER   Verify the named package tier/feature against current reality.
  --all         Verify every applicable registry component.
  --tail        Require Tailscale service and enrollment readiness.
  --diagnose    Add bounded local sbx diagnostics; never uploads.
  --smoke       Create, execute in, and precisely remove one local shell sandbox.
EOF
}

while (( $# )); do
    case "$1" in
        --installed) VERIFY_MODE=installed; VERIFY_TIER="" ;;
        --tier)
            [[ -n "${2:-}" ]] || { error "--tier requires a value"; exit 64; }
            VERIFY_MODE=tier; VERIFY_TIER="$2"; shift
            case "$VERIFY_TIER" in
                config|bash|dev|work) ;;
                ai|rdp) VERIFY_CAPABILITIES["$VERIFY_TIER"]=true; VERIFY_TIER=config ;;
                *) error "Unknown tier: $VERIFY_TIER"; exit 64 ;;
            esac
            ;;
        --all) VERIFY_MODE=all; VERIFY_TIER="" ;;
        --tail|--azure|--gcloud|--aws)
            VERIFY_CAPABILITIES["${1#--}"]=true
            ;;
        --diagnose) WORK_DIAGNOSE=true ;;
        --smoke) RUN_SMOKE=true ;;
        --help|-h) usage; exit 0 ;;
        *) error "Unknown option: $1"; usage >&2; exit 64 ;;
    esac
    shift
done

tier_rank() {
    case "$1" in config) echo 0 ;; bash) echo 1 ;; dev) echo 2 ;; work) echo 3 ;; *) echo 99 ;; esac
}

component_expected() {
    local name="$1" line status capability
    for capability in "${!VERIFY_CAPABILITIES[@]}"; do
        tool_has_capability "$name" "$capability" && tool_applicable "$name" && return 0
    done
    case "$VERIFY_MODE" in
        all) tool_applicable "$name" ;;
        tier)
            tool_applicable "$name" || return 1
            tool_in_cumulative_tier "$name" "$VERIFY_TIER"
            ;;
        installed)
            line="$(ledger_line "$name" 2>/dev/null || true)"
            [[ -n "$line" ]] || return 1
            IFS=$'\t' read -r _ _ _ status _ _ _ _ <<< "$line"
            [[ "$status" != removed && "$status" != not-applicable ]]
            ;;
    esac
}

PASS=0
WARN=0
FAIL=0

check_pass() { echo -e "  ${GREEN}✅${NC} $1"; ((PASS++)) || true; }
check_warn() { echo -e "  ${YELLOW}⚠️${NC}  $1"; ((WARN++)) || true; }
check_fail() { echo -e "  ${RED}❌${NC} $1"; ((FAIL++)) || true; }

# ==============================================================================
# 1. CONFIG_MAP — check every symlink and template
# ==============================================================================

echo "Configuration files"
echo "─────────────────────────────────────"

readarray -t sorted_configs < <(printf '%s\n' "${!CONFIG_MAP[@]}" | sort)
for config in "${sorted_configs[@]}"; do
    local_mapping="${CONFIG_MAP[$config]}"
    IFS=: read -r target type owner <<< "$local_mapping"
    source_path="$(config_source_path "$config")"

    if [[ -n "$owner" ]] && ! config_owner_present "$owner"; then
        continue
    fi

    case "$type" in
        symlink)
            if [[ -L "$target" ]]; then
                link_dest="$(readlink -f "$target" 2>/dev/null || true)"
                real_source="$(readlink -f "$source_path" 2>/dev/null || true)"
                if [[ "$link_dest" == "$real_source" ]]; then
                    check_pass "$target → $config"
                else
                    check_warn "$target (symlink exists but points elsewhere)"
                fi
            elif [[ -e "$target" ]]; then
                check_warn "$target (exists but not a symlink)"
            else
                check_fail "$target (missing)"
            fi
            ;;
        gitconfig)
            portable_git="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/gitconfig"
            if [[ -f "$portable_git" ]] \
               && git config --global --get-all include.path 2>/dev/null | grep -Fxq "$portable_git"; then
                check_pass "$target includes portable dotfiles config"
            elif [[ -f "$target" ]] \
                 && grep -Fq '# This is a template file - values will be replaced during installation' "$target" \
                 && ! grep -q '{{GIT_' "$target"; then
                check_pass "$target uses the valid pre-migration dotfiles format"
            else
                check_fail "$target missing portable include ($portable_git)"
            fi
            ;;
    esac
done

# ==============================================================================
# 2. Managed tools — single loop over registry, grouped by tier
# ==============================================================================

for tier in bash dev work capabilities; do
    if [[ "$tier" == capabilities ]]; then
        readarray -t tier_tools < <(
            for name in "${!TOOL_BINARY[@]}"; do
                [[ -z "${TOOL_TIER[$name]:-}" ]] && printf '%s\n' "$name"
            done | sort
        )
    else
        readarray -t tier_tools < <(tools_for_tier "$tier")
    fi
    [[ ${#tier_tools[@]} -eq 0 ]] && continue

    echo
    [[ "$tier" == capabilities ]] && echo "Tools [orthogonal capabilities]" || echo "Tools [$tier tier]"
    echo "─────────────────────────────────────"

    for name in "${tier_tools[@]}"; do
        if ! tool_applicable "$name"; then
            explicitly_requested=false
            for capability in "${!VERIFY_CAPABILITIES[@]}"; do
                tool_has_capability "$name" "$capability" && explicitly_requested=true
            done
            if [[ "$explicitly_requested" == true ]]; then
                check_fail "$name (requested capability is unsupported on $(tool_platform)/$(tool_arch))"
            elif [[ "$VERIFY_MODE" == all ]]; then
                check_pass "$name (not applicable on $(tool_platform)/$(tool_arch))"
            fi
            continue
        fi
        expected=false
        component_expected "$name" && expected=true
        if [[ "$VERIFY_MODE" == tier && "$VERIFY_TIER" == config && ${#VERIFY_CAPABILITIES[@]} -eq 0 ]]; then
            continue
        fi
        if [[ "$expected" != true && "$VERIFY_MODE" != all ]]; then
            continue
        fi
        binary="${TOOL_BINARY[$name]}"
        label="$name"
        [[ "$name" != "$binary" ]] && label="$name ($binary)"

        if tool_is_present "$name"; then
            if [[ "$VERIFY_MODE" == installed ]]; then
                ledger="$(ledger_line "$name" 2>/dev/null || true)"
                IFS=$'\t' read -r _ _ recorded_owner recorded_status _ recorded_path _ _ <<< "$ledger"
                observed_path="$(command -v "$binary" 2>/dev/null || true)"
                # Match _registry_ripgrep_present and installer discovery: the
                # durable rg takes precedence over an agent-private PATH copy.
                if [[ "$name" == ripgrep && -x "$HOME/.local/bin/rg" ]]; then
                    observed_path="$HOME/.local/bin/rg"
                fi
                [[ -z "$observed_path" ]] || observed_path="$(readlink -f "$observed_path" 2>/dev/null || printf '%s' "$observed_path")"
                if [[ "$recorded_status" == update-failed ]]; then
                    check_warn "$label (prior installation works; last update failed)"
                elif [[ "$recorded_owner" == unknown ]]; then
                    check_warn "$label (present; ownership not yet claimed)"
                elif [[ "$recorded_owner" == dotfiles && -n "$observed_path" ]] \
                     && ! tool_owned_path "$name" "$observed_path"; then
                    check_fail "$label (present outside recorded ownership: $observed_path)"
                elif [[ "$recorded_path" != - && -n "$observed_path" && "$recorded_path" != "$observed_path" ]] \
                     && ! { [[ "$recorded_owner" == dotfiles ]] && tool_moves_itself "$name"; }; then
                    # A self-updating tool is expected to move within its
                    # ownership roots, which the check above already enforces.
                    check_warn "$label (path changed: recorded $recorded_path, observed $observed_path)"
                else
                    check_pass "$label"
                fi
            else
                check_pass "$label"
            fi
        else
            if [[ "$expected" == true ]]; then
                missing_companions=""
                for companion in ${TOOL_COMPANIONS[$name]:-}; do
                    command -v "$companion" >/dev/null 2>&1 || missing_companions+=" $companion"
                done
                if command -v "$binary" >/dev/null 2>&1 && [[ -n "$missing_companions" ]]; then
                    check_fail "$label (missing companion:${missing_companions})"
                else
                    check_fail "$label (not found or verification failed)"
                fi
            elif [[ "$VERIFY_MODE" == all ]]; then
                check_warn "$label (not installed)"
            fi
        fi
    done
done

# ==============================================================================
# 3. Git configuration
# ==============================================================================

echo
echo "Git"
echo "─────────────────────────────────────"

git_name=$(git config --global --includes --get user.name 2>/dev/null || true)
git_email=$(git config --global --includes --get user.email 2>/dev/null || true)
if [[ -n "$git_name" && -n "$git_email" ]]; then
    check_pass "user: $git_name <$git_email>"
else
    check_warn "user not configured"
fi

# Configuration is checked separately from binary availability.
for ai_component in codex claude; do
    if component_expected "$ai_component"; then
        if ! "$DOTFILES_DIR/bin/ai-config" "$ai_component" --check --plugins; then
            check_fail "$ai_component portable configuration needs reconciliation (bin/ai-config)."
        fi
    fi
done

# Pre-commit hook (info-level — never fail verify if absent).
git_common_dir="$(git -C "$DOTFILES_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
hook_path="${git_common_dir:-$DOTFILES_DIR/.git}/hooks/pre-commit"
if [[ -L "$hook_path" ]]; then
    resolved="$(readlink -f "$hook_path" 2>/dev/null || true)"
    if [[ "$resolved" == "$DOTFILES_DIR/hooks/"* ]]; then
        check_pass "pre-commit hook installed (symlink → hooks/pre-commit)"
    else
        check_warn "pre-commit hook present but not from this repo"
    fi
elif [[ -f "$hook_path" ]] && head -n4 "$hook_path" 2>/dev/null | grep -q "Installed by bin/install-git-hooks"; then
    check_pass "pre-commit hook installed (copy)"
elif [[ -f "$hook_path" ]]; then
    check_warn "pre-commit hook present but not from this repo"
else
    check_warn "pre-commit hook not installed (run: bin/install-git-hooks)"
fi

# ==============================================================================
# 4. Work-tier local execution and optional Tailscale readiness
# ==============================================================================

verify_work_host=false
if [[ "$VERIFY_MODE" == tier && "$VERIFY_TIER" == work ]]; then
    verify_work_host=true
elif [[ "$VERIFY_MODE" == installed ]] && component_expected sbx; then
    verify_work_host=true
elif [[ "$RUN_SMOKE" == true ]]; then
    verify_work_host=true
fi
if [[ "$verify_work_host" == true ]]; then
    echo
    echo "Work local-execution readiness"
    echo "─────────────────────────────────────"
    work_verify_checks true
fi

if [[ "${VERIFY_CAPABILITIES[tail]:-false}" == true ]] \
   || { [[ "$VERIFY_MODE" == installed ]] && component_expected tailscale; }; then
    echo
    echo "Tailscale readiness"
    echo "─────────────────────────────────────"
    tail_verify_checks true
fi

if [[ "$RUN_SMOKE" == true ]]; then
    echo
    echo "Local sbx smoke test"
    echo "─────────────────────────────────────"
    if work_smoke_test; then
        check_pass "mountless local shell sandbox create/exec/cleanup"
    else
        check_fail "local sandbox smoke test failed"
    fi
fi

# ==============================================================================
# 5. WSL
# ==============================================================================

if is_wsl; then
    echo
    echo "WSL"
    echo "─────────────────────────────────────"

    if [[ -x "$HOME/.local/bin/pbcopy" ]]; then
        check_pass "clipboard integration"
    else
        check_warn "clipboard scripts not installed (run setup.sh)"
    fi
fi

# ==============================================================================
# 6. Environment files
# ==============================================================================

echo
echo "Environment"
echo "─────────────────────────────────────"

if state_validate; then
    check_pass "machine-state schema"
else
    check_fail "machine-state schema invalid"
fi
if journal_pending; then
    check_fail "incomplete component transaction requires reconciliation: $DOTFILES_JOURNAL_FILE"
else
    check_pass "no incomplete component transaction"
fi

if [[ -f "$DOTFILES_STATE_DIR/install-path" ]] && [[ "$(<"$DOTFILES_STATE_DIR/install-path")" == "$DOTFILES_DIR" ]]; then
    check_pass "durable install path"
else
    check_warn "durable install path missing or stale (run setup.sh --config)"
fi

if feature_enabled theme; then
    theme="$("$DOTFILES_DIR/bin/theme-switcher" --current | sed -n 's/^global: //p')"
    if _state_validate_file "$DOTFILES_THEME_STATE_FILE" theme 2 2>/dev/null; then
        check_pass "global theme: $theme"
    else
        check_fail "theme state is invalid (using $theme)"
    fi
    tmux_version="$(tmux -V 2>/dev/null | awk '{print $2}' | sed 's/[^0-9.].*$//' || true)"
    if [[ -n "$tmux_version" ]] && ! version_gte "$tmux_version" 3.3; then
        check_warn "tmux $tmux_version: themes color tmux itself, but programs keep the terminal palette (needs 3.3+)"
    fi
else
    check_pass "theme feature disabled"
fi

# Programs follow window themes through palette colors; delta's come from the
# portable Git config.
if [[ -f "$HOME/.gitconfig" ]]; then
    if [[ "$(git config --global --includes --get delta.syntax-theme 2>/dev/null || true)" == ansi ]]; then
        check_pass "delta: palette-based colors"
    else
        check_warn "delta: ~/.gitconfig lacks the palette-based delta settings (run setup.sh --config)"
    fi
fi

if feature_enabled agent-badge \
   && { component_expected claude || component_expected codex; }; then
    if command -v jq >/dev/null 2>&1; then
        check_pass 'agent-badge JSON dependency (jq)'
    else
        check_warn 'agent-badge requires jq on PATH (see plugins/shared/README.md)'
    fi
fi

# ==============================================================================
# 7. EDITOR conflict detection
# ==============================================================================

echo
echo "Conflict checks"
echo "─────────────────────────────────────"

editor_conflict=false
for alias_file in "$DOTFILES_DIR"/shell/tools/*.sh; do
    if [[ -f "$alias_file" ]] && grep -v "^[[:space:]]*#" "$alias_file" 2>/dev/null | grep -q "^[[:space:]]*export EDITOR"; then
        check_warn "EDITOR set in $(basename "$alias_file") (should only be in shell/env.sh)"
        editor_conflict=true
    fi
done
if [[ "$editor_conflict" == false ]]; then
    check_pass "EDITOR (single source: shell/env.sh)"
fi

# ==============================================================================
# 8. Agent shell surface
# ==============================================================================
#
# Check our non-interactive boundary, not a particular harness's snapshot
# serialization. External profile functions are deliberately preserved; their
# presence alone does not establish a meaningful per-command performance cost.

echo
echo "Agent shell"
echo "─────────────────────────────────────"

agent_fns="$(bash -lc 'compgen -A function || true' 2>/dev/null)"
agent_dotfiles_fns="$(printf '%s\n' "$agent_fns" | grep -Ec '^(_dotfiles_|reload$|proj$|theme$|fmt$|lint$|lintf$)' || true)"
if [[ "$agent_dotfiles_fns" -eq 0 ]]; then
    check_pass "no dotfiles interactive/private functions leak into the agent shell"
else
    check_warn "$agent_dotfiles_fns dotfiles interactive/private function(s) in the agent shell"
fi

agent_aliases="$(bash -lc 'alias' 2>/dev/null | wc -l)"
if [[ "$agent_aliases" -eq 0 ]]; then
    check_pass "no aliases leak into the agent shell"
else
    check_warn "$agent_aliases alias(es) in the agent shell"
fi

if [[ -z "$(bash -lc 'printf %s "${BASH_ENV:-}"' 2>/dev/null)" ]]; then
    check_pass "BASH_ENV unset (bare \`bash -c\` stays free)"
else
    check_warn "BASH_ENV is set — every \`bash -c\` sources a file, taxing all harnesses"
fi

agent_path="$(bash -lc 'printf %s "$PATH"' 2>/dev/null)"
ap_total="$(printf '%s\n' "$agent_path" | tr ':' '\n' | wc -l)"
ap_unique="$(printf '%s\n' "$agent_path" | tr ':' '\n' | sort -u | wc -l)"
if [[ "$ap_total" -eq "$ap_unique" ]]; then
    check_pass "agent PATH deduped ($ap_total entries)"
else
    check_warn "agent PATH has duplicates ($ap_total entries, $ap_unique unique)"
fi

# ==============================================================================
# Summary
# ==============================================================================

echo
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "  ${GREEN}✅ $PASS passed${NC}  ${YELLOW}⚠️  $WARN warnings${NC}  ${RED}❌ $FAIL errors${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

exit "$FAIL"
