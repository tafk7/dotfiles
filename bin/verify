#!/bin/bash
# The older name for `dotfiles verify`, which makes every check. This maps the
# old options and lists every check (-v), as this command always did.
#
# Exit status is dotfiles verify's: 0 healthy (notes allowed), 1 setup has
# work to do, 2 something needs you, 3 a check could not be made, 64 a usage
# error. (It used to be the number of failed checks.)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: verify [--installed | --tier config|bash|dev|work|ai|rdp | --all]
              [--tail] [--azure] [--gcloud] [--aws] [--diagnose] [--smoke]

Runs `dotfiles verify -v` (see dotfiles --help):
  --installed   The profile's selection, or the ledger's without one (default).
  --tier TIER   That tier's components; ai and rdp check only that capability.
  --all         Also every other component that applies here.
  --tail, ...   Also expect a capability's components.
  --diagnose    Add bounded local sbx diagnostics; never uploads.
  --smoke       Create, execute in, and precisely remove one local shell sandbox.
EOF
}

# The scope options replace one another, as they did; the rest accumulate.
scope=()
args=()
while (( $# )); do
    case "$1" in
        --installed) scope=() ;;
        --all) scope=(--all) ;;
        --tier)
            [[ -n "${2:-}" ]] || { echo 'Error: --tier requires a value' >&2; exit 64; }
            case "$2" in
                ai|rdp) scope=(--tier config); args+=("--$2") ;;
                *) scope=(--tier "$2") ;;
            esac
            shift
            ;;
        --help|-h) usage; exit 0 ;;
        *) args+=("$1") ;;
    esac
    shift
done

exec "$ROOT/bin/dotfiles" verify -v "${scope[@]+"${scope[@]}"}" "${args[@]+"${args[@]}"}"
