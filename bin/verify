#!/bin/bash
# Dotfiles verification — checks configs, tools, and environment health.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$SCRIPT_DIR")}"

source "$DOTFILES_DIR/lib/runtime.sh"
source "$DOTFILES_DIR/lib/config.sh"
source "$DOTFILES_DIR/lib/theme-resolve.sh"

# Load persistent global state before resolving the current scoped context.
load_theme_overrides

# Counters
PASS=0
WARN=0
FAIL=0

check_pass() { echo -e "  ${GREEN}✅${NC} $1"; ((PASS++)) || true; }
check_warn() { echo -e "  ${YELLOW}⚠️${NC}  $1"; ((WARN++)) || true; }
check_fail() { echo -e "  ${RED}❌${NC} $1"; ((FAIL++)) || true; }

# ==============================================================================
# 1. CONFIG_MAP — check every symlink and template
# ==============================================================================

echo "Configuration files"
echo "─────────────────────────────────────"

readarray -t sorted_configs < <(printf '%s\n' "${!CONFIG_MAP[@]}" | sort)
for config in "${sorted_configs[@]}"; do
    local_mapping="${CONFIG_MAP[$config]}"
    target="${local_mapping%%:*}"
    type="${local_mapping##*:}"
    source_path="$(config_source_path "$config")"

    case "$type" in
        symlink)
            if [[ -L "$target" ]]; then
                link_dest="$(readlink -f "$target" 2>/dev/null || true)"
                real_source="$(readlink -f "$source_path" 2>/dev/null || true)"
                if [[ "$link_dest" == "$real_source" ]]; then
                    check_pass "$target → $config"
                else
                    check_warn "$target (symlink exists but points elsewhere)"
                fi
            elif [[ -e "$target" ]]; then
                check_warn "$target (exists but not a symlink)"
            else
                check_fail "$target (missing)"
            fi
            ;;
        gitconfig)
            if [[ -f "$target" ]]; then
                if grep -q '{{GIT_' "$target" 2>/dev/null; then
                    check_fail "$target (has unresolved template placeholders)"
                else
                    check_pass "$target (processed template)"
                fi
            else
                check_fail "$target (missing)"
            fi
            ;;
    esac
done

# ==============================================================================
# 2. Managed tools — single loop over registry, grouped by tier
# ==============================================================================

for tier in bash dev work ai rdp; do
    readarray -t tier_tools < <(tools_for_tier "$tier")
    [[ ${#tier_tools[@]} -eq 0 ]] && continue

    echo
    echo "Tools [$tier tier]"
    echo "─────────────────────────────────────"

    for name in "${tier_tools[@]}"; do
        verify_cmd="$(tool_verify_command "$name")"
        binary="${TOOL_BINARY[$name]}"
        label="$name"
        [[ "$name" != "$binary" ]] && label="$name ($binary)"

        if eval "$verify_cmd"; then
            check_pass "$label"
        else
            # Only the bash tier is the guaranteed baseline (its eget binaries
            # install with no sudo, so any --bash+ run should have them). Every
            # tier above bash is opt-in — verify can't know which tier you chose —
            # so a missing dev/work/ai/rdp tool warns rather than fails:
            #   - dev tier (neovim/tmux/shellcheck) only present with --dev+
            #   - work tier (nvm/docker/azure) is opt-in
            #   - ai tier (claude/codex) is opt-in and may be org-managed
            #   - rdp tier (xrdp) is opt-in per machine
            if [[ "$tier" != "bash" ]]; then
                check_warn "$label (not installed)"
            else
                check_fail "$label (not found)"
            fi
        fi
    done
done

# ==============================================================================
# 3. Git configuration
# ==============================================================================

echo
echo "Git"
echo "─────────────────────────────────────"

git_name=$(git config --get user.name 2>/dev/null || true)
git_email=$(git config --get user.email 2>/dev/null || true)
if [[ -n "$git_name" && -n "$git_email" ]]; then
    check_pass "user: $git_name <$git_email>"
else
    check_warn "user not configured"
fi

# Pre-commit hook (info-level — never fail verify if absent).
hook_path="$DOTFILES_DIR/.git/hooks/pre-commit"
if [[ -L "$hook_path" ]]; then
    resolved="$(readlink -f "$hook_path" 2>/dev/null || true)"
    if [[ "$resolved" == "$DOTFILES_DIR/hooks/"* ]]; then
        check_pass "pre-commit hook installed (symlink → hooks/pre-commit)"
    else
        check_warn "pre-commit hook present but not from this repo"
    fi
elif [[ -f "$hook_path" ]] && head -n4 "$hook_path" 2>/dev/null | grep -q "Installed by bin/install-git-hooks"; then
    check_pass "pre-commit hook installed (copy)"
elif [[ -f "$hook_path" ]]; then
    check_warn "pre-commit hook present but not from this repo"
else
    check_warn "pre-commit hook not installed (run: bin/install-git-hooks)"
fi

# ==============================================================================
# 4. Docker
# ==============================================================================

if command -v docker >/dev/null 2>&1; then
    echo
    echo "Docker"
    echo "─────────────────────────────────────"

    # Ground truth for "can I use docker now" is the current process's groups
    # (id -nG with no arg), which reflects login-time membership resolved via
    # nsswitch. Don't grep /etc/group or do a fresh `id -nG "$USER"` lookup:
    # directory-backed setups (LDAP/SSS/AD) supply docker membership outside the
    # local file, and a by-name lookup can even return a different set than the
    # live session, so both false-negative. getent catches the "added but not yet
    # active in this session" case (membership exists but login predates it).
    if id -nG 2>/dev/null | grep -qw docker; then
        check_pass "docker group (active)"
    elif getent group docker 2>/dev/null | grep -qw "$USER"; then
        check_warn "docker group (added — restart shell to activate)"
    else
        check_fail "not in docker group (sudo usermod -aG docker $USER)"
    fi
fi

# ==============================================================================
# 5. WSL
# ==============================================================================

if is_wsl; then
    echo
    echo "WSL"
    echo "─────────────────────────────────────"

    if [[ -x "$HOME/.local/bin/pbcopy" ]]; then
        check_pass "clipboard integration"
    else
        check_warn "clipboard scripts not installed (run setup.sh)"
    fi
fi

# ==============================================================================
# 6. Environment files
# ==============================================================================

echo
echo "Environment"
echo "─────────────────────────────────────"

if [[ -f "$DOTFILES_DIR/generated/bridge.sh" ]]; then
    check_pass "generated/bridge.sh"
else
    check_warn "bridge file missing (run setup.sh)"
fi

if [[ -f "$DOTFILES_DIR/generated/theme-state.sh" || -f "$DOTFILES_DIR/generated/theme.sh" ]]; then
    load_theme_context
    theme="$DOTFILES_THEME"
    check_pass "global theme: $theme"
else
    check_warn "no theme set (run: bin/theme-switcher <theme>)"
    theme=""
fi

# ==============================================================================
# 6b. Theme integration — per-surface wiring (cascade-aware)
# ==============================================================================

if [[ -n "$theme" ]]; then
    # Resolve the current shell's window/session when inside tmux, otherwise
    # verify the standalone global scope.
    load_theme_context
    r_bat="$(resolve_surface_theme bat)"
    r_starship="$(resolve_surface_theme starship)"
    r_delta="$(resolve_surface_theme delta)"
    r_btop="$(resolve_surface_theme btop)"
    r_lazygit="$(resolve_surface_theme lazygit)"

    echo
    echo "Theme integration [global=$theme${THEME_CONTEXT_SESSION:+ session=$THEME_CONTEXT_SESSION}${THEME_CONTEXT_WINDOW:+ window=$THEME_CONTEXT_WINDOW}]"
    echo "─────────────────────────────────────"

    # bat: built-in themes such as gruvbox-dark need no vendored file
    if [[ -d "$DOTFILES_DIR/themes/$r_bat/bat" ]]; then
        bat_files=("$DOTFILES_DIR/themes/$r_bat/bat"/*.tmTheme)
        if [[ -e "${bat_files[0]}" ]]; then
            check_pass "bat [$r_bat]: vendored ${#bat_files[@]} .tmTheme file(s)"
            if [[ -f "$DOTFILES_DIR/generated/bat/cache/themes.bin" ]]; then
                check_pass "bat: isolated cache built (generated/bat/cache/themes.bin)"
            else
                check_warn "bat: isolated cache missing (run bin/theme-switcher $r_bat)"
            fi
        else
            check_warn "bat [$r_bat]: themes/$r_bat/bat exists but is empty"
        fi
    else
        check_pass "bat [$r_bat]: uses bat built-in (no vendored .tmTheme needed)"
    fi

    # starship: immutable per-theme generated config
    starship_config="$DOTFILES_DIR/generated/themes/$r_starship/starship.toml"
    if [[ -f "$starship_config" ]]; then
        if grep -q "^palette = \"$r_starship\"" "$starship_config"; then
            check_pass "starship [$r_starship]: scoped artifact ready"
        else
            check_warn "starship: scoped artifact palette mismatch for '$r_starship'"
        fi
    else
        check_warn "starship: scoped artifact missing (run bin/theme-switcher --init)"
    fi

    # delta: one shared definition index; DELTA_FEATURES selects per process.
    if [[ -f "$DOTFILES_DIR/generated/delta.gitconfig" ]]; then
        if grep -Fq "path = $DOTFILES_DIR/themes/$r_delta/delta.gitconfig" "$DOTFILES_DIR/generated/delta.gitconfig"; then
            check_pass "delta [$r_delta]: feature definition indexed"
        else
            check_warn "delta: generated index is missing '$r_delta'"
        fi
        if git config --global --get-all include.path 2>/dev/null | grep -Fxq "$DOTFILES_DIR/generated/delta.gitconfig"; then
            check_pass "delta: ~/.gitconfig includes generated/delta.gitconfig"
        else
            check_warn "delta: ~/.gitconfig missing include for generated/delta.gitconfig"
        fi
    else
        if [[ -f "$DOTFILES_DIR/themes/$r_delta/delta.gitconfig" ]]; then
            check_warn "delta: generated/delta.gitconfig missing"
        fi
    fi

    # btop and lazygit use launch-time config paths and never patch user files.
    if [[ -f "$DOTFILES_DIR/generated/themes/$r_btop/btop.conf" ]]; then
        check_pass "btop [$r_btop]: scoped config ready"
    else
        check_warn "btop [$r_btop]: scoped config missing"
    fi

    if [[ -f "$DOTFILES_DIR/themes/$r_lazygit/lazygit.yml" ]]; then
        check_pass "lazygit [$r_lazygit]: launch overlay ready"
    else
        check_warn "lazygit [$r_lazygit]: theme overlay missing"
    fi
fi

# ==============================================================================
# 7. EDITOR conflict detection
# ==============================================================================

echo
echo "Conflict checks"
echo "─────────────────────────────────────"

editor_conflict=false
for alias_file in "$DOTFILES_DIR"/shell/tools/*.sh; do
    if [[ -f "$alias_file" ]] && grep -v "^[[:space:]]*#" "$alias_file" 2>/dev/null | grep -q "^[[:space:]]*export EDITOR"; then
        check_warn "EDITOR set in $(basename "$alias_file") (should only be in shell/env.sh)"
        editor_conflict=true
    fi
done
if [[ "$editor_conflict" == false ]]; then
    check_pass "EDITOR (single source: shell/env.sh)"
fi

# ==============================================================================
# 8. Agent shell surface
# ==============================================================================
#
# Coding harnesses (Claude Code, Codex, opencode) never load the interactive
# profile — they run `bash -lc` and/or snapshot a non-interactive login shell
# and source that snapshot on every tool call. Anything defined in that shell is
# paid per call, forever. tests/agent-shell.sh enforces this; surface it here
# too so it shows up in a routine health check.

echo
echo "Agent shell"
echo "─────────────────────────────────────"

agent_fns="$(bash -lc 'declare -F' 2>/dev/null | wc -l)"
if [[ "$agent_fns" -eq 0 ]]; then
    check_pass "no functions leak into the agent shell"
else
    check_warn "$agent_fns function(s) in the agent shell — each is re-encoded into every harness snapshot and paid per tool call (bash -lc 'declare -F')"
fi

agent_aliases="$(bash -lc 'alias' 2>/dev/null | wc -l)"
if [[ "$agent_aliases" -eq 0 ]]; then
    check_pass "no aliases leak into the agent shell"
else
    check_warn "$agent_aliases alias(es) in the agent shell"
fi

if [[ -z "$(bash -lc 'printf %s "${BASH_ENV:-}"' 2>/dev/null)" ]]; then
    check_pass "BASH_ENV unset (bare \`bash -c\` stays free)"
else
    check_warn "BASH_ENV is set — every \`bash -c\` sources a file, taxing all harnesses"
fi

agent_path="$(bash -lc 'printf %s "$PATH"' 2>/dev/null)"
ap_total="$(printf '%s\n' "$agent_path" | tr ':' '\n' | wc -l)"
ap_unique="$(printf '%s\n' "$agent_path" | tr ':' '\n' | sort -u | wc -l)"
if [[ "$ap_total" -eq "$ap_unique" ]]; then
    check_pass "agent PATH deduped ($ap_total entries)"
else
    check_warn "agent PATH has duplicates ($ap_total entries, $ap_unique unique)"
fi

# ==============================================================================
# Summary
# ==============================================================================

echo
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "  ${GREEN}✅ $PASS passed${NC}  ${YELLOW}⚠️  $WARN warnings${NC}  ${RED}❌ $FAIL errors${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

exit "$FAIL"
