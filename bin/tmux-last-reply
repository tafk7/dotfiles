#!/usr/bin/env python3
"""Copy the last agent reply in a tmux pane (prefix+y).

    tmux-last-reply PANE

Claude: read the reply from Claude's session file, so the draft in its prompt
is untouched, and load it into the tmux buffer; the after-load-buffer hook
sends it on to the clipboard. The pane's Claude process is the one whose
stdin is the pane's tty; its sessions/<pid>.json names the session.
Codex (Ctrl+O) and OpenCode (Ctrl+X y) have copy keys of their own, which
reach the clipboard through their own OSC 52 only.
"""

import json
import os
import subprocess
import sys
from pathlib import Path


def tmux(*args, stdin=None):
    return subprocess.run(["tmux", *args], input=stdin, capture_output=True, text=True).stdout.strip()


def message(text):
    tmux("display-message", "-t", PANE, text)


def claude_process(tty):
    """The Claude process reading from TTY."""
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if os.readlink(entry / "fd/0") != tty:
                continue
            argv0 = (entry / "cmdline").read_bytes().split(b"\0", 1)[0]
        except OSError:
            continue
        if os.path.basename(argv0) == b"claude":
            return entry
    return None


def config_dir(process):
    try:
        for item in (process / "environ").read_bytes().split(b"\0"):
            if item.startswith(b"CLAUDE_CONFIG_DIR="):
                return Path(os.fsdecode(item.split(b"=", 1)[1]))
    except OSError:
        pass
    return Path.home() / ".claude"


def last_reply(transcript):
    """Text of the last main-thread assistant message that has any."""
    texts, current = {}, None
    with transcript.open() as lines:
        for line in lines:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("type") != "assistant" or entry.get("isSidechain"):
                continue
            body = entry.get("message") or {}
            blocks = body.get("content")
            if not isinstance(blocks, list):
                continue
            text = [b.get("text", "") for b in blocks if b.get("type") == "text" and b.get("text")]
            if text:
                key = body.get("id") or id(entry)
                if key != current:
                    texts[key], current = [], key
                texts[key] += text
    return "\n\n".join(texts[current]) if current is not None else None


def copy_claude(tty):
    process = claude_process(tty)
    if process is None:
        return message("last reply: no Claude process in this pane")
    root = config_dir(process)
    try:
        session = json.loads((root / "sessions" / f"{process.name}.json").read_text())["sessionId"]
    except (OSError, ValueError, KeyError):
        return message("last reply: Claude's session record not found")
    transcript = next(root.glob(f"projects/*/{session}.jsonl"), None)
    reply = last_reply(transcript) if transcript else None
    if not reply:
        return message("last reply: Claude has not replied yet")
    tmux("load-buffer", "-", stdin=reply)
    message(f"copied Claude's last reply ({len(reply.splitlines())} lines)")


def main():
    if not PANE:
        sys.exit("usage: tmux-last-reply PANE")
    command, tty = tmux("display-message", "-p", "-t", PANE, "#{pane_current_command}\t#{pane_tty}").split("\t")
    if command == "claude":
        copy_claude(tty)
    elif command == "codex":
        tmux("send-keys", "-t", PANE, "C-o")
    elif command == "opencode":
        tmux("send-keys", "-t", PANE, "C-x", "y")
    else:
        message("last reply: no agent in this pane")


PANE = sys.argv[1] if len(sys.argv) > 1 else ""
if __name__ == "__main__":
    main()
