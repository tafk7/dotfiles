#!/usr/bin/env bash
# Scroll a pane a few lines, the same way everywhere (Shift+PgUp / Shift+PgDn):
#
#     tmux-scroll up|down PANE
#
# The step is @scroll-lines lines (default 3).
#   copy-mode (review included)  the view moves that many lines
#   Claude, Codex, OpenCode      mouse-wheel events, which each agent scrolls by
#                                its own step (Claude and Codex 1 line, OpenCode
#                                3; measured on 2.1.311, 0.164.0, 2.1.4), as many
#                                as make the lines. Codex has no keyboard key
#                                for a small scroll, so the wheel is what all
#                                three share
#   a compose pane               its agent, as PgUp is forwarded
#   a shell                      copy-mode that many lines up, which exits at
#                                the bottom; down at the bottom does nothing
#   anything else                gets the key itself

set -uo pipefail

dir="${1:?usage: tmux-scroll up|down PANE}"
pane="${2:?usage: tmux-scroll up|down PANE}"
[[ "$dir" == up || "$dir" == down ]] || { echo "usage: tmux-scroll up|down PANE" >&2; exit 2; }

lines=$(tmux show -gqv @scroll-lines)
[[ "$lines" =~ ^[1-9][0-9]*$ ]] || lines=3

target=$(tmux show -pqv -t "$pane" @compose_target 2>/dev/null)
[[ -n "$target" ]] && tmux display-message -p -t "$target" '' >/dev/null 2>&1 && pane="$target"

IFS='|' read -r in_mode command alternate mouse sgr width height < <(tmux display-message -p -t "$pane" \
    '#{pane_in_mode}|#{pane_current_command}|#{alternate_on}|#{mouse_any_flag}|#{mouse_sgr_flag}|#{pane_width}|#{pane_height}')

if [[ "$in_mode" == 1 ]]; then
    tmux send-keys -t "$pane" -X -N "$lines" "scroll-$dir"
    exit
fi

case "$command" in
    claude | codex) step=1 ;;
    opencode) step=3 ;;
    *) step=0 ;;
esac

if ((step)) && [[ "$mouse" == 1 && "$sgr" == 1 ]]; then
    # SGR wheel events (button 64 up, 65 down) over the transcript: a third of
    # the way down, clear of a left margin.
    button=64
    [[ "$dir" == down ]] && button=65
    x=$((width < 10 ? width : 10))
    y=$((height / 3 > 0 ? height / 3 : 1))
    events=$(((lines + step - 1) / step))
    hex=$(printf '\e[<%d;%d;%dM' "$button" "$x" "$y" | od -An -tx1 -v | tr -s ' \n' ' ')
    keys=()
    for ((i = 0; i < events; i++)); do
        # shellcheck disable=SC2206  # one byte per argument
        keys+=($hex)
    done
    tmux send-keys -t "$pane" -H "${keys[@]}"
elif [[ "$alternate" == 0 && "$mouse" == 0 ]]; then
    if [[ "$dir" == up ]]; then
        tmux copy-mode -e -t "$pane"
        tmux send-keys -t "$pane" -X -N "$lines" scroll-up
    fi
elif [[ "$dir" == up ]]; then
    tmux send-keys -t "$pane" S-PPage
else
    tmux send-keys -t "$pane" S-NPage
fi
