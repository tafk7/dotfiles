#!/usr/bin/env python3
"""Write a Codex session as Markdown, for review (bin/tmux-review).

    codex-transcript --home CODEX_HOME [--title PANE_TITLE] [--cwd DIR]

The session is the rollout file of the thread whose id is in the pane title:
Codex writes it there when `tui.terminal_title` includes `thread-id`, cut to
its first 29 characters, which still name one thread. Without an id in the
title it is the newest session started in DIR, and the first line says so,
since two Codex panes in one directory can't be told apart that way.

Rollouts record the app-server's thread items as `item_completed` events;
each becomes a section: the user's prompts under `## User` (the review pane
marks those lines as prompts), Codex's messages under `## Codex`, commands
with their output, file changes as diffs, and tool calls. Reasoning is left
out. Rollouts without those events fall back to their plain messages.
"""

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

THREAD_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{0,12}")


def records(path):
    """The JSON records of a rollout, which may be zstd-compressed."""
    if path.suffix == ".zst":
        text = subprocess.run(["zstd", "-dc", str(path)], capture_output=True, text=True, check=True).stdout
    else:
        text = path.read_text(errors="replace")
    for line in text.splitlines():
        try:
            yield json.loads(line)
        except ValueError:
            continue


def rollouts(home):
    return sorted((home / "sessions").glob("*/*/*/rollout-*.jsonl*"), key=lambda p: p.stat().st_mtime, reverse=True)


def by_thread(home, prefix):
    found = [p for p in rollouts(home) if f"-{prefix}" in p.name]
    return found[0] if found else None


def by_directory(home, cwd):
    for path in rollouts(home)[:500]:
        first = next(records(path), {})
        if first.get("type") == "session_meta" and first.get("payload", {}).get("cwd") == cwd:
            return path
    return None


def fenced(text, info=""):
    longest = max((len(run) for run in re.findall(r"`+", text)), default=0)
    fence = "`" * max(3, longest + 1)
    return f"{fence}{info}\n{text.rstrip(chr(10))}\n{fence}"


def texts(content):
    return "\n\n".join(part["text"].strip() for part in content or [] if part.get("text"))


def command_line(command):
    if isinstance(command, list):
        if len(command) == 3 and command[1] in ("-lc", "-c"):
            return command[2]
        return " ".join(command)
    return str(command)


def item_section(item):
    kind = item.get("type")
    if kind == "UserMessage":
        return "## User\n\n" + texts(item.get("content"))
    if kind == "AgentMessage":
        return "## Codex\n\n" + texts(item.get("content"))
    if kind == "CommandExecution":
        output = item.get("aggregated_output") or item.get("formatted_output") or ""
        return fenced(f"$ {command_line(item.get('command'))}\n{output}", "console")
    if kind == "FileChange":
        parts = []
        for path, change in (item.get("changes") or {}).items():
            parts.append(f"{change.get('type', 'update').capitalize()} `{path}`")
            if change.get("unified_diff"):
                parts.append(fenced(change["unified_diff"], "diff"))
        return "\n\n".join(parts)
    if kind == "McpToolCall":
        arguments = json.dumps(item.get("arguments"), indent=2, ensure_ascii=False)
        return f"Called `{item.get('server')}.{item.get('tool')}`\n\n" + fenced(arguments, "json")
    if kind == "ContextCompaction":
        return "_Context compacted._"
    return None


def message_section(payload):
    """A plain rollout message, for rollouts without thread items."""
    role = payload.get("role")
    text = texts(payload.get("content"))
    if role == "user" and text and not text.lstrip().startswith("<"):
        return "## User\n\n" + text
    if role == "assistant" and text:
        return "## Codex\n\n" + text
    return None


def render(path):
    items, messages = [], []
    for record in records(path):
        payload = record.get("payload")
        if not isinstance(payload, dict):
            continue
        if payload.get("type") == "item_completed":
            items.append(item_section(payload.get("item") or {}))
        elif record.get("type") == "response_item" and payload.get("type") == "message":
            messages.append(message_section(payload))
    return [section for section in (items if any(items) else messages) if section]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--home", type=Path, required=True)
    parser.add_argument("--title", default="")
    parser.add_argument("--cwd", default="")
    args = parser.parse_args()

    match = THREAD_ID.search(args.title)
    if match:
        path = by_thread(args.home, match.group(0))
        heading = f"# Codex session {match.group(0)}"
    else:
        path = by_directory(args.home, args.cwd) if args.cwd else None
        heading = "# Codex: the newest session in this directory (no thread id in the pane title)"
    if path is None:
        sys.exit("no Codex session found" + ("" if match else " for this directory"))
    print("\n\n".join([heading, *render(path)]))


if __name__ == "__main__":
    main()
