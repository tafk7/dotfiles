#!/bin/bash
# Explicit native CLI update/repair; does not change the traffic policy.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in
    -h|--help) echo "Usage: ai-update claude|codex"; exit 0 ;;
    claude|codex) exec "$ROOT/installers/install-$1.sh" --force ;;
    *) echo 'Usage: ai-update claude|codex' >&2; exit 64 ;;
esac
