#!/bin/bash
# Compare every pin with its source's newest release, and look up advisories.
#
# Usage:
#   check-updates              Every pin: pinned, latest, status, advisories
#   check-updates --outdated   Only pins that are behind or have advisories (exit 2)
#   check-updates --json       Machine-readable JSON output
#   check-updates --records    Outcome records (lib/outcomes.sh) for dotfiles verify
#   check-updates <tool>       One pin by name (e.g. starship, node, vim-surround)
#
# Auth: GITHUB_TOKEN or GH_TOKEN if set; else `gh auth token`; else
# unauthenticated (60 requests an hour). See lib/check_updates.py.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
    --help|-h) sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
esac
PYTHONDONTWRITEBYTECODE=1 exec python3 "$SCRIPT_DIR/../lib/check_updates.py" "$@"
