#!/usr/bin/env python3
# Show charts, diagrams and HTML reports from a remote shell in the ssh client's browser.
# A thin entry over lib/viz (cli.py has the commands and the --help text). Keep the name and path:
# viz.service, bin/forwards and the server's own restart (lib/viz/access.py) run this file.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))

from viz.cli import main

main()
