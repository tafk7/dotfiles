#!/usr/bin/env python3
# Show charts, diagrams and HTML reports from a remote shell in the ssh client's browser.
"""Show visualizations written on this machine in the browser of the ssh client.

Agents running in tmux over ssh cannot draw on the client screen. viz serves
VIZ_DIR over HTTP on a Unix socket in this account's private runtime directory,
which no other account can open, and the client forwards a local port to it:

    ssh -L 127.0.0.1:PORT:/run/user/UID/viz/http.sock HOST

`viz status` prints the forward for this machine. HTML, SVG and PDF are served
(and images, when no VS Code window is connected); a page reloads when it or an
asset it loaded changes.

Anything on the client can open the forwarded port, so the server also wants a
secret: a browser signs in once with the single-use link `viz login` prints,
and keeps a cookie. Every request needs that cookie and a localhost Host header
(against DNS rebinding), and only top-level navigation may come from another
site: other origins cannot embed, frame or script the pages. Hidden paths, and
anything outside VIZ_DIR and its linked directories, are never served.

A browser file outside VIZ_DIR is served through a link to its directory in
VIZ_DIR/linked, so relative links and reload on rebuild keep working. Home, the
directories above it, the temp root and repository roots are never linked.

With a VS Code Remote-SSH window connected, other files (PNG, notebooks,
Markdown with mermaid, ...) open in it as tabs, and `viz diff` or a page (a link
to ``/__viz/diff?left=PATH&right=PATH``, which viz turns into a same-origin POST)
opens a side-by-side diff of two existing files under VIZ_DIFF_ROOTS.

Environment:
    VIZ_DIR    served root and home of `viz path` output (default ~/viz)
    VIZ_PORT   client port in printed URLs and forwards
               (default 20000 + uid % 10000, stable per account)
    VIZ_DIFF_ROOTS  colon-separated directories whose files a page may diff
               (default ~/projects:~/ref)
"""
import argparse
import datetime
import fcntl
import glob
import hashlib
import hmac
import html
import http.client
import json
import mimetypes
import os
import re
import secrets
import shutil
import signal
import socket
import socketserver
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler
from pathlib import Path

ROOT = Path(os.environ.get('VIZ_DIR') or '~/viz').expanduser().resolve()
PORT = int(os.environ.get('VIZ_PORT') or 20000 + os.getuid() % 10000)
STATE = Path(os.environ.get('XDG_STATE_HOME') or '~/.local/state').expanduser() / 'viz'
TOKEN = STATE / 'token'      # the browser cookie's secret, 0600; never printed
OPENED = STATE / 'opened'    # files opened from linked directories, for the gallery
BROWSER_SUFFIXES = {'.html', '.htm', '.svg', '.pdf'}
IMAGE_SUFFIXES = {'.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg'}
LINKED = ROOT / 'linked'
DIFF_ROOTS = [Path(p).expanduser().resolve()
              for p in (os.environ.get('VIZ_DIFF_ROOTS') or '~/projects:~/ref').split(':') if p]
# The client end of the forward. 127.0.0.1 rather than localhost, so the browser
# cannot reach an IPv6 listener on [::1] that someone else bound first.
URL_HOST = '127.0.0.1'
CODE_TTL = 600               # seconds a `viz login` link stays valid
COOKIE_AGE = 400 * 86400     # the longest browsers keep a cookie

RELOAD_SCRIPT = """(() => {
  // Reload when this page or an asset it loaded changes. Errors (tunnel down,
  // server restarting, signed out) are skipped, so polling recovers by itself.
  let seen = null;
  const poll = async () => {
    try {
      const r = await fetch('/__viz/version?path=' + encodeURIComponent(location.pathname), {cache: 'no-store'});
      if (r.ok) {
        const v = await r.text();
        if (seen !== null && v !== seen) return location.reload();
        seen = v;
      }
    } catch (e) {}
    setTimeout(poll, 1000);
  };
  // Start once the page's assets have loaded, so the first version covers them.
  if (document.readyState === 'complete') poll(); else addEventListener('load', poll);
  // A /__viz/diff?left=..&right=.. link asks the connected VS Code for a diff.
  // The server takes only same-origin POSTs, so send the link's query as one.
  document.addEventListener('click', async (event) => {
    const link = event.target.closest && event.target.closest('a[href]');
    if (!link) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || url.pathname !== '/__viz/diff') return;
    event.preventDefault();
    const r = await fetch('/__viz/diff', {method: 'POST', headers: {'X-Viz': '1'}, body: url.searchParams});
    if (!r.ok) alert('viz diff: ' + await r.text());
  });
})();
"""

# Sent with every response. CORP keeps other origins from loading a file as an
# image or script; the referrer stays on this origin, so CDNs never see paths.
COMMON_HEADERS = (
    ('Cache-Control', 'no-store'),
    ('X-Content-Type-Options', 'nosniff'),
    ('Referrer-Policy', 'same-origin'),
    ('Cross-Origin-Resource-Policy', 'same-origin'),
    ('Cross-Origin-Opener-Policy', 'same-origin'),
    ('X-Frame-Options', 'SAMEORIGIN'),
)
# viz's own pages run nothing but the reload script. Served files are the user's
# and agents' pages, trusted like their code: they keep inline scripts and CDNs,
# and are only kept out of other origins' frames.
PAGE_CSP = ("default-src 'none'; script-src 'self'; connect-src 'self'; img-src 'self'; "
            "style-src 'unsafe-inline'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'")
FILE_CSP = "frame-ancestors 'self'"


def die(message):
    print(f'viz: {message}', file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# VS Code bridge
# ---------------------------------------------------------------------------

def _socket_live(path):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(0.5)
    try:
        s.connect(path)
        return True
    except OSError:
        return False
    finally:
        s.close()


def vscode_socket():
    """Newest IPC socket with a window behind it; most on disk are stale."""
    current = os.environ.get('VSCODE_IPC_HOOK_CLI')
    if current and _socket_live(current):
        return current
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    candidates = glob.glob(os.path.join(runtime, 'vscode-ipc-*.sock'))
    for path in sorted(candidates, key=_mtime, reverse=True):
        if _socket_live(path):
            return path
    return None


def vscode_cli():
    """Remote CLI of a running VS Code server, else the newest installed one."""
    home = os.path.expanduser('~')
    clis = glob.glob(f'{home}/.vscode-server/cli/servers/*/server/bin/remote-cli/code')
    clis += glob.glob(f'{home}/.vscode-server/bin/*/bin/remote-cli/code')
    if not clis:
        return None
    running = set()
    for cmdline in glob.glob('/proc/[0-9]*/cmdline'):
        try:
            with open(cmdline, 'rb') as f:
                running.add(f.read().split(b'\0')[0].decode(errors='replace'))
        except OSError:
            continue
    for cli in clis:
        server = cli[:-len('bin/remote-cli/code')]
        if any(exe.startswith(server) for exe in running):
            return cli
    return max(clis, key=_mtime)


def vscode(*args):
    """Run the remote CLI against a live window; False when none is connected."""
    sock, cli = vscode_socket(), vscode_cli()
    if not sock or not cli:
        return False
    env = dict(os.environ, VSCODE_IPC_HOOK_CLI=sock)
    return subprocess.run([cli, *args], env=env, stdout=subprocess.DEVNULL).returncode == 0


def diffable(path):
    """``path`` resolved, if it is an existing, unhidden file under DIFF_ROOTS; else None."""
    local = Path(os.path.realpath(path))
    if not local.is_file():
        return None
    for root in DIFF_ROOTS:
        if root in local.parents and not any(p.startswith('.') for p in local.relative_to(root).parts):
            return local
    return None


def _mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return 0


def _mtime_ns(path):
    try:
        return os.stat(path).st_mtime_ns
    except OSError:
        return -1


# ---------------------------------------------------------------------------
# What is served
# ---------------------------------------------------------------------------

def url_parts(path):
    """Components of a URL path; None if any is hidden ('.', '..', dotfiles)."""
    parts = [p for p in urllib.parse.unquote(path).split('/') if p]
    if any(p.startswith('.') or '\0' in p for p in parts):
        return None
    return parts


def too_broad(directory):
    """Directories never linked whole: home and above it, the temp root, repository roots."""
    home = Path.home().resolve()
    return (directory == home or directory in home.parents
            or directory == Path(tempfile.gettempdir()).resolve()
            or (directory / '.git').exists())


def linked_dirs():
    return [p for p in LINKED.iterdir() if p.is_symlink() and p.is_dir()] if LINKED.is_dir() else []


def served_roots():
    roots = [str(ROOT)]
    for link in linked_dirs():
        target = os.path.realpath(link)
        if not too_broad(Path(target)):
            roots.append(target)
    return roots


def resolve(parts):
    """Real path of the served file or directory at URL PARTS; None if it is not served."""
    if parts is None:
        return None
    # Resolve symlinks and '..' before deciding; a hidden component below the
    # root counts even when a symlink leads there.
    local = os.path.realpath(ROOT.joinpath(*parts))
    for root in served_roots():
        if local == root or local.startswith(root + os.sep):
            if any(p.startswith('.') for p in local[len(root):].split(os.sep)):
                return None
            return Path(local)
    return None


def url_path(path):
    """URL path of PATH, a path under ROOT (linked files through their link)."""
    return '/' + urllib.parse.quote(path.relative_to(ROOT).as_posix())


def opened_files():
    try:
        return [ROOT / line for line in OPENED.read_text().splitlines() if line]
    except FileNotFoundError:
        return []


def remember(path):
    """Note a file opened from a linked directory, so the gallery lists it but not its siblings."""
    rel = path.relative_to(ROOT).as_posix()
    if ROOT / rel not in opened_files():
        STATE.mkdir(parents=True, exist_ok=True)
        with open(OPENED, 'a') as f:
            f.write(rel + '\n')


def tree_version(directory):
    count, newest = 0, _mtime_ns(OPENED) if directory == ROOT else 0
    for dirpath, dirnames, filenames in os.walk(directory):
        dirnames[:] = [d for d in dirnames if not d.startswith('.')]
        for name in filenames:
            count += 1
            newest = max(newest, _mtime_ns(os.path.join(dirpath, name)))
    return f'{count}:{newest}'


def page(title, body, reload=True):
    script = '<script src="/__viz/reload.js"></script>' if reload else ''
    return f"""<!doctype html><html><head><meta charset="utf-8"><title>{html.escape(title)}</title>
<style>
  :root {{ color-scheme: light dark; font: 14px system-ui, sans-serif; }}
  body {{ margin: 2rem; }}
  td {{ padding: .3rem .8rem; vertical-align: middle; }}
  td:first-child {{ opacity: .6; white-space: nowrap; }}
  img {{ max-height: 60px; max-width: 160px; background: white; }}
</style></head><body>
{body}
{script}</body></html>"""


def gallery(directory):
    """Every served file under DIRECTORY (under ROOT), newest first, plus opened linked files at the top."""
    files = []
    for dirpath, dirnames, filenames in os.walk(directory):
        dirnames[:] = [d for d in dirnames if not d.startswith('.')]
        files += [Path(dirpath, n) for n in filenames if not n.startswith('.')]
    if directory == ROOT:
        files += opened_files()
    served = [(f, local) for f in files
              if (local := resolve(list(f.relative_to(ROOT).parts))) and local.is_file()]
    served.sort(key=lambda pair: _mtime(pair[1]), reverse=True)
    rows = []
    for path, local in served:
        url = url_path(path)
        when = datetime.datetime.fromtimestamp(_mtime(local)).strftime('%Y-%m-%d %H:%M')
        thumb = f'<img src="{url}" loading="lazy">' if path.suffix.lower() in IMAGE_SUFFIXES else ''
        rel = html.escape(path.relative_to(ROOT).as_posix())
        rows.append(f'<tr><td>{when}</td><td><a href="{url}">{rel}</a></td><td>{thumb}</td></tr>')
    body = '\n'.join(rows) or '<tr><td colspan="3">Nothing yet. Write files with <code>viz path NAME</code>.</td></tr>'
    return page('viz', f'<h1>{html.escape(str(directory))}</h1>\n<table>{body}</table>')


def inject(data):
    """HTML DATA with the reload script before its last </body>."""
    match = None
    for match in re.finditer(rb'</body\s*>', data, re.IGNORECASE):
        pass
    cut = match.start() if match else len(data)
    return data[:cut] + b'<script src="/__viz/reload.js"></script>' + data[cut:]


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def __init__(self, path, secret):
        self.secret = secret.encode()
        self.codes = {}          # single-use sign-in code -> expiry
        self.assets = {}         # page URL parts -> real paths it loaded
        self.browser_seen = None
        self.lock = threading.Lock()
        super().__init__(path, Handler)

    def mint(self):
        code = secrets.token_urlsafe(16)
        with self.lock:
            now = time.time()
            self.codes = {c: t for c, t in self.codes.items() if t > now}
            self.codes[code] = now + CODE_TTL
        return code

    def redeem(self, code):
        with self.lock:
            return self.codes.pop(code, 0) > time.time()


class Handler(BaseHTTPRequestHandler):
    server_version = 'viz'
    sys_version = ''
    timeout = 30

    def do_GET(self):
        self._route()

    def do_HEAD(self):
        self._route()

    def do_POST(self):
        self._route()

    def _route(self):
        url = urllib.parse.urlsplit(self.path)
        # The browser's Host names the client end of the tunnel; anything else
        # is a rebinding page under a borrowed name.
        match = re.fullmatch(r'(?:localhost|127\.0\.0\.1|\[::1\])(?::(\d{1,5}))?',
                             self.headers.get('Host', ''), re.IGNORECASE)
        if not match:
            return self._text(421, 'viz answers to localhost and 127.0.0.1 only')
        # Cookies ignore ports, so name the cookie after the forwarded port: two
        # forwards (two hosts) keep separate sign-ins.
        self.cookie = f'viz-{match.group(1) or 80}'
        if url.path == '/__viz/login' and self.command == 'GET':
            return self._login(url.query)
        who = self._who()
        if who is None:
            return self._page(403, page('viz: sign in', SIGN_IN, reload=False))
        if who == 'browser':
            self.server.browser_seen = time.time()
            if not self._fetch_allowed():
                return self._text(403, 'refused: request from another site')
        if self.command == 'POST':
            if url.path == '/__viz/login' and who == 'cli':
                return self._text(200, self.server.mint())
            if url.path == '/__viz/diff':
                return self._diff()
            return self._text(405, 'method not allowed')
        if url.path == '/__viz/ping':
            seen = self.server.browser_seen
            info = {'root': str(ROOT), 'pid': os.getpid(), 'browser': seen and time.time() - seen}
            return self._text(200, json.dumps(info), 'application/json')
        if url.path == '/__viz/version':
            return self._text(200, self._version(urllib.parse.parse_qs(url.query).get('path', ['/'])[0]))
        if url.path == '/__viz/reload.js':
            return self._text(200, RELOAD_SCRIPT, 'text/javascript')
        if url.path == '/__viz/diff':
            # Never acts on GET: a link from another site must not open anything.
            return self._text(405, 'POST only: a viz page sends this link as a POST once it has loaded')
        if url.path.startswith('/__viz/'):
            return self._text(404, 'not found')
        parts = url_parts(url.path)
        local = resolve(parts)
        if local is None or not local.exists():
            return self._text(404, 'not found')
        if local.is_dir():
            if not url.path.endswith('/'):
                # Rebuilt from the checked parts, so it can't become //other.host/.
                location = '/' + ''.join(urllib.parse.quote(p) + '/' for p in parts)
                return self._redirect(location + (f'?{url.query}' if url.query else ''))
            index = next((i for i in (resolve(parts + [n]) for n in ('index.html', 'index.htm'))
                          if i and i.is_file()), None)
            if index is None:
                if local == ROOT or ROOT in local.parents:
                    return self._page(200, gallery(local))
                return self._text(404, 'not found: linked directories are not listed')
            local = index
        self._note_asset(parts, local)
        return self._file(local)

    def _who(self):
        """'cli' for the secret as a bearer token, 'browser' for the cookie, else None."""
        auth = self.headers.get('Authorization', '')
        if auth.startswith('Bearer ') and hmac.compare_digest(auth[7:].encode(), self.server.secret):
            return 'cli'
        for pair in self.headers.get('Cookie', '').split(';'):
            name, _, value = pair.strip().partition('=')
            if name == self.cookie and hmac.compare_digest(value.encode(), self.server.secret):
                return 'browser'
        return None

    def _fetch_allowed(self):
        """Same-origin requests and top-level navigation, by the browser's fetch metadata."""
        site = self.headers.get('Sec-Fetch-Site')
        if site in (None, 'same-origin', 'none'):
            return True
        return (self.command == 'GET' and self.headers.get('Sec-Fetch-Mode') == 'navigate'
                and self.headers.get('Sec-Fetch-Dest') == 'document')

    def _login(self, query):
        code = urllib.parse.parse_qs(query).get('code', [''])[0]
        if not self.server.redeem(code):
            return self._page(403, page('viz: sign in', SIGN_IN_AGAIN, reload=False))
        self.send_response(303)
        self.send_header('Set-Cookie', f'{self.cookie}={self.server.secret.decode()}; Max-Age={COOKIE_AGE}; '
                                       'Path=/; HttpOnly; SameSite=Lax')
        self.send_header('Location', '/')
        self.send_header('Content-Length', '0')
        self.end_headers()

    def _diff(self):
        # A page asks for this; nothing on another origin may. Origin is exact
        # (scheme, host and port), and the custom header makes a cross-origin
        # fetch need a preflight, which this server never grants.
        if (self.headers.get('Origin') != f'http://{self.headers["Host"]}'
                or self.headers.get('Sec-Fetch-Site', 'same-origin') != 'same-origin'
                or self.headers.get('X-Viz') != '1'):
            return self._text(403, 'refused: diffs are requested by viz pages only')
        try:
            length = int(self.headers.get('Content-Length') or 0)
        except ValueError:
            return self._text(400, 'bad Content-Length')
        if not 0 <= length <= 65536:
            return self._text(413, 'too large')
        query = urllib.parse.parse_qs(self.rfile.read(length).decode(errors='replace'))
        left, right = (diffable(query.get(k, [''])[0]) for k in ('left', 'right'))
        if left is None or right is None:
            return self._text(403, 'refused: two existing files under VIZ_DIFF_ROOTS')
        if not vscode('--reuse-window', '--diff', str(left), str(right)):
            return self._text(409, 'no connected VS Code window')
        return self._text(200, 'opened')

    def _note_asset(self, parts, local):
        """Remember what a page loads, so its version covers its CSS, scripts, images and data."""
        referer = urllib.parse.urlsplit(self.headers.get('Referer', ''))
        page_parts = url_parts(referer.path)
        if referer.netloc != self.headers['Host'] or not page_parts or page_parts == parts:
            return
        with self.server.lock:
            loaded = self.server.assets.setdefault(tuple(page_parts), set())
            if len(loaded) < 1000:
                loaded.add(local)

    def _version(self, path):
        parts = url_parts(path)
        local = resolve(parts)
        if local is None or not local.exists():
            return 'missing'
        if local.is_dir():
            return tree_version(local)
        with self.server.lock:
            assets = sorted(self.server.assets.get(tuple(parts), ()))
        stamp = ':'.join(str(_mtime_ns(p)) for p in [local, *assets])
        return hashlib.sha256(stamp.encode()).hexdigest()[:16]

    def _file(self, local):
        ctype = mimetypes.guess_type(local.name)[0] or 'application/octet-stream'
        if ctype.startswith('text/') or ctype in ('application/json', 'image/svg+xml'):
            ctype += '; charset=utf-8'
        try:
            f = open(local, 'rb')
        except OSError:
            return self._text(404, 'not found')
        with f:
            if local.suffix.lower() in ('.html', '.htm'):
                return self._send(200, inject(f.read()), ctype, FILE_CSP)
            self.send_response(200)
            self.send_header('Content-Type', ctype)
            self.send_header('Content-Length', str(os.fstat(f.fileno()).st_size))
            self.send_header('Content-Security-Policy', FILE_CSP)
            self.end_headers()
            if self.command != 'HEAD':
                shutil.copyfileobj(f, self.wfile)

    def _send(self, status, data, ctype, csp=PAGE_CSP):
        self.send_response(status)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Content-Security-Policy', csp)
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(data)

    def _text(self, status, text, ctype='text/plain'):
        self._send(status, text.encode(), f'{ctype}; charset=utf-8')

    def _page(self, status, text):
        self._send(status, text.encode(), 'text/html; charset=utf-8')

    def _redirect(self, location):
        self.send_response(301)
        self.send_header('Location', location)
        self.send_header('Content-Length', '0')
        self.end_headers()

    def end_headers(self):
        for name, value in COMMON_HEADERS:
            self.send_header(name, value)
        super().end_headers()

    def log_message(self, *args):
        pass


SIGN_IN = ('<h1>viz: sign in</h1><p>In your ssh session on this machine, run <code>viz login</code> '
           'and open the link it prints. The browser then stays signed in to this port.</p>')
SIGN_IN_AGAIN = ('<h1>viz: sign in</h1><p>This sign-in link is used or expired. '
                 'Run <code>viz login</code> for a new one.</p>')


# ---------------------------------------------------------------------------
# Socket, secret and server lifetime
# ---------------------------------------------------------------------------

def runtime_dir():
    """This account's private socket directory, created 0700 on first use.

    $XDG_RUNTIME_DIR/viz, or /run/user/UID/viz; else /tmp/viz-UID, which anyone
    could create first, so ownership and mode are checked as tmux checks its own.
    """
    uid = os.getuid()
    for base in (os.environ.get('XDG_RUNTIME_DIR'), f'/run/user/{uid}'):
        if base and os.path.isdir(base) and os.stat(base).st_uid == uid:
            path = Path(base) / 'viz'
            break
    else:
        path = Path(tempfile.gettempdir()) / f'viz-{uid}'
    try:
        path.mkdir(mode=0o700)
    except FileExistsError:
        pass
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o077:
        die(f'{path} is not a directory private to this account; remove it and retry')
    return path


def socket_path():
    path = runtime_dir() / 'http.sock'
    if len(os.fsencode(path)) > 107:
        die(f'socket path too long for a Unix socket: {path}')
    return path


def token():
    """The server's secret, created on first use."""
    try:
        if TOKEN.stat().st_mode & 0o077:
            TOKEN.chmod(0o600)
        return TOKEN.read_text().strip()
    except FileNotFoundError:
        return new_token(replace=False)


def new_token(replace):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / f'.token.{os.getpid()}'
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as f:
        f.write(secrets.token_urlsafe(32))
    try:
        if replace:
            tmp.replace(TOKEN)
        else:
            os.link(tmp, TOKEN)   # refuses to replace: a concurrent first use wins
    except FileExistsError:
        pass
    finally:
        tmp.unlink(missing_ok=True)
    return TOKEN.read_text().strip()


class _UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path):
        super().__init__('localhost', timeout=2)
        self.unix_path = str(path)

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.unix_path)


def ask(method, path):
    """(status, body) from the server on our socket; None when nothing answers."""
    conn = _UnixHTTP(socket_path())
    try:
        conn.request(method, path, headers={'Authorization': f'Bearer {token()}'})
        r = conn.getresponse()
        return r.status, r.read().decode()
    except (OSError, http.client.HTTPException):
        return None
    finally:
        conn.close()


def server_state():
    """('ours', ping info), ('other', None) for a server with another VIZ_DIR or secret, or ('down', None)."""
    reply = ask('GET', '/__viz/ping')
    if reply is None:
        return 'down', None
    status, body = reply
    if status != 200:
        return 'other', None
    info = json.loads(body)
    return ('ours' if info.get('root') == str(ROOT) else 'other'), info


def ensure_server():
    """Ping info of the running server, started in the background if need be."""
    state, info = server_state()
    if state == 'other':
        die('the running server has another VIZ_DIR or secret; run viz stop')
    if state == 'ours':
        return info
    token()   # before the server reads it
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / 'serve.log', 'ab') as log:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), 'serve'],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True)
    for _ in range(30):
        time.sleep(0.1)
        state, info = server_state()
        if state == 'ours':
            return info
    die(f'server did not start; see {STATE / "serve.log"}')


def _inode(path):
    try:
        return os.stat(path).st_ino
    except OSError:
        return None


def _watch(server, path, inode):
    """Stop once our socket is gone or replaced (logout removed the runtime directory, say)."""
    while _inode(path) == inode:
        time.sleep(2)
    server.shutdown()


def server_pid(pidfile):
    """The PID in PIDFILE if that process is still a viz server; else None."""
    try:
        pid = int(pidfile.read_text())
        with open(f'/proc/{pid}/cmdline', 'rb') as f:
            argv = f.read().split(b'\0')
    except (OSError, ValueError):
        return None
    return pid if b'serve' in argv and any(os.path.basename(a) == b'viz' for a in argv) else None


def stop(pidfile):
    """Stop the server in PIDFILE and wait for it; its PID, or None if none ran."""
    pid = server_pid(pidfile)
    if pid is None:
        return None
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not os.path.exists(f'/proc/{pid}'):
            break
        time.sleep(0.1)
    return pid


def url_for(path):
    return f'http://{URL_HOST}:{PORT}' + url_path(path) + ('/' if path.is_dir() else '')


def connect_hint(info):
    if info.get('browser') is None:
        print('no browser has reached viz yet: `viz status` shows the ssh forward, `viz login` signs in')


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_path(args):
    name = Path(args.name)
    if name.is_absolute() or '..' in name.parts:
        die('NAME must be a relative path without ..')
    path = ROOT / datetime.date.today().isoformat() / name
    path.parent.mkdir(parents=True, exist_ok=True)
    print(path)


def cmd_open(args):
    info = None
    for arg in args.files:
        path = Path(arg).expanduser().resolve()
        if not path.exists():
            die(f'no such file: {arg}')
        suffix = path.suffix.lower()
        browser = args.browser or (not args.vscode and suffix in BROWSER_SUFFIXES)
        if not browser:
            if vscode('--reuse-window', str(path)):
                print(f'opened in VS Code: {path}')
                continue
            if args.vscode or suffix not in IMAGE_SUFFIXES:
                print(f'no connected VS Code window; open {path} yourself')
                continue
            # Without VS Code, the browser shows images too.
        if path != ROOT and ROOT not in path.parents:
            directory = path if path.is_dir() else path.parent
            if too_broad(directory):
                die(f'refusing to serve all of {directory}; write the file under a subdirectory or `viz path`')
            if path.is_dir() and not any((path / n).is_file() for n in ('index.html', 'index.htm')):
                die(f'{path} has no index.html; open a file in it (linked directories are not listed)')
            link = link_dir(directory)
            print(f'serving {directory} as {link}')
            path = link if path.is_dir() else link / path.name
            if not path.is_dir():
                remember(path)
        info = ensure_server()
        print(url_for(path))
    if info:
        connect_hint(info)


def cmd_diff(args):
    left, right = Path(args.left).expanduser().resolve(), Path(args.right).expanduser().resolve()
    for path in (left, right):
        if not path.is_file():
            die(f'no such file: {path}')
    if vscode('--reuse-window', '--diff', str(left), str(right)):
        print(f'opened in VS Code: {left} <> {right}')
    else:
        print(f'no connected VS Code window; run: code --diff {left} {right}')


def cmd_login(args):
    if args.reset:
        new_token(replace=True)
        stop(runtime_dir() / 'serve.pid')   # it holds the old secret; restarts below
    ensure_server()
    reply = ask('POST', '/__viz/login')
    if not reply or reply[0] != 200:
        die('the server gave no sign-in code; see `viz status`')
    print(f'http://{URL_HOST}:{PORT}/__viz/login?code={reply[1]}')
    print(f'single use within {CODE_TTL // 60} minutes; the browser then stays signed in to port {PORT}')


def cmd_start(args):
    info = ensure_server()
    print(f'http://{URL_HOST}:{PORT}/')
    connect_hint(info)


def cmd_serve(args):
    ROOT.mkdir(parents=True, exist_ok=True)
    path = socket_path()
    os.chdir('/')
    with open(path.parent / 'serve.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)   # one checks and binds at a time
        if _socket_live(str(path)):
            die(f'already serving on {path}')
        if os.path.lexists(path):
            if not stat.S_ISSOCK(os.lstat(path).st_mode):
                die(f'{path} exists and is not a socket; remove it')
            path.unlink()
        old = os.umask(0o177)   # the socket is 0600 from the moment it exists
        try:
            server = Server(str(path), token())
        finally:
            os.umask(old)
    inode = _inode(path)
    pidfile = path.parent / 'serve.pid'
    pidfile.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    threading.Thread(target=_watch, args=(server, path, inode), daemon=True).start()
    print(f'serving {ROOT} on {path}', flush=True)
    try:
        server.serve_forever()
    finally:
        if _inode(path) == inode:
            path.unlink()
        if server_pid(pidfile) == os.getpid():
            pidfile.unlink()


def cmd_stop(args):
    stopped = False
    # The second is the 127.0.0.1 TCP server of viz before the socket.
    for pidfile, what in ((runtime_dir() / 'serve.pid', 'server'), (STATE / 'serve.pid', 'old TCP server')):
        pid = stop(pidfile)
        if pid:
            print(f'stopped {what} (pid {pid})')
            stopped = True
    if not stopped:
        print('server not running')


def cmd_status(args):
    path = socket_path()
    state, info = server_state()
    print(f'dir:      {ROOT}')
    if state == 'ours':
        seen = info['browser']
        print(f'server:   running (pid {info["pid"]}) on {path}')
        print('browser:  ' + ('no request yet' if seen is None else f'last request {seen:.0f}s ago'))
    elif state == 'other':
        print(f'server:   {path} answers for another VIZ_DIR or secret; run viz stop')
    else:
        print(f'server:   stopped (viz start, viz open or viz login starts it on {path})')
    print(f'url:      http://{URL_HOST}:{PORT}/')
    print(f'forward:  ssh -L {URL_HOST}:{PORT}:{path} {socket.gethostname()}')
    print(f'          or, in the client\'s ssh config: LocalForward {URL_HOST}:{PORT} {path}')
    print('sign in:  run `viz login` yourself and open its single-use link')
    legacy = server_pid(STATE / 'serve.pid')
    if legacy:
        print(f'old:      a TCP server from an earlier viz still runs (pid {legacy}); viz stop ends it')
    sock, cli = vscode_socket(), vscode_cli()
    print('vscode:   ' + ('connected' if sock and cli else
                          'no VS Code server installed' if not cli else 'no connected window'))


def link_dir(directory):
    """The VIZ_DIR/linked entry for DIRECTORY, created on first use."""
    for link in linked_dirs():
        if link.resolve() == directory:
            return link
    LINKED.mkdir(parents=True, exist_ok=True)
    name, n = directory.name or 'root', 1
    link = LINKED / name
    while link.exists() or link.is_symlink():
        n += 1
        link = LINKED / f'{name}-{n}'
    link.symlink_to(directory, target_is_directory=True)
    return link


def main():
    parser = argparse.ArgumentParser(
        prog='viz', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('path', help="print (and create the directory of) today's path for NAME")
    p.add_argument('name')
    p.set_defaults(func=cmd_path)
    p = sub.add_parser('open', help='print the browser URL of files, or open them in the connected VS Code')
    target = p.add_mutually_exclusive_group()
    target.add_argument('--browser', action='store_true', help='always serve to the browser')
    target.add_argument('--vscode', action='store_true', help='always open as a VS Code tab')
    p.add_argument('files', nargs='+')
    p.set_defaults(func=cmd_open)
    p = sub.add_parser('diff', help='open a side-by-side diff of two files in the connected VS Code')
    p.add_argument('left')
    p.add_argument('right')
    p.set_defaults(func=cmd_diff)
    p = sub.add_parser('login', help='print a single-use link that signs a browser in')
    p.add_argument('--reset', action='store_true', help='new secret first: signs every browser out')
    p.set_defaults(func=cmd_login)
    sub.add_parser('start', help='start the background server').set_defaults(func=cmd_start)
    sub.add_parser('serve', help='run the server in the foreground').set_defaults(func=cmd_serve)
    sub.add_parser('stop', help='stop the background server').set_defaults(func=cmd_stop)
    sub.add_parser('status', help='show the server, how to forward to it, and VS Code').set_defaults(func=cmd_status)
    args = parser.parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
